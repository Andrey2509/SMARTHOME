(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Parnik_heat
VAR
	(* Настройки логики *)
	rAirStartOutside : REAL; (* Порог включения по улице вечером *)
	rWaterMaxLimit   : REAL := 35.0; (* Верхний лимит воды в трубе *)
	rWaterMinLimit   : REAL := 30.0; (* Нижний лимит воды в трубе ночью *)
	
	(* Внутренние флаги *)
	bNightModeActive : BOOL; (* Разрешение на работу ночного подогрева *)

	dtCurrentDate         		: DT;
	fileTime              		: T_FILETIME;
	fbGetSystemTime       	: GETSYSTEMTIME;
	time_now			: TOD;
	tz					: TIME:=T#5h;
	test1, test2, test3 ,hours,minutes		: INT;
	hm				:ExtractTime;

END_VAR
(* @END_DECLARATION := '0' *)
rAirStartOutside	:= Modbus.Parnik_temp_step1_window-1;

fbGetSystemTime(timeLoDW =>fileTime.dwLowDateTime,
                timeHiDW =>fileTime.dwHighDateTime);
dtCurrentDate:=FILETIME_TO_DT(fileTime);
time_now	:= DT_TO_TOD(dtCurrentDate)+tz;

hm(tm:=time_now, h=>hours, m=>minutes);


(* АКТИВАЦИЯ НОЧНОГО РЕЖИМА ОПЕРЕЖЕНИЕ И ЧАСЫ *)
(* Включение: на улице холоднее +10 и время между 12:00 дня и 06:00 утра *)
IF (Modbus.Parnik_air_temp <= rAirStartOutside) AND (hours >= 12 OR hours < 6) THEN
	bNightModeActive := TRUE;
END_IF;

(* Гарантированное выключение: наступило 06:00 утра ИЛИ на улице потеплело выше +12 *)
IF (hours >= 6 AND hours < 12) OR (Modbus.Parnik_air_temp > (rAirStartOutside + 2.0)) THEN
	bNightModeActive := FALSE;
END_IF;


(* УПРАВЛЕНИЕ ГРЕЮЩИМ КАБЕЛЕМ ПО ТЕМПЕРАТУРЕ ВОДЫ *)
IF bNightModeActive THEN
	
	(* Двухпозиционное регулирование с гистерезисом по воде в трубе *)
	IF Modbus.Parnik_pipe_temp >= rWaterMaxLimit THEN
		HW_parnik_heat := FALSE; (* Выключаем подогрев при +35 *)
	ELSIF Modbus.Parnik_pipe_temp <= rWaterMinLimit THEN
		HW_parnik_heat := TRUE;  (* Включаем подогрев при +30 *)
	END_IF;
	
ELSE
	
	(* Днем или после 6 утра принудительно отключаем нагрев *)
	HW_parnik_heat := FALSE;

END_IF;

Modbus.Teplica_DO8	:=	HW_parnik_heat;

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM ParnikWindowCtrl
VAR
    (* Modbus I/O (использовать точно как заданы) *)
    (* Modbus.Street_temp : REAL *)
    (* Modbus.Parnik_set_temp_street_min : REAL *)
    (* Modbus.Parnik_air_temp : REAL *)
    (* Modbus.Parnik_set_auto_window : BOOL *)
    (* Modbus.Parnik_current_level_window : UINT *) (* 0=closed,1=30%,2=60%,3=100% *)
    (* Modbus.Parnik_manual_level_window : UINT *)
    (* Modbus.Parnik_temp_step1_window : UINT *) (* threshold for 30% *)
    (* Modbus.Parnik_temp_step2_window : UINT *) (* threshold for 60% *)

    (* HW outputs *)
    (* HW_power_supply_parnik : BOOL *)
    (* HW_power_polarity_parnik : BOOL *)

    (* Internal *)
    closeTON : TON;                 (* PT = 60s *)
    openTON  : TON;                 (* PT = variable *)
    state : UINT := 0;              (* 0=idle,1=closing,2=opening *)
    targetLevel : UINT := 0;        (* desired final level 0..3 *)
    openTime : TIME := T#0s;
    hysteresis : REAL := 3.0;
    prevManualLevel : UINT := 255;
    manualReq : BOOL := FALSE;
    startClose : BOOL := FALSE;
    startOpen  : BOOL := FALSE;
    firstScan : BOOL := TRUE;
    trigLevel1,trigLevel2,trigLevel3 : BOOL;

END_VAR

(* @END_DECLARATION := '0' *)
hysteresis		:=	3.0;

IF firstScan THEN
    Modbus.Parnik_current_level_window := 0; (* default closed *)
    
    (* Исправлено: Защита старта теперь сразу взводит триггеры *)
    IF Modbus.Parnik_air_temp > (INT_TO_REAL(Modbus.Parnik_temp_step1_window) - hysteresis)
       AND Modbus.Parnik_air_temp < (INT_TO_REAL(Modbus.Parnik_temp_step1_window) + hysteresis) THEN
        targetLevel := 1;
        trigLevel1 := TRUE;
        trigLevel2 := FALSE;
    ELSE
        targetLevel := 0;
        trigLevel1 := FALSE;
        trigLevel2 := FALSE;
    END_IF;

    HW_power_supply_parnik := FALSE;
    HW_power_polarity_parnik := FALSE;
    closeTON(IN := FALSE, PT := T#60s);
    openTON(IN := FALSE, PT := T#60s);
    prevManualLevel := Modbus.Parnik_manual_level_window;
    firstScan := FALSE;
END_IF;

(* Определение ручного запроса *)
manualReq := FALSE;
IF NOT Modbus.Parnik_set_auto_window THEN
    IF Modbus.Parnik_manual_level_window <> prevManualLevel THEN
        manualReq := TRUE;
    END_IF;
END_IF;
prevManualLevel := Modbus.Parnik_manual_level_window;

(* Determine targetLevel according to requested logic *)
IF Modbus.Parnik_set_auto_window THEN
    (* AUTO - Чистая логика RS-триггеров *)
    
    (* УЛИЦА: Если на улице слишком холодно, принудительно закрываем всё *)
    IF Modbus.Street_temp < Modbus.Parnik_set_temp_street_min THEN
        targetLevel := 0;
        
    ELSE
        (* РАБОТА ПО ТЕМПЕРАТУРЕ ВНУТРИ *)
        
        (* Триггер Уровня 2 *)
        IF Modbus.Parnik_air_temp > (INT_TO_REAL(Modbus.Parnik_temp_step2_window) + hysteresis) THEN
            trigLevel2 := TRUE;
        ELSIF Modbus.Parnik_air_temp < (INT_TO_REAL(Modbus.Parnik_temp_step2_window) - hysteresis) THEN
            trigLevel2 := FALSE;
        END_IF;

        (* Триггер Уровня 1 *)
        IF Modbus.Parnik_air_temp > (INT_TO_REAL(Modbus.Parnik_temp_step1_window) + hysteresis) THEN
            trigLevel1 := TRUE;
        ELSIF Modbus.Parnik_air_temp < (INT_TO_REAL(Modbus.Parnik_temp_step1_window) - hysteresis) THEN
            trigLevel1 := FALSE;
        END_IF;

        (* Расстановка приоритетов уровней *)
        IF trigLevel2 THEN
            targetLevel := 2;
        ELSIF trigLevel1 THEN
            targetLevel := 1;
        ELSE
            targetLevel := 0;
        END_IF;

    END_IF;

ELSE
    (* MANUAL - независимый от температуры режим *)
    CASE Modbus.Parnik_manual_level_window OF
        0: targetLevel := 0;
        1: targetLevel := 1;
        2: targetLevel := 2;
        3: targetLevel := 3;
        ELSE targetLevel := Modbus.Parnik_current_level_window;
    END_CASE;
END_IF;

(* Force sequence restart if manual request detected while in idle *)
IF manualReq AND (state = 0) THEN
    Modbus.Parnik_current_level_window := 99; 
END_IF;

(* State Machine Trigger (when Idle) *)
IF state = 0 THEN
    startClose := FALSE;
    startOpen := FALSE;
    
    IF Modbus.Parnik_current_level_window <> targetLevel THEN
        
        IF targetLevel = 0 THEN
            (* Полное закрытие *)
            startClose := TRUE;
            state := 1;
        ELSIF Modbus.Parnik_current_level_window = 99 THEN
            (* Сброс по ручной команде -> сначала закрываем до упора *)
            startClose := TRUE;
            state := 1;
        ELSE
            (* Движение к уровню > 0 *)
            IF targetLevel > Modbus.Parnik_current_level_window AND Modbus.Parnik_current_level_window <> 0 THEN
                (* ДВИЖЕНИЕ ВВЕРХ БЕЗ ЗАКРЫТИЯ (Рассчитываем дельту) *)
                IF Modbus.Parnik_current_level_window = 1 AND targetLevel = 2 THEN openTime := T#25s;
                ELSIF Modbus.Parnik_current_level_window = 1 AND targetLevel = 3 THEN openTime := T#55s;
                ELSIF Modbus.Parnik_current_level_window = 2 AND targetLevel = 3 THEN openTime := T#30s;
                ELSE openTime := T#0s;
                END_IF;

                IF openTime > T#0s THEN
                    startOpen := TRUE;
                    state := 2;
                ELSE
                    Modbus.Parnik_current_level_window := targetLevel;
                END_IF;
            ELSE
                (* ДВИЖЕНИЕ ВНИЗ ИЛИ СТАРТ ИЗ НУЛЯ -> сначала полное закрытие для точности *)
                startClose := TRUE;
                state := 1;
            END_IF;
        END_IF;
    END_IF;
END_IF;

(* State machine *)
CASE state OF
    0: (* Idle *)
        HW_power_supply_parnik := FALSE;
        HW_power_polarity_parnik := FALSE;
        
    1: (* Closing (60s) *)
        closeTON(IN := startClose, PT := T#60s);
        HW_power_polarity_parnik := FALSE; (* False = закрытие *)
        HW_power_supply_parnik := startClose;

        IF closeTON.Q THEN
            closeTON(IN := FALSE, PT := T#60s);
            startClose := FALSE;
            HW_power_supply_parnik := FALSE;
            Modbus.Parnik_current_level_window := 0; (* Окно гарантированно в нулю *)
            
            IF targetLevel > 0 THEN
                (* Расчет чистого времени открытия ИЗ НУЛЯ *)
                CASE targetLevel OF
                    1: openTime := T#5s;
                    2: openTime := T#30s;
                    3: openTime := T#60s;
                    ELSE openTime := T#0s;
                END_CASE;

                IF openTime > T#0s THEN
                    startOpen := TRUE;
                    state := 2;
                ELSE
                    Modbus.Parnik_current_level_window := targetLevel;
                    state := 0;
                END_IF;
            ELSE
                state := 0;
            END_IF;
        END_IF;

    2: (* Opening *)
        openTON(IN := startOpen, PT := openTime);
        HW_power_polarity_parnik := TRUE; (* True = открытие *)
        HW_power_supply_parnik := startOpen;

        IF openTON.Q THEN
            openTON(IN := FALSE, PT := openTime);
            startOpen := FALSE;
            HW_power_supply_parnik := FALSE;
            Modbus.Parnik_current_level_window := targetLevel; (* Установка финального статуса *)
            state := 0;
        END_IF;

ELSE
    HW_power_supply_parnik := FALSE;
    startClose := FALSE;
    startOpen := FALSE;
    closeTON(IN := FALSE, PT := T#60s);
    openTON(IN := FALSE, PT := T#60s);
    state := 0;
END_CASE;

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM ParnikWindowCtrl_old
VAR
    (* Modbus I/O (использовать точно как заданы) *)
    (* Modbus.Street_temp : REAL *)
    (* Modbus.Parnik_set_temp_street_min : REAL *)
    (* Modbus.Parnik_air_temp : REAL *)
    (* Modbus.Parnik_set_auto_window : BOOL *)
    (* Modbus.Parnik_current_level_window : UINT *) (* 0=closed,1=30%,2=60%,3=100% *)
    (* Modbus.Parnik_manual_level_window : UINT *)
    (* Modbus.Parnik_temp_step1_window : UINT *) (* threshold for 30% *)
    (* Modbus.Parnik_temp_step2_window : UINT *) (* threshold for 60% *)

    (* HW outputs *)
    (* HW_power_supply_parnik : BOOL *)
    (* HW_power_polarity_parnik : BOOL *)

    (* Internal *)
    closeTON : TON;                 (* PT = 60s *)
    openTON  : TON;                 (* PT = variable *)
    state : UINT := 0;              (* 0=idle,1=closing,2=opening *)
    targetLevel : UINT := 0;        (* desired final level 0..3 *)
    openTime : TIME := T#0s;
    hysteresis : REAL := 4.0;
    prevManualLevel : UINT := 255;
    manualReq : BOOL := FALSE;
    startClose : BOOL := FALSE;
    startOpen  : BOOL := FALSE;
    firstScan : BOOL := TRUE;
END_VAR

(* @END_DECLARATION := '0' *)
IF firstScan THEN
    Modbus.Parnik_current_level_window := 0; (* default closed *)
    HW_power_supply_parnik := FALSE;
    HW_power_polarity_parnik := FALSE;
    closeTON(IN := FALSE, PT := T#60s);
    openTON(IN := FALSE, PT := T#60s);
    prevManualLevel := Modbus.Parnik_manual_level_window;
    firstScan := FALSE;
END_IF

(* detect manual change request *)
manualReq := FALSE;
IF NOT Modbus.Parnik_set_auto_window THEN
    IF Modbus.Parnik_manual_level_window <> prevManualLevel THEN
        manualReq := TRUE;
    END_IF;
END_IF;
prevManualLevel := Modbus.Parnik_manual_level_window;

(* Determine targetLevel according to requested logic *)
IF Modbus.Parnik_set_auto_window THEN
    (* AUTO *)
    IF (Modbus.Parnik_air_temp > (INT_TO_REAL(Modbus.Parnik_temp_step1_window) + hysteresis))
       AND (Modbus.Parnik_air_temp < INT_TO_REAL(Modbus.Parnik_temp_step2_window))
       AND (Modbus.Street_temp > Modbus.Parnik_set_temp_street_min) THEN
        targetLevel := 1; (* 30% *)
    ELSIF (Modbus.Parnik_air_temp > (INT_TO_REAL(Modbus.Parnik_temp_step2_window) + hysteresis))
       AND (Modbus.Street_temp > Modbus.Parnik_set_temp_street_min) THEN
        targetLevel := 2; (* 60% *)
    ELSIF ( (Modbus.Parnik_air_temp < (INT_TO_REAL(Modbus.Parnik_temp_step1_window) - hysteresis))
            OR (Modbus.Street_temp < Modbus.Parnik_set_temp_street_min) ) THEN
        targetLevel := 0; (* close *)
    ELSE
        targetLevel := Modbus.Parnik_current_level_window; (* keep current *)
    END_IF;
ELSE
    (* MANUAL - independent от температуры *)
    CASE Modbus.Parnik_manual_level_window OF
        0: targetLevel := 0;
        1: targetLevel := 1;
        2: targetLevel := 2;
        3: targetLevel := 3;
        ELSE targetLevel := Modbus.Parnik_current_level_window;
    END_CASE;
END_IF;


(* Helper: request sequence when target differs or when manualReq *)
IF state = 0 THEN
    startClose := FALSE;
    startOpen := FALSE;
    (* If target equals current -> nothing *)
    IF Modbus.Parnik_current_level_window <> targetLevel THEN
        IF targetLevel = 0 THEN
            (* need close *)
            startClose := TRUE;
            state := 1;
            HW_power_polarity_parnik := FALSE; (* closing polarity *)
        ELSE
            (* target > 0 *)
            IF Modbus.Parnik_current_level_window < targetLevel THEN
                (* already closed -> open directly *)
(*                IF openTime > T#0s THEN *)
                    startOpen := TRUE;
			IF (Modbus.Parnik_current_level_window = 0 AND targetLevel  = 1) THEN
		 	   openTime := T#5s;
			 END_IF
			IF (Modbus.Parnik_current_level_window = 0 AND targetLevel =  2) THEN
		 	   openTime := T#30s;
			 END_IF
			IF (Modbus.Parnik_current_level_window = 0 AND targetLevel =  3) THEN
		 	   openTime := T#60s;
			 END_IF
			IF (Modbus.Parnik_current_level_window = 1 AND targetLevel =  2) THEN
		 	   openTime := T#20s;
			 END_IF
			IF (Modbus.Parnik_current_level_window = 1 AND targetLevel =  3) THEN
		 	   openTime := T#50s;
			 END_IF
			IF (Modbus.Parnik_current_level_window = 2 AND targetLevel =  3) THEN
		 	   openTime := T#30s;
			 END_IF
                    state := 2;
                    HW_power_polarity_parnik := TRUE; (* opening polarity *)
            ELSE
                (* not closed -> close first *)
                startClose := TRUE;
                state := 1;
                HW_power_polarity_parnik := FALSE;
            END_IF;
        END_IF;
    END_IF;
END_IF

(* Also handle explicit manual request forcing sequence even if target==current but user changed set *)
IF manualReq AND (state = 0) THEN
    IF Modbus.Parnik_current_level_window <> targetLevel THEN
        (* same logic as above: if target>0 and already closed -> open; else close first *)
        IF targetLevel = 0 THEN
            startClose := TRUE; state := 1; HW_power_polarity_parnik := FALSE;
        ELSE
            IF Modbus.Parnik_current_level_window = 0 THEN
                IF openTime > T#0s THEN startOpen := TRUE; state := 2; HW_power_polarity_parnik := TRUE;
                ELSE Modbus.Parnik_current_level_window := targetLevel; state := 0;
                END_IF;
            ELSE
                startClose := TRUE; state := 1; HW_power_polarity_parnik := FALSE;
            END_IF;
        END_IF;
    END_IF;
END_IF

(* State machine with explicit TON IN handling *)
CASE state OF
    0: (* idle *)
        HW_power_supply_parnik := FALSE;
    1: (* closing - use full close time 60s *)
        closeTON(IN := startClose, PT := T#60s);
        HW_power_polarity_parnik := FALSE;
        HW_power_supply_parnik := startClose;

        IF closeTON.Q THEN
            (* finished closing *)
            closeTON(IN := FALSE, PT := T#60s);
            startClose := FALSE;
            HW_power_supply_parnik := FALSE;
            Modbus.Parnik_current_level_window := 0;
            (* If target >0 -> open to required level *)
            IF targetLevel > 0 THEN
                IF openTime > T#0s THEN
                    startOpen := TRUE;
                    state := 2;
                    HW_power_polarity_parnik := TRUE;
                ELSE
                    Modbus.Parnik_current_level_window := targetLevel;
                    state := 0;
                END_IF;
            ELSE
                state := 0;
            END_IF;
        END_IF;

    2: (* opening *)
        IF openTime = T#0s THEN
            startOpen := FALSE;
            HW_power_supply_parnik := FALSE;
            Modbus.Parnik_current_level_window := targetLevel;
            state := 0;
        ELSE
            openTON(IN := startOpen, PT := openTime);
            HW_power_polarity_parnik := TRUE;
            HW_power_supply_parnik := startOpen;

            IF openTON.Q THEN
                openTON(IN := FALSE, PT := openTime);
                startOpen := FALSE;
                HW_power_supply_parnik := FALSE;
                Modbus.Parnik_current_level_window := targetLevel;
                state := 0;
            END_IF;
        END_IF;

ELSE
    (* fallback safe *)
    HW_power_supply_parnik := FALSE;
    startClose := FALSE;
    startOpen := FALSE;
    closeTON(IN := FALSE, PT := T#60s);
    openTON(IN := FALSE, PT := openTime);
    state := 0;
END_CASE;

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Poliv
VAR
	TRIG_poliv_terrasa	:	R_TRIG;
	TRIG_poliv_zapad	:	R_TRIG;
	TRIG_poliv_south		:	R_TRIG;
	TRIG_poliv_north		:	R_TRIG;
	TRIG_poliv_flowers		:	R_TRIG;

	Period_pomp_garden_delay	: INT:=15;				(* Задержка включения насоса после сигнала на открытие клапана=15 сек. *)

 	 tTimerValue_zapad			: TIME;
	Timer_poliv_zapad			: TON;
	Timer_poliv_zapadQ			:  BOOL;
	 tTimerValue_zapad_est		: TIME;

	tTimerValue_terrasa			: TIME;
	Timer_poliv_terrasa			: TON;
	Timer_poliv_terrasaQ			:  BOOL;
	tTimerValue_terrasa_est		: TIME;

	 tTimerValue_south			: TIME;
	Timer_poliv_south				: TON;
	Timer_poliv_southQ			:  BOOL;
	 tTimerValue_south_est		: TIME;


 	tTimerValue_north				: TIME;
	Timer_poliv_north				: TON;
	Timer_poliv_northQ			:  BOOL;
 	tTimerValue_north_est			: TIME;


 	tTimerValue_flowers				: TIME;
	Timer_poliv_flowers				: TON;
	Timer_poliv_flowersQ			:  BOOL;
 	tTimerValue_flowers_est			: TIME;


	TON_pomp_garden			: TON ;
	pomp_garden_start			: BOOL;

	tTimerValue					: TIME;
END_VAR
(* @END_DECLARATION := '0' *)
tTimerValue := DINT_TO_TIME(Period_pomp_garden_delay*1000);


Timer_poliv_zapad();
Timer_poliv_terrasa();
Timer_poliv_south();
Timer_poliv_north();
Timer_poliv_flowers();

IF (Modbus.Poliv_valve_winter = FALSE) THEN


	TRIG_poliv_terrasa(CLK :=HW_button_poliv_terrasa);
	TRIG_poliv_zapad(CLK :=HW_button_poliv_zapad);
	TRIG_poliv_south(CLK :=HW_button_poliv_south);
	TRIG_poliv_north(CLK :=HW_button_poliv_north);





	IF (TRIG_poliv_terrasa.Q) THEN
		IF (Modbus.Poliv_terrasa = TRUE ) THEN
			Modbus.Poliv_terrasa := FALSE;
		ELSE
			Modbus.Poliv_terrasa := TRUE;
			Modbus.Poliv_terrasa_minutes:=120;
		END_IF

	END_IF



	IF (TRIG_poliv_zapad.Q) THEN
		IF (Modbus.Poliv_zapad = TRUE ) THEN
			Modbus.Poliv_zapad := FALSE;
		ELSE
			Modbus.Poliv_zapad := TRUE;
			Modbus.Poliv_zapad_minutes:=120;
		END_IF

	END_IF


	IF (TRIG_poliv_south.Q) THEN
		IF (Modbus.Poliv_south = TRUE ) THEN
			Modbus.Poliv_south := FALSE;
		ELSE
			Modbus.Poliv_south_minutes:=120;
			Modbus.Poliv_south := TRUE;
		END_IF

	END_IF


	IF (TRIG_poliv_north.Q) THEN
		IF (Modbus.Poliv_north = TRUE ) THEN
			Modbus.Poliv_north := FALSE;
		ELSE
			Modbus.Poliv_north_minutes:=120;
			Modbus.Poliv_north := TRUE;
		END_IF

	END_IF


	Modbus.Poliv_zapad_minutes_est	:= TIME_TO_INT(Timer_poliv_zapad.ET/(60*1000));
	Modbus.Poliv_terrasa_minutes_est	:=  TIME_TO_INT(Timer_poliv_terrasa.ET/(60*1000));
	Modbus.Poliv_south_minutes_est	:=  TIME_TO_INT(Timer_poliv_south.ET/(60*1000));
	Modbus.Poliv_north_minutes_est	:=  TIME_TO_INT(Timer_poliv_north.ET/(60*1000));
	Modbus.Poliv_flowers_minutes_est	:=  TIME_TO_INT(Timer_poliv_flowers.ET/(60*1000));


	IF (Modbus.Poliv_zapad = TRUE ) THEN
		tTimerValue_zapad := DINT_TO_TIME(Modbus.Poliv_zapad_minutes*60*1000);
		HW_poliv_zapad	:=	TRUE;
		Timer_poliv_zapad(IN:=NOT Timer_poliv_zapadQ , PT:=tTimerValue_zapad , Q=>Timer_poliv_zapadQ , ET=>tTimerValue_zapad_est );

	END_IF
	IF (Modbus.Poliv_zapad = FALSE ) THEN
		HW_poliv_zapad	:=	FALSE;
		Timer_poliv_zapadQ := FALSE;
		Timer_poliv_zapad(IN:=FALSE , PT:=T#0ms , Q=>Timer_poliv_zapadQ , ET=>tTimerValue_zapad_est );
	END_IF
	IF Timer_poliv_zapad.q THEN
		Modbus.Poliv_zapad := FALSE;
		HW_poliv_zapad	:=	FALSE;
	END_IF
	
	
	
	
	IF (Modbus.Poliv_terrasa = TRUE ) THEN
		tTimerValue_terrasa := DINT_TO_TIME(Modbus.Poliv_terrasa_minutes*60*1000);
		HW_poliv_terrasa	:=	TRUE;
		Timer_poliv_terrasa(IN:=NOT Timer_poliv_terrasaQ , PT:=tTimerValue_terrasa , Q=>Timer_poliv_terrasaQ , ET=>tTimerValue_terrasa_est );
	END_IF
	IF (Modbus.Poliv_terrasa = FALSE ) THEN
		HW_poliv_terrasa	:=	FALSE;
		Timer_poliv_terrasaQ := FALSE;
		Timer_poliv_terrasa(IN:=FALSE , PT:=T#0ms , Q=>Timer_poliv_terrasaQ , ET=>tTimerValue_terrasa_est );
	END_IF
	IF Timer_poliv_terrasa.q THEN
		Modbus.Poliv_terrasa := FALSE;
		HW_poliv_zapad	:=	FALSE;
	END_IF
	
	
	
	IF (Modbus.Poliv_south = TRUE ) THEN
		tTimerValue_south := DINT_TO_TIME(Modbus.Poliv_south_minutes*60*1000);
		HW_poliv_south	:=	TRUE;
		Timer_poliv_south(IN:=NOT Timer_poliv_southQ , PT:=tTimerValue_south , Q=>Timer_poliv_southQ , ET=>tTimerValue_south_est );
	END_IF
	IF (Modbus.Poliv_south = FALSE ) THEN
		HW_poliv_south	:=	FALSE;
		Timer_poliv_southQ := FALSE;
		Timer_poliv_south(IN:=FALSE , PT:=T#0ms , Q=>Timer_poliv_southQ , ET=>tTimerValue_south_est );
	END_IF
	IF Timer_poliv_south.q THEN
		Modbus.Poliv_south := FALSE;
		HW_poliv_south	:=	FALSE;
	END_IF
	
	

	IF (Modbus.Poliv_north = TRUE ) THEN
		tTimerValue_north := DINT_TO_TIME(Modbus.Poliv_north_minutes*60*1000);
		HW_poliv_north	:=	TRUE;
		Timer_poliv_north(IN:=NOT Timer_poliv_northQ , PT:=tTimerValue_north , Q=>Timer_poliv_northQ , ET=>tTimerValue_north_est );
	END_IF
	IF (Modbus.Poliv_north = FALSE ) THEN
		HW_poliv_north	:=	FALSE;
		Timer_poliv_northQ := FALSE;
		Timer_poliv_north(IN:=FALSE , PT:=T#0ms , Q=>Timer_poliv_northQ , ET=>tTimerValue_north_est );
	END_IF
	IF Timer_poliv_north.q THEN
		Modbus.Poliv_north := FALSE;
		HW_poliv_north	:=	FALSE;
	END_IF
	

	IF (Modbus.Poliv_flowers = TRUE ) THEN
		tTimerValue_flowers := DINT_TO_TIME(Modbus.Poliv_flowers_minutes*60*1000);
		HW_poliv_flowers	:=	TRUE;
		Timer_poliv_flowers(IN:=NOT Timer_poliv_flowersQ , PT:=tTimerValue_flowers , Q=>Timer_poliv_flowersQ , ET=>tTimerValue_flowers_est );
	END_IF
	IF (Modbus.Poliv_flowers = FALSE ) THEN
		HW_poliv_flowers	:=	FALSE;
		Timer_poliv_flowersQ := FALSE;
		Timer_poliv_flowers(IN:=FALSE , PT:=T#0ms , Q=>Timer_poliv_flowersQ , ET=>tTimerValue_flowers_est );
	END_IF
	IF Timer_poliv_flowers.q THEN
		Modbus.Poliv_flowers := FALSE;
		HW_poliv_flowers	:=	FALSE;
	END_IF












	



	IF ((HW_poliv_zapad=TRUE OR HW_poliv_terrasa=TRUE 	OR HW_poliv_south =	TRUE OR HW_poliv_north = TRUE) AND (HW_pomp_Garden=FALSE)  )  THEN
		pomp_garden_start			:=TRUE;
	END_IF
	

	TON_pomp_garden(IN := pomp_garden_start, PT:= tTimerValue);
	Modbus.Pomp_garden	 	:= TON_pomp_garden.Q;
	HW_Pomp_garden		:= TON_pomp_garden.Q;
	
	IF (HW_poliv_zapad=FALSE AND HW_poliv_terrasa=FALSE 	AND HW_poliv_south = FALSE  AND HW_poliv_north = FALSE)   THEN
		pomp_garden_start		:= FALSE;
		Modbus.Pomp_garden	 	:= FALSE;
		HW_Pomp_garden		:= FALSE;
	END_IF
ELSE
	HW_poliv_zapad	:=	TRUE;
	HW_poliv_terrasa	:=	TRUE;
	HW_poliv_south 	:=	TRUE;
	HW_poliv_north 	:= 	TRUE;
END_IF




END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM ponics
VAR

	t_Started_poliv			:	TIME;
	t_Started_AB				:	TIME;


	Timer_poliv				: TON;
	Timer_polivQ			: BOOL;

	Timer_doliv_water			: TON;
	Timer_doliv_AB			: TON;


	Timer_doliv_waterQ		: BOOL;


	 tTimerValue_poliv		: TIME:=t#60s;  (* Максимальное время полива*)
	 tTimerValue_doliv_water	: TIME:=t#10s;  (* Промывка перед 1 фертигацией*)
	 tTimerValue_doliv_AB		: TIME:=t#30s;

	Timer_doliv_ABQ			:	BOOL;
	TRIG_start_poliv			:	R_TRIG;
	TRIG_start_doliv_water		:	R_TRIG;
	TRIG_start_doliv_AB		:	R_TRIG;
	TRIG_poliv_break			:	R_TRIG;

	Doliv_liters				:	REAL;
	Doliv_liters_int			:	REAL;
	Tank_A_liters				:	REAL;
	Tank_B_liters				:	REAL;
	gisterezis_lux				:	INT:=1000;
(*
	Trigger_water_impulse_ponics	: F_TRIG;
	Trigger_A_impulse_ponics		: F_TRIG;
	Trigger_B_impulse_ponics		: F_TRIG;
*)

	TRIG_valve_tank_F		:	F_TRIG;
	TRIG_valve_tank_R		:	R_TRIG;
	PLC_status				:	BYTE;

	Ponics_poliv_start			:	TOD;
	Ponics_poliv_end			:	TOD;
	Ponics_doliv_AB_start			:	TOD;
	Ponics_doliv_AB_end			:	TOD;
	Ponics_doliv_water_start			:	TOD;
	Ponics_doliv_water_end			:	TOD;
	Ponics_light_morning_start			:	TOD;
	Ponics_light_morning_end			:	TOD;
	dtCurrentDate         		: DT;
	fileTime              		: T_FILETIME;
	fbGetSystemTime       	: GETSYSTEMTIME;
	time_now			: TOD;
	tz					: TIME:=T#5h;
	test1, test2, test3 ,hours,minutes		: INT;
	hm				:ExtractTime;
	Ponics_impulse_water_cnt_int	:UDINT;
	Timer_block_dolivAB			:TON;
	Timer_block_dolivABQ			:BOOL;
	Timer_block_doliv_water			:TON;
	Timer_block_doliv_waterQ			:BOOL;

	t_Started_doliv_A			:	TIME;
	t_Started_doliv_B			:	TIME;
	t_Started_doliv_water		:	TIME;

	pi_balkon 			: FB_CTRL_PI;
	pwm_balkon			: FB_CTRL_PWM_OUT;

END_VAR
(* @END_DECLARATION := '0' *)


tTimerValue_poliv			:=	UDINT_TO_TIME(1000*Modbus.Ponics_set_max_poliv_time);
tTimerValue_doliv_water	:=	UDINT_TO_TIME(1000*Modbus.Ponics_set_max_doliv_water_time);
tTimerValue_doliv_AB		:=	UDINT_TO_TIME(1000*Modbus.Ponics_set_max_doliv_A_time);

Timer_poliv();
Timer_doliv_water();
Timer_doliv_AB();
Timer_block_dolivAB();
Timer_block_doliv_water();

fbGetSystemTime(timeLoDW =>fileTime.dwLowDateTime,
                timeHiDW =>fileTime.dwHighDateTime);
dtCurrentDate:=FILETIME_TO_DT(fileTime);
time_now	:= DT_TO_TOD(dtCurrentDate)+tz;

Ponics_poliv_start					:=	UDINT_TO_TOD(Modbus.Ponics_poliv_start);
Ponics_poliv_end					:=	UDINT_TO_TOD(Modbus.Ponics_poliv_end);
Ponics_doliv_AB_start				:=	UDINT_TO_TOD(Modbus.Ponics_doliv_AB_start);
Ponics_doliv_AB_end				:=	UDINT_TO_TOD(Modbus.Ponics_doliv_AB_end);
Ponics_doliv_water_start			:=	UDINT_TO_TOD(Modbus.Ponics_doliv_water_start);
Ponics_doliv_water_end			:=	UDINT_TO_TOD(Modbus.Ponics_doliv_water_end);
Ponics_light_morning_start			:=	UDINT_TO_TOD(Modbus.Ponics_light_morning_start);
Ponics_light_morning_end			:=	UDINT_TO_TOD(Modbus.Ponics_light_morning_end);

hm(tm:=time_now, h=>hours, m=>minutes);

IF (time_now>Ponics_poliv_start AND time_now<Ponics_poliv_end AND minutes =  Modbus.Ponics_start_mintutes_poliv AND HW_Ponics_pomp_main =	FALSE ) THEN
	Modbus.Ponics_poliv_active	:= TRUE;
END_IF

IF  ( Modbus.Ponics_doliv_AB_active	= FALSE AND time_now>Ponics_doliv_AB_start AND time_now<Ponics_doliv_AB_end AND minutes =  Modbus.Ponics_start_minutes_doliv_AB AND HW_Ponics_pomp_tankA =	FALSE AND HW_Ponics_pomp_tankB =	FALSE)  THEN
	Modbus.Ponics_doliv_AB_active	:= TRUE;
	Timer_block_dolivAB(IN:=NOT Timer_block_dolivABQ , PT:=T#70s , Q=>Timer_block_dolivABQ , ET=> );
END_IF

IF Timer_block_dolivAB.Q THEN
	Timer_block_dolivAB.IN			:= FALSE;
	Modbus.Ponics_doliv_AB_active	:= FALSE;
	Timer_block_dolivABQ				:= FALSE;
END_IF

IF (Modbus.Ponics_doliv_water_active	= FALSE AND time_now>Ponics_doliv_water_start AND time_now<Ponics_doliv_water_end AND minutes =  Modbus.Ponics_start_minutes_doliv_water AND HW_Ponics_pomp_water =	FALSE ) THEN
	Modbus.Ponics_doliv_water_active	:= TRUE;
	Timer_block_doliv_water(IN:=NOT Timer_block_doliv_waterQ , PT:=T#70s , Q=>Timer_block_doliv_waterQ , ET=> );
END_IF

IF Timer_block_doliv_water.Q THEN
	Timer_block_doliv_water.IN			:= FALSE;
	Modbus.Ponics_doliv_water_active	:= FALSE;
	Timer_block_doliv_waterQ			:= FALSE;
END_IF

(*
Trigger_water_impulse_ponics(CLK:=HW_impulse_water_ponics);
Trigger_A_impulse_Ponics(CLK:=HW_impulse_tankA_Ponics);
Trigger_B_impulse_Ponics(CLK:=HW_impulse_tankB_Ponics);


IF Trigger_water_impulse_Ponics.Q THEN
	Modbus.Ponics_impulse_water_cnt	:= 	Modbus.Ponics_impulse_water_cnt+1;
END_IF
IF Trigger_A_impulse_Ponics.Q THEN
	Modbus.Ponics_impulse_A_cnt	:= 	Modbus.Ponics_impulse_A_cnt+1;
END_IF
IF Trigger_B_impulse_Ponics.Q THEN
	Modbus.Ponics_impulse_B_cnt	:= 	Modbus.Ponics_impulse_B_cnt+1;
END_IF
*)

TRIG_start_poliv(CLK :=Modbus.Ponics_poliv_active);
Modbus.Ponics_poliv_active	:=	FALSE;

TRIG_poliv_break(CLK :=Modbus.Ponics_poliv_break);
TRIG_start_doliv_AB(CLK :=Modbus.Ponics_doliv_AB_active);
TRIG_start_doliv_water(CLK :=Modbus.Ponics_doliv_water_active);


(* poliv *)

IF (TRIG_start_poliv.Q AND HW_sensor_fluid_alarm = FALSE )   THEN
		Modbus.Ponics_time_elapsed_poliv :=0;
		Timer_polivQ					:= FALSE;
		Modbus.Ponics_pomp_poliv	:= TRUE;
		HW_Ponics_pomp_main		:= TRUE;
		 t_Started_poliv				:= TIME();
		Timer_poliv(IN:=NOT Timer_polivQ , PT:=tTimerValue_poliv , Q=>Timer_polivQ , ET=> );
		PLC_status.0					:= 1;
END_IF

IF ( Timer_poliv.Q OR Modbus.Ponics_poliv_break=TRUE ) THEN
		Timer_poliv.IN				:= FALSE;
		Timer_polivQ					:= FALSE;
		Modbus.Ponics_pomp_poliv	:= FALSE;
		HW_Ponics_pomp_main		:= FALSE;
		PLC_status.0					:= 0;
END_IF

TRIG_valve_tank_F(CLK:=HW_water_tank_Ponics_level_low);
TRIG_valve_tank_R(CLK:=HW_water_tank_Ponics_level_low);
Modbus.Ponics_tank_water_level	:=	HW_water_tank_Ponics_level_low;
Modbus.Ponics_tank_water_level_high	:=	HW_water_tank_Ponics_level_high;

IF (HW_Ponics_pomp_water = TRUE) THEN
	Doliv_liters 								:= UDINT_TO_REAL(Modbus.Ponics_impulse_water_cnt)/UINT_TO_REAL(Modbus.Ponics_water_kf);
	Doliv_liters_int 							:= UDINT_TO_REAL(Ponics_impulse_water_cnt_int)/UINT_TO_REAL(Modbus.Ponics_water_kf);
	Modbus.Ponics_time_elapsed_doliv_water	:= (TIME_TO_UDINT( TIME() - t_Started_doliv_water))/1000;
END_IF

IF (HW_Ponics_pomp_tankA = TRUE) THEN
	Tank_A_liters								:= UDINT_TO_REAL(Modbus.Ponics_impulse_A_cnt)/UINT_TO_REAL(Modbus.Ponics_A_kf);
	Modbus.Ponics_time_elapsed_doliv_A		:= (TIME_TO_UDINT( TIME() - t_Started_doliv_A))/1000;
END_IF

IF (HW_Ponics_pomp_tankB = TRUE) THEN
	Tank_B_liters								:= UDINT_TO_REAL(Modbus.Ponics_impulse_B_cnt)/UINT_TO_REAL(Modbus.Ponics_B_kf);
	Modbus.Ponics_time_elapsed_doliv_B		:= (TIME_TO_UDINT( TIME() - t_Started_doliv_B))/1000;
END_IF

(*  doliv water schedule if EC up  OR lelel in tank is low    *)

(*start doliv water *)
 IF (TRIG_start_doliv_water.Q    AND  HW_water_tank_Ponics_level_high = TRUE  AND HW_sensor_fluid_alarm = FALSE  AND (HW_water_tank_Ponics_level_low = TRUE OR  Modbus.Ponics_EC >  Modbus.Ponics_set_EC*1.1)   )   THEN
		Modbus.Ponics_impulse_water_cnt	:=	0;
		Doliv_liters						:=	0;
		HW_Ponics_pomp_water			:=	TRUE;
		Modbus.Ponics_pomp_doliv_water	:=	TRUE;
		t_Started_doliv_water				:=	TIME();
		Timer_doliv_water(IN:=NOT Timer_doliv_waterQ , PT:=tTimerValue_doliv_water , Q=>Timer_doliv_waterQ , ET=> );
		PLC_status.1						:=	1;
END_IF

(* stop doliv water*)

IF ( HW_Ponics_pomp_water = TRUE AND (   HW_water_tank_Ponics_level_high = FALSE	 OR Doliv_liters >Modbus. Ponics_set_doliv_water  ) 	) THEN
		Modbus.Ponics_pomp_doliv_water	:=	FALSE;
		HW_Ponics_pomp_water			:=	FALSE;
		Timer_block_doliv_water.IN			:= FALSE;
		Modbus.Ponics_doliv_water_active	:= FALSE;
		PLC_status.1						:=	0;
END_IF


IF ( Timer_doliv_water.Q  ) THEN
		Timer_doliv_water.IN				:=	FALSE;
		Timer_doliv_waterQ				:=	FALSE;
		Modbus.Ponics_pomp_doliv_water	:=	FALSE;
		HW_Ponics_pomp_water			:=	FALSE;
		PLC_status.1						:=	0;
END_IF


(*  doliv tank A, B  if EC down*)
(* (TRIG_start_doliv_AB.Q AND Modbus.Ponics_EC < Modbus.Ponics_set_EC )*) (* AND HW_water_tank_Ponics_level_high = TRUE *)
IF (TRIG_start_doliv_AB.Q   AND Modbus.Ponics_EC < Modbus.Ponics_set_EC*0.98  AND HW_sensor_fluid_alarm = FALSE)   THEN
		Modbus.Ponics_impulse_A_cnt	:=	0;
		Modbus.Ponics_impulse_B_cnt	:=	0;
		Tank_A_liters					:=	0;
		Tank_B_liters					:=	0;
		Modbus.Ponics_pomp_doliv_A	:=	TRUE;
		HW_Ponics_pomp_tankA		:=	TRUE;
		Modbus.Ponics_pomp_doliv_B	:=	TRUE;
		HW_Ponics_pomp_tankB		:=	TRUE;
		t_Started_AB					 :=	 TIME();
		t_Started_doliv_A				:=	TIME();
		t_Started_doliv_B				:=	TIME();
		Timer_doliv_AB(IN:=NOT Timer_doliv_ABQ , PT:=tTimerValue_doliv_AB , Q=>Timer_doliv_ABQ , ET=> );
		PLC_status.2					:=	1;
		PLC_status.3					:=	1;
		PLC_status.4					:=	1;
END_IF

IF ( Tank_A_liters >Modbus. Ponics_set_doliv_AB ) THEN
		Modbus.Ponics_pomp_doliv_A		:=	FALSE;
		HW_Ponics_pomp_tankA			:=	FALSE;
		PLC_status.2						:=	0;
END_IF


IF (  Tank_B_liters >Modbus. Ponics_set_doliv_AB ) THEN
		Modbus.Ponics_pomp_doliv_B		:=	FALSE;
		HW_Ponics_pomp_tankB			:=	FALSE;
		PLC_status.3						:=	0;
END_IF

IF ( Timer_doliv_AB.Q  ) THEN
		Timer_doliv_AB.IN				:=	FALSE;
		Timer_doliv_ABQ					:=	FALSE;
		Modbus.Ponics_pomp_doliv_A		:=	FALSE;
		HW_Ponics_pomp_tankA			:=	FALSE;
		Modbus.Ponics_pomp_doliv_B		:=	FALSE;
		HW_Ponics_pomp_tankB			:=	FALSE;
		PLC_status.2						:=	0;
		PLC_status.3						:=	0;
		PLC_status.4						:=	0;
END_IF


IF ( HW_sensor_fluid_alarm = TRUE  ) THEN
		Timer_poliv.IN					:=	FALSE;
		Timer_polivQ						:=	FALSE;
		Modbus.Ponics_pomp_poliv		:=	FALSE;
		HW_Ponics_pomp_main			:=	FALSE;
		PLC_status.0						:=	0;
		Timer_doliv_water.IN				:=	FALSE;
		Timer_doliv_waterQ				:=	FALSE;
		Modbus.Ponics_pomp_doliv_water	:=	FALSE;
		HW_Ponics_pomp_water			:=	FALSE;
		PLC_status.1						:=	0;
		Timer_doliv_AB.IN				:=	FALSE;
		Timer_doliv_ABQ					:=	FALSE;
		Modbus.Ponics_pomp_doliv_A		:=	FALSE;
		HW_Ponics_pomp_tankA			:=	FALSE;
		Modbus.Ponics_pomp_doliv_B		:=	FALSE;
		HW_Ponics_pomp_tankB			:=	FALSE;
		PLC_status.2						:=	0;
		PLC_status.3						:=	0;
		PLC_status.4						:=	0;
END_IF




Modbus.Ponics_status_PLC:=PLC_status;


(*LIGHT Ponics *)
IF (time_now>Ponics_light_morning_start AND time_now<Ponics_light_morning_end  ) THEN
	HW_light_rassada		:=	TRUE;
	Modbus.Balkon_set_temp	:=	Modbus.Balkon_set_temp_day;
ELSE
	HW_light_rassada		:=	FALSE;
	Modbus.Balkon_set_temp	:=	Modbus.Balkon_set_temp_night;
END_IF

Modbus.Balkon_light_rassada	:=	HW_light_rassada;



(*HEAT Ponics *)
(*
	IF ((Modbus.Balkon_temp > Modbus.Balkon_set_temp+1)   ) THEN
		HW_balkon_heat		:= FALSE;
	END_IF

	IF ((Modbus.Balkon_temp <  Modbus.Balkon_set_temp-1 ) ) THEN
		HW_balkon_heat		:=	TRUE;
	END_IF
*)
(*
pwm_par_balkon.bInstantPWMUpdate:=0;
pwm_par_balkon.tPWMPeriod:=T#5800ms;
pwm_par_balkon.tTaskCycleTime:=T#5ms;

pi_par_balkon.bARWOnIPartOnly:=0;
pi_par_balkon.fKp:=40;
pi_par_balkon.fOutMaxLimit:=100;
pi_par_balkon.fOutMinLimit:=0;
pi_par_balkon.tCtrlCycleTime:=T#5ms;
pi_par_balkon.tTaskCycleTime:=T#5ms;
pi_par_balkon.tTn:=T#30m;

pi_balkon(fSetpointValue:=Modbus.Balkon_set_temp, fActualValue :=Modbus.Balkon_temp, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_balkon, fOut => );
pwm_balkon(fPwmInput:=pi_balkon.fOut, eMode:=2, stParams:=pwm_par_balkon, bPwmOutBitPos=>HW_balkon_heat );
*)
END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Power_act
VAR
	fbCalcSunriseSunset   	: FB_CalcSunriseSunset;
	todSunrise            		: TOD;
   	todSunset          		: TOD;
	dtCurrentDate         		: DT;
	fileTime              		: T_FILETIME;
	fbGetSystemTime       	: GETSYSTEMTIME;
	time_now			: TOD;
	tz					: TIME:=T#5h;
	delta_time			: TIME:=T#2h;

END_VAR
(* @END_DECLARATION := '0' *)
(*
fbGetSystemTime(timeLoDW =>fileTime.dwLowDateTime,
                timeHiDW =>fileTime.dwHighDateTime);
dtCurrentDate:=FILETIME_TO_DT(fileTime);


fbCalcSunriseSunset( fDegreeOfLongitude := 73.26,   (* Longitude of Verl *)
                     fDegreeOfLatitude := 61.15,   (* Latitude of Verl *)
                     fReferenceMeridian := 73.26,  (* Central European Summer Time *)
                     dCurrentDate := DT_TO_DATE(dtCurrentDate),
                     todSunrise => todSunrise,
                     todSunset => todSunset);

time_now	:= DT_TO_TOD(dtCurrentDate)+tz;
*)

IF ((Modbus.Security_status = FALSE  AND Modbus.Sensor_supply = FALSE AND Modbus.Balkon_light_lux < 1000) OR  Modbus.Light_reserv_manual=1 ) THEN
	Modbus.Light_reserv := TRUE;
ELSE
	Modbus.Light_reserv := FALSE;
END_IF

HW_light_rezerv	:=	Modbus.Light_reserv;

(*
IF ( time_now > todSunrise+delta_time  AND  time_now < todSunset-delta_time   ) THEN
		Modbus.Light_reserv := FALSE;
	ELSE
		IF (Modbus.Security_status = FALSE) THEN
			Modbus.Light_reserv := TRUE;
		END_IF
END_IF

IF (Modbus.Security_status = TRUE) THEN
	Modbus.Light_reserv := FALSE;
END_IF



IF (Modbus.Light_reserv=TRUE AND (Modbus.Light_reserv_manual=1 OR Modbus.Light_reserv_manual=2)) THEN
		HW_light_rezerv:=TRUE;
	ELSIF  (Modbus.Light_reserv=TRUE AND  Modbus.Light_reserv_manual=0 ) THEN
		HW_light_rezerv:=FALSE;
	ELSIF (Modbus.Light_reserv=FALSE AND Modbus.Light_reserv_manual=1) THEN
		HW_light_rezerv:=TRUE;
	ELSE
		HW_light_rezerv:=FALSE;
END_IF
*)
END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)

PROGRAM RS485read
VAR

	tTimerValue				: TIME	:=	t#60s; (* Период опроса RS485*)
	FtrigBusy				: F_TRIG;
	timeoutvalue				: TIME := T#2000ms;		(* timeout while waiting for an answer of the modbus slave *)
	state					: INT;
	busy					: BOOL;
	LastErrorstate				: INT;
	LastModbusError			: ST_ModbusErrorDiagnostics;
	CounterError				: DINT;
	CounterSuccess			: DINT;
	i,k,l						: INT:=1;

	teplica_ADM4188_id			: BYTE:=16#45;
	klubnika_WP8025ADAM		: BYTE:=16#46;
	klubnika_SHT30				: BYTE:=16#64;


	sensors_SHT20_v1_id			: ARRAY[1..3] OF BYTE:= 16#0F, 16#05, 16#36;
	sensors_SHT20_v1_hum		: ARRAY[1..3] OF REAL:=3(0);
	sensors_SHT20_v1_temp		: ARRAY[1..3] OF REAL:=3(0);

(*	sensors_SHT20_v2_id			: ARRAY[1..1] OF BYTE:=  16#0A; *)
	sensors_SHT20_v2_id			: ARRAY[1..1] OF BYTE:=  16#35;

	sensors_SHT20_v2_hum		: ARRAY[1..1] OF REAL:=1(0);
	sensors_SHT20_v2_temp		: ARRAY[1..1] OF REAL:=1(0);


	sensors_SHT30_v3_id			: ARRAY[1..8] OF BYTE:= 16#14, 16#11,16#29, 16#30,16#07,16#08, 16#32, 16#35;
	sensors_SHT30_v3_hum		: ARRAY[1..8] OF REAL:=8(0);
	sensors_SHT30_v3_temp		: ARRAY[1..8] OF REAL:=8(0);

	sensors_CO2_id				: ARRAY[1..4] OF BYTE:=16#68, 16#69,16#6A, 16#6B ;
	sensors_CO2_ppm			: ARRAY[1..4] OF INT;

	house_DS18B20_id			: BYTE:=16#64;
	sensors_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);
	parnik_DS18B20_id			: BYTE:=16#64;
	teplica_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);
	teplica_gate_pt1000_id			: BYTE:=70;
	MBdata8_pt1000				 : ARRAY [1..8] OF INT;
	MBdata_teplica_gate_pt1000	: ARRAY [1..8] OF REAL;

	MBdata						 : ARRAY [1..2] OF INT;
	MBdata8						 : ARRAY [1..8] OF UINT;
	MBdata8_h					 : ARRAY [1..8] OF UINT;

	sensor_ponics_PH_id			: BYTE:= 16#4F ;
	sensor_teplica_PH_id			: BYTE:= 16#78 ;
	MBdata_sensor_ponics_PH	: ARRAY [1..4] OF INT;
	MBdata_sensor_teplica_PH	: ARRAY [1..4] OF INT;

	Teplica_tank_level_id			: BYTE:=1;
	Teplica_tankA_level_id		: BYTE:=2;
	Teplica_tankB_level_id		: BYTE:=3;

	Teplica_ph_sensor_low		: REAL;
	Teplica_ph_sensor_temp		: REAL;
	Teplica_ph_sensor_mv		: REAL;
(*	Teplica_temp_air				: REAL; *)
	Teplica_temp_pip_heat_in		: REAL;

	Ponics_ph_sensor_mv			: REAL;

	sensor_teplica_EC_id			: BYTE:= 16#C8 ;
	sensor_ponics_EC_id			: BYTE:= 16#51 ;
	sensor_ponics_EC2_id			: BYTE:= 16#50 ;
	sensor_ponics_EC_int			: INT;
	sensor_ponics_EC2_int		: INT;
	MBdata_sensor_teplica_EC		 : ARRAY [1..4] OF INT;
	MBdata_sensor_ponics_EC2	 :  INT;

	balkon_light_sensor_id			: BYTE:=16#5A;
	balkon_light_word2			: WORD;
	teplica_light_sensor_id			: BYTE:=16#3C;
	teplica_light_low				: WORD;
	teplica_light_high				: WORD;
	teplica_light_dword			: DWORD;
	teplica_light_array				: ARRAY [1..2] OF WORD;

	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)
	crctest					: WORD;
	get_energy_E_T1			: FB_GET_ENERGY;
	get_energy_E_T2			: FB_GET_ENERGY;
	get_energy_MT			: FB_GET_ENERGY;
	get_supply				: FB_GET_SUPPLY;
	get_current				: FB_GET_CURRENT;
	get_power				: FB_GET_POWER;
	energyMT					: ARRAY[1..12,1..2] OF REAL;
	get_current_done			: BOOL;
	get_power_done			: BOOL;
	get_energy_E_T1_done	: BOOL;
	get_energy_E_T2_done	: BOOL;
	get_energy_MT_done		: BOOL;
	get_supply_done			: BOOL;
	arrReceive				: ARRAY[1..5] OF BYTE;
	arrSend					: ARRAY[1..5] OF BYTE;
	t,m, tr, none				: INT:=1;
	 e_rs1					: INT:=0;
	ponics_EC2_1				: REAL;
	ponics_EC2_2				: REAL;
	ponics_EC2_3				: REAL;
	ponics_EC2_4				: REAL;
	Modbus_errors			:DWORD;
	Modbus_array_errors		:ARRAY[0..254] OF BYTE;
	Balkon_CO2				: INT;
	Teplica_CO2				: INT;
	Timer_wait_RS			: TON;
	 tTimerValue_wait_RS1		: TIME:=t#2s;  (* *)
	cnt_err_read_tank			:UDINT;
	cnt_err_read_all			:UDINT;
	Temp_water_tank_DS		: REAL;
	Teplica_temp_panel		: REAL;
	teplica_tank_level_word	: ARRAY[0..17] OF WORD;
	teplica_tankA_level_word	: ARRAY[0..17] OF WORD;
	teplica_tankB_level_word	: ARRAY[0..17] OF WORD;

	Teplica_tank_level		: REAL;
	Teplica_tankA_level		: REAL;
	Teplica_tankB_level		: REAL;

	cnt_clear_di_2: BOOL;
	zero						: INT:=0;
	MBdataDI		 			 : ARRAY [1..8] OF UINT;
	Teplica_DO1			:	BOOL;
	Teplica_DO2			:	BOOL;
	Teplica_DO3			:	BOOL;
	Teplica_DO4			:	BOOL;
	Teplica_DO5			:	BOOL;
	Teplica_DO6			:	BOOL;
	Teplica_DO7			:	BOOL;
	Teplica_DO8			:	BOOL;

	MBdataDO_byte: BYTE;
	MBdataDO_byte_read: BYTE;
	test: BOOL;
END_VAR


(* @END_DECLARATION := '0' *)

(*Modbus.RS485_1_cnt_error		:= Modbus.RS485_1_cnt_error;
Modbus.RS485_1_cnt_success	:= Modbus.RS485_1_cnt_success;
*)

MBdataDO_byte.0			:=	Modbus.Teplica_pomp_fertA;
MBdataDO_byte.1			:=	Modbus.Teplica_pomp_fertB;
MBdataDO_byte.2			:=	Modbus.Teplica_zone_poliv;
MBdataDO_byte.3			:=	Modbus.Teplica_window_opener;
MBdataDO_byte.4			:=	Modbus.Teplica_pomp_cold;
MBdataDO_byte.5			:=	Modbus.Teplica_tank_heat;
MBdataDO_byte.7			:= 	Modbus.Light_garden;

CASE state OF
0:
		MB.ReadRegs(Execute:= FALSE);
		state := 2;

		e_rs1	:=0;
		Modbus_array_errors[0] :=0;
		Modbus_array_errors[1] :=0;
		Modbus_array_errors[2] :=0;
		Modbus_array_errors[3] :=0;
		Modbus_array_errors[4] :=0;
		Modbus_array_errors[5] :=0;
		Modbus_array_errors[6] :=0;
		Modbus_array_errors[7] :=0;
		Modbus_array_errors[8] :=0;
		Modbus_array_errors[9] :=0;
		Modbus_array_errors[10] :=0;



1:

		MB.ReadInputRegs(
			UnitID:= sensors_SHT20_v2_id[l],
			Quantity:= 2,
			MBAddr:= 512,
			cbLength:= 4,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				sensors_SHT20_v2_temp[l]:=INT_TO_REAL(MBdata[1])/10;
				sensors_SHT20_v2_hum[l]:=INT_TO_REAL(MBdata[2])/10;
			ELSE
				Modbus_array_errors[e_rs1]	:= sensors_SHT20_v2_id[l];
				e_rs1	:= e_rs1+1;
			END_IF

			l:=l+1;
			MB.ReadRegs(Execute:= FALSE);
			IF (l>1 )	THEN
				l:=1;
				Modbus.Balkon_hum	:=	sensors_SHT20_v2_hum[1];

(*				Internal.Sport_underfloor_temp_SHT20		:=	sensors_SHT20_v2_temp[1];
				Internal.Sport_underfloor_hum				:=	sensors_SHT20_v2_hum[1];


				Modbus.Sport_underfloor_temp_SHT20		:=	(sensors_SHT20_v2_temp[1]);
				Modbus.Sport_underfloor_hum				:=	(sensors_SHT20_v2_hum[1]);
*)
				state :=2;
			ELSE
				state :=1;
			END_IF

		END_IF



2:
		MB.ReadRegs(
			UnitID:= sensors_SHT20_v1_id[i],
			Quantity:= 2,
			MBAddr:= 0,
			cbLength:= 4,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				sensors_SHT20_v1_temp[i]:=INT_TO_REAL(MBdata[1])/10;
				sensors_SHT20_v1_hum[i]:=INT_TO_REAL(MBdata[2])/10;
			ELSE
				Modbus_array_errors[e_rs1]	:= sensors_SHT20_v1_id[i];

				e_rs1	:= e_rs1+1;
			END_IF
			i:=i+1;
			MB.ReadRegs(Execute:= FALSE);
			IF (i>3 )	THEN
				i:=1;
				Internal.Street_temp_SHT20			:=	sensors_SHT20_v1_temp[1];
				Internal.Street_hum				:=	sensors_SHT20_v1_hum[1];
				Internal.Sklad_temp_SHT20			:=	sensors_SHT20_v1_temp[2];
				Internal.Sklad_hum				:=	sensors_SHT20_v1_hum[2];

				Modbus.Street_temp_SHT20		:=	sensors_SHT20_v1_temp[1];
				Modbus.Street_hum				:=	sensors_SHT20_v1_hum[1];
				Modbus.Sklad_temp_SHT20		:=	sensors_SHT20_v1_temp[2];
				Modbus.Sklad_hum				:=	sensors_SHT20_v1_hum[2];
				Modbus.Parnik_sht_air_temp		:=	(sensors_SHT20_v1_temp[3])/10;
				Modbus.Parnik_sht_air_hum		:=	(sensors_SHT20_v1_hum[3])/10;
				state :=3;
			ELSE
				state :=2;
			END_IF

		END_IF


3:
		MB.ReadRegs(
			UnitID:= sensors_SHT30_v3_id[i],
			Quantity:= 2,
			MBAddr:= 512,
			cbLength:= 4,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				sensors_SHT30_v3_temp[i]:=INT_TO_REAL(MBdata[1])/10;
				sensors_SHT30_v3_hum[i]:=INT_TO_REAL(MBdata[2])/10;
			ELSE
				Modbus_array_errors[e_rs1]	:= sensors_SHT30_v3_id[i];

				e_rs1	:= e_rs1+1;
			END_IF
			i:=i+1;
			MB.ReadRegs(Execute:= FALSE);
			IF (i>8 )	THEN
				i:=1;
				Internal.Drovnik_temp_SHT30		:=	sensors_SHT30_v3_temp[1];
				Internal.Drovnik_hum				:=	sensors_SHT30_v3_hum[1];
				Internal.Sport_temp_SHT30			:=	sensors_SHT30_v3_temp[2];
				Internal.Sport_hum					:=	sensors_SHT30_v3_hum[2];
				Internal.First_floor_temp_SHT30		:=	sensors_SHT30_v3_temp[3];
				Internal.First_floor_hum				:=	sensors_SHT30_v3_hum[3];
				Internal.Second_floor_temp_SHT30	:=	sensors_SHT30_v3_temp[4];
				Internal.Second_floor_hum			:=	sensors_SHT30_v3_hum[4];
				Internal.Underfloor_temp_SHT30		:=	sensors_SHT30_v3_temp[5];
				Internal.Underfloor_hum			:=	sensors_SHT30_v3_hum[5];
				Internal.Sport_underfloor_temp_SHT30		:=	sensors_SHT30_v3_temp[6];
				Internal.Sport_underfloor_hum				:=	sensors_SHT30_v3_hum[6];
				Internal.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp[7];
				Internal.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum[7];

				Modbus.Drovnik_temp_SHT30		:=	sensors_SHT30_v3_temp[1];
				Modbus.Drovnik_hum				:=	sensors_SHT30_v3_hum[1];
				Modbus.Sport_temp_SHT30		:=	sensors_SHT30_v3_temp[2];
				Modbus.Sport_hum				:=	sensors_SHT30_v3_hum[2];
				Modbus.First_floor_temp_SHT30	:=	sensors_SHT30_v3_temp[3];
				Modbus.First_floor_hum			:=	sensors_SHT30_v3_hum[3];
				Modbus.Second_floor_temp_SHT30	:=	sensors_SHT30_v3_temp[4];
				Modbus.Second_floor_hum			:=	sensors_SHT30_v3_hum[4];
				Modbus.Underfloor_temp_SHT30	:=	sensors_SHT30_v3_temp[5];
				Modbus.Underfloor_hum			:=	sensors_SHT30_v3_hum[5];
				Modbus.Sport_underfloor_temp_SHT30		:=	(sensors_SHT30_v3_temp[6]);
				Modbus.Sport_underfloor_hum				:=	(sensors_SHT30_v3_hum[6]);
				Modbus.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp[7];
				Modbus.Teplica_temp_air			:=	sensors_SHT30_v3_temp[7];
				Modbus.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum[7];
				Modbus.Balkon_hum				:=	sensors_SHT30_v3_hum[8];
				state :=4;
			ELSE
				state :=3;
			END_IF

		END_IF

4:
		MB.ReadInputRegs(
			UnitID:=sensors_CO2_id[k], (* station address *)
			Quantity:= 1,
			MBAddr:= 3,
			cbLength:= 2,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy	);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				sensors_CO2_ppm[k]	:=	(MBdata[1]);
			ELSE
				Modbus_array_errors[e_rs1]	:= sensors_CO2_id[k];
				e_rs1	:= e_rs1+1;
			END_IF
			k:=k+1;
			MB.ReadRegs(Execute:= FALSE);
			IF (k>4 )	THEN
				k:=1;
				Modbus.Second_floor_CO2		:=	(sensors_CO2_ppm[1]);
				Modbus.First_floor_CO2		:=	(sensors_CO2_ppm[2]);
				Modbus.Balkon_CO2			:=	(sensors_CO2_ppm[3]);
				Modbus.Teplica_CO2			:=	(sensors_CO2_ppm[4]);

				state :=6;
			ELSE
				state :=4;
			END_IF
		END_IF




5:

		MB.ReadRegs(
			UnitID:= house_DS18B20_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8_h),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
(*				sensors_DS18B20_temp[1]:=INT_TO_REAL(MBdata8_h[1])/10;
				sensors_DS18B20_temp[2]:=INT_TO_REAL(MBdata8_h[2])/10;
				sensors_DS18B20_temp[3]:=INT_TO_REAL(MBdata8_h[3])/10;
				sensors_DS18B20_temp[4]:=INT_TO_REAL(MBdata8_h[4])/10;
*)
				IF (MBdata8_h[1] < 10000)
					THEN	sensors_DS18B20_temp[1]:=UINT_TO_REAL(MBdata8_h[1])/10;
				ELSE
					sensors_DS18B20_temp[1]:=-1*UINT_TO_REAL(MBdata8_h[1]-10000)/10;
				END_IF

				IF (MBdata8_h[2] < 10000)
					THEN	sensors_DS18B20_temp[2]:=UINT_TO_REAL(MBdata8_h[2])/10;
				ELSE
					sensors_DS18B20_temp[2]:=-1*UINT_TO_REAL(MBdata8_h[2]-10000)/10;
				END_IF


				IF (MBdata8_h[3] < 10000)
					THEN	sensors_DS18B20_temp[3]:=UINT_TO_REAL(MBdata8_h[3])/10;
				ELSE
					sensors_DS18B20_temp[3]:=-1*UINT_TO_REAL(MBdata8_h[3]-10000)/10;
				END_IF

				IF (MBdata8_h[5] < 10000)
					THEN	sensors_DS18B20_temp[5]:=UINT_TO_REAL(MBdata8_h[5])/10;
				ELSE
					sensors_DS18B20_temp[5]:=-1*UINT_TO_REAL(MBdata8_h[5]-10000)/10;
				END_IF



				IF  (sensors_DS18B20_temp[5] <>0 AND sensors_DS18B20_temp[5] <>85)	THEN
					Modbus.Rezerv_temp			:=	sensors_DS18B20_temp[5];
				END_IF
(*
				IF  (sensors_DS18B20_temp[2] <>0 AND sensors_DS18B20_temp[2] <>85)	THEN
					Modbus.		:=	sensors_DS18B20_temp[2];
				END_IF

				IF  (sensors_DS18B20_temp[3] <>0 AND sensors_DS18B20_temp[3] <>85)	THEN
					Modbus. 	:=	sensors_DS18B20_temp[3];
				END_IF

				IF  (sensors_DS18B20_temp[4] <>0 AND sensors_DS18B20_temp[4] <>85)	THEN
					Modbus. 	:=	sensors_DS18B20_temp[4];
				END_IF
*)

			ELSE
				Modbus_array_errors[e_rs1]	:= house_DS18B20_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=6;

		END_IF


6:

		MB.ReadRegs(
			UnitID:= parnik_DS18B20_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8),
			Execute:= TRUE,
			Timeout:=  T#2000ms,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (MB.Error = FALSE ) THEN
				IF (MBdata8[1] < 10000)
					THEN	teplica_DS18B20_temp[1]:=UINT_TO_REAL(MBdata8[1])/10;
				ELSE
					teplica_DS18B20_temp[1]:=-1*UINT_TO_REAL(MBdata8[1]-10000)/10;
				END_IF

				IF (MBdata8[2] < 10000)
					THEN	teplica_DS18B20_temp[2]:=UINT_TO_REAL(MBdata8[2])/10;
				ELSE
					teplica_DS18B20_temp[2]:=-1*UINT_TO_REAL(MBdata8[2]-10000)/10;
				END_IF


				IF (MBdata8[3] < 10000)
					THEN	teplica_DS18B20_temp[3]:=UINT_TO_REAL(MBdata8[3])/10;
				ELSE
					teplica_DS18B20_temp[3]:=-1*UINT_TO_REAL(MBdata8[3]-10000)/10;
				END_IF

				IF (MBdata8[4] < 10000)
					THEN	teplica_DS18B20_temp[4]:=UINT_TO_REAL(MBdata8[4])/10;
				ELSE
					teplica_DS18B20_temp[4]:=-1*UINT_TO_REAL(MBdata8[4]-10000)/10;
				END_IF

				IF (MBdata8[5] < 10000)
					THEN	teplica_DS18B20_temp[5]:=UINT_TO_REAL(MBdata8[5])/10;
				ELSE
					teplica_DS18B20_temp[5]:=-1*UINT_TO_REAL(MBdata8[5]-10000)/10;
				END_IF


				IF  (teplica_DS18B20_temp[1] <>0 AND teplica_DS18B20_temp[1] <>85 AND teplica_DS18B20_temp[1] > -60  )	THEN
					Modbus.Parnik_air_temp	:= 		teplica_DS18B20_temp[1];
				END_IF

				IF  (teplica_DS18B20_temp[2] <>0 AND teplica_DS18B20_temp[2] <>85 AND teplica_DS18B20_temp[2] > -60)	THEN
					Modbus.Parnik_ground_temp		:=	teplica_DS18B20_temp[2];
				END_IF


				IF  (teplica_DS18B20_temp[3] <>0 AND teplica_DS18B20_temp[3] <>85  AND teplica_DS18B20_temp[3] > -60)	THEN
					Modbus.Parnik_pipe_temp	 	:=	teplica_DS18B20_temp[3];
				END_IF

(*				IF  (teplica_DS18B20_temp[4] <>0 AND teplica_DS18B20_temp[4] <>85 AND teplica_DS18B20_temp[4] > -60)	THEN

					Temp_water_tank_DS				:=	teplica_DS18B20_temp[4];
				END_IF

				IF  (teplica_DS18B20_temp[5] <>0 AND teplica_DS18B20_temp[5] <>85 AND teplica_DS18B20_temp[5] > -60)	THEN
					Teplica_temp_pip_heat_in 	:=	teplica_DS18B20_temp[5];
				END_IF

				IF  (teplica_DS18B20_temp[1]  = 0 OR teplica_DS18B20_temp[2]  = 0 OR teplica_DS18B20_temp[3]  = 0 OR teplica_DS18B20_temp[4]  = 0OR  teplica_DS18B20_temp[5]  = 0) THEN
					cnt_err_read_all	:=	cnt_err_read_all+1;
				END_IF

*)


			ELSE
				Modbus_array_errors[e_rs1]	:= parnik_DS18B20_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
				state:=7;

		END_IF




7:

		MB.ReadRegs(
			UnitID:= balkon_light_sensor_id,
			Quantity:= 1,
			MBAddr:= 6,
			cbLength:= 2,
			pMemoryAddr:= ADR(balkon_light_word2),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				Modbus.Balkon_light_lux		:=	WORD_TO_UDINT(balkon_light_word2);
			ELSE
				Modbus_array_errors[e_rs1]	:= balkon_light_sensor_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=8;
		END_IF

8:

		MB.ReadRegs(
			UnitID:= teplica_light_sensor_id,
			Quantity:= 2,
			MBAddr:= 2,
			cbLength:= 4,
			pMemoryAddr:= ADR(teplica_light_array),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (MB.Error = FALSE ) THEN
				teplica_light_high:=teplica_light_array[1];
				teplica_light_low:=teplica_light_array[2];
				teplica_light_dword:=(teplica_light_array[1]*65535)+teplica_light_array[2];
				Modbus.Teplica_light_lux		:=	DWORD_TO_REAL(teplica_light_dword);


			ELSE
				Modbus_array_errors[e_rs1]	:= teplica_light_sensor_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=9;
		END_IF

9:

		MB.ReadRegs(
			UnitID:= sensor_ponics_PH_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_ponics_PH),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				Modbus.Ponics_PH			:=	INT_TO_REAL(MBdata_sensor_ponics_PH[1])/100;
				Modbus.Ponics_tank_temp		:=	INT_TO_REAL(MBdata_sensor_ponics_PH[3])/10;
				Ponics_ph_sensor_mv			:=	INT_TO_REAL(MBdata_sensor_ponics_PH[4]);

			ELSE
				Modbus_array_errors[e_rs1]	:= sensor_ponics_PH_id;
				e_rs1	:= e_rs1+1;

			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=11;
		END_IF

10:

		MB.ReadRegs(
			UnitID:= sensor_teplica_PH_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_teplica_PH),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (MB.Error = FALSE ) THEN
				Modbus.Teplica_sensor_soil_PH	:=	INT_TO_REAL(MBdata_sensor_teplica_PH[1])/100;
				Teplica_ph_sensor_low			:=	INT_TO_REAL(MBdata_sensor_teplica_PH[2])/10;
				Teplica_ph_sensor_temp			:=	INT_TO_REAL(MBdata_sensor_teplica_PH[3])/10;
				Teplica_ph_sensor_mv			:=	INT_TO_REAL(MBdata_sensor_teplica_PH[4]);

			ELSE
				Modbus_array_errors[e_rs1]	:= sensor_teplica_PH_id;
				e_rs1	:= e_rs1+1;

			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=11;
		END_IF


11:

		MB.ReadRegs(
			UnitID:= sensor_ponics_EC_id,
			Quantity:= 1,
			MBAddr:= 2,
			cbLength:= 2,
			pMemoryAddr:= ADR(sensor_ponics_EC_int),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
			Modbus.Ponics_EC	:=	 INT_TO_REAL(sensor_ponics_EC_int)/1000;
				IF(Modbus.Ponics_EC < 0)	THEN
					Modbus.Ponics_EC	:= 0;
				END_IF
			ELSE
				Modbus_array_errors[e_rs1]	:= sensor_ponics_EC_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=12;
		END_IF

12:

		MB.ReadRegs(
			UnitID:= sensor_teplica_EC_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_teplica_EC),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (MB.Error = FALSE ) THEN
			Modbus.Teplica_sensor_soil_Hum	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[1])/10;
			Modbus.Teplica_sensor_soil_Temp	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[2])/10;
			Modbus.Teplica_sensor_soil_EC	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[3])/1000;
			Modbus.Teplica_sensor_soil_PH2	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[4])/10;
			ELSE
				Modbus_array_errors[e_rs1]	:= sensor_teplica_EC_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=15;

		END_IF

14:

		MB.ReadRegs(
			UnitID:= sensor_ponics_EC2_id,
			Quantity:= 1,
			MBAddr:= 8,
			cbLength:= 2,
			pMemoryAddr:= ADR(MBdata_sensor_ponics_EC2),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (MB.Error = FALSE ) THEN
		(*	Modbus.Teplica_sensor_soil_Hum	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[1])/10;
			Modbus.Teplica_sensor_soil_Temp	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[2])/10;
			Modbus.Teplica_sensor_soil_PH2	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[4])/10;
		*)
			ponics_EC2_1		:=	INT_TO_REAL(MBdata_sensor_ponics_EC2);
			Modbus.Sensor_EC2	:=	INT_TO_REAL(MBdata_sensor_ponics_EC2);
			ELSE
				Modbus_array_errors[e_rs1]	:= sensor_ponics_EC2_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=15;

		END_IF





15:

		MB.ReadRegs(
			UnitID:= teplica_gate_pt1000_id,
			Quantity:= 8,
			MBAddr:= 32,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8_pt1000),
			Execute:= TRUE,
			Timeout:=  T#2000ms,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (MB.Error = FALSE ) THEN
				IF (MBdata8_pt1000[1] <> -100)
					THEN	MBdata_teplica_gate_pt1000[1]:=INT_TO_REAL(MBdata8_pt1000[1])/10;
				END_IF
				IF (MBdata8_pt1000[2] <> -100)
					THEN	MBdata_teplica_gate_pt1000[2]:=INT_TO_REAL(MBdata8_pt1000[2])/10;
				END_IF
				IF (MBdata8_pt1000[3] <> -100)
					THEN	MBdata_teplica_gate_pt1000[3]:=INT_TO_REAL(MBdata8_pt1000[3])/10;
				END_IF
				IF (MBdata8_pt1000[4] <> -100)
					THEN	MBdata_teplica_gate_pt1000[4]:=INT_TO_REAL(MBdata8_pt1000[4])/10;
				END_IF
				IF (MBdata8_pt1000[5] <> -100)
					THEN	MBdata_teplica_gate_pt1000[5]:=INT_TO_REAL(MBdata8_pt1000[5])/10;
				END_IF
				IF (MBdata8_pt1000[6] <> -100)
					THEN	MBdata_teplica_gate_pt1000[6]:=INT_TO_REAL(MBdata8_pt1000[6])/10;
				END_IF
				IF (UINT_TO_INT(MBdata8_pt1000[7]) <> -100)
					THEN	MBdata_teplica_gate_pt1000[7]:=INT_TO_REAL(MBdata8_pt1000[7])/10;
				END_IF
				IF (MBdata8_pt1000[8] <> -100)
					THEN	MBdata_teplica_gate_pt1000[8]:=INT_TO_REAL(MBdata8_pt1000[8])/10;
				END_IF

				IF (MBdata_teplica_gate_pt1000[1] <> -100) THEN
					Modbus.Teplica_temp_LED	 	:=	MBdata_teplica_gate_pt1000[1];   (* Temp LED *)
				END_IF

				IF (MBdata_teplica_gate_pt1000[2] <> -100) THEN
					Modbus.Teplica_temp_panel		:= 	MBdata_teplica_gate_pt1000[2];  (* Temp panel*)
				END_IF

				IF (MBdata_teplica_gate_pt1000[3] <> -100) THEN
					Modbus.Teplica_temp_air_in	 	:=	MBdata_teplica_gate_pt1000[3];
				END_IF
				IF (MBdata_teplica_gate_pt1000[4] <> -100) THEN

					Modbus.Teplica_temp_ground		:=	MBdata_teplica_gate_pt1000[4];
				END_IF

				IF (MBdata_teplica_gate_pt1000[5] <> -100) THEN
					Modbus.Teplica_temp_water_tank 	:=	MBdata_teplica_gate_pt1000[5];
				END_IF

				IF (MBdata_teplica_gate_pt1000[6] <> -100) THEN
					Modbus.Teplica_temp_pipe_heat	:=	MBdata_teplica_gate_pt1000[6]; (* Temp air*)
				END_IF



			ELSE
				Modbus_array_errors[e_rs1]	:= teplica_gate_pt1000_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
				state:=16;

		END_IF




16:

		MB.ReadRegs(
			UnitID:= Teplica_tank_level_id,
			Quantity:= 18,
			MBAddr:= 0,
			cbLength:= 36,
			pMemoryAddr:= ADR(teplica_tank_level_word),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				Teplica_tank_level		:=	WORD_TO_REAL(teplica_tank_level_word[4]);
				Modbus.Teplica_tank_level		:=	REAL_TO_INT(Teplica_tank_level);
(*				Modbus.Test5			:=	REAL_TO_INT(100*(Teplica_tank_level*0.001*3.14159*1.22*1.22*0.25)/1.5); *)
			ELSE
				Modbus_array_errors[e_rs1]	:= Teplica_tank_level_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=17;
		END_IF

17:

		MB.ReadRegs(
			UnitID:= Teplica_tankA_level_id,
			Quantity:= 18, (* 1 *)
			MBAddr:= 0, (* 4 *)
			cbLength:= 36, (* 2 *)
			pMemoryAddr:= ADR(teplica_tankA_level_word),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				Teplica_tankA_level			:=	WORD_TO_REAL(teplica_tankA_level_word[4]);
				Modbus.Teplica_tankA_level	:=	REAL_TO_INT(Teplica_tankA_level)-8;
			ELSE
				Modbus_array_errors[e_rs1]	:= Teplica_tankA_level_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=18;
		END_IF



18:

		MB.ReadRegs(
			UnitID:= Teplica_tankB_level_id,
			Quantity:= 18, (* 1 *)
			MBAddr:= 0, (* 4 *)
			cbLength:= 36, (* 2 *)
			pMemoryAddr:= ADR(teplica_tankB_level_word),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
				Teplica_tankB_level			:=	WORD_TO_REAL(teplica_tankB_level_word[4]);
				Modbus.Teplica_tankB_level	:=	REAL_TO_INT(Teplica_tankB_level)-2;
			ELSE
				Modbus_array_errors[e_rs1]	:= Teplica_tankB_level_id;
				e_rs1	:= e_rs1+1;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=20;
		END_IF


















20:

	IF (MBdataDO_byte <> MBdataDO_byte_read) THEN
		MB.WriteMultipleCoils(
			UnitID:= teplica_ADM4188_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdataDO_byte),
			Execute:= TRUE,
			Timeout:= T#2000ms,
			Busy => busy,
			);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
					cnt_clear_di_2	:=	TRUE;
			END_IF
			IF (mb.Error = TRUE ) THEN
				Modbus_array_errors[e_rs1]	:= teplica_ADM4188_id;
				e_rs1	:= e_rs1+1;
				cnt_clear_di_2	:=	FALSE;
			END_IF
			MB.ReadRegs(Execute:= FALSE);
			state:=21;
		END_IF
	ELSE
		state:=21;

	END_IF

(*считывание DO значений *)
21:
	MB.ReadCoils(
					UnitID:= teplica_ADM4188_id, (* station address *)
					Quantity:= 8,
					MBAddr:= 0,
					cbLength:= 16,
					pMemoryAddr:= ADR(MBdataDO_byte_read),
					Execute:= TRUE,
					Timeout:= T#2000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb.Error = FALSE ) THEN
					Teplica_DO1		:=MBdataDO_byte_read.0;
					Teplica_DO2		:=MBdataDO_byte_read.1;
					Teplica_DO3		:=MBdataDO_byte_read.2;
					Teplica_DO4		:=MBdataDO_byte_read.3;
					Teplica_DO5		:=MBdataDO_byte_read.4;
					Teplica_DO6		:=MBdataDO_byte_read.5;
					Teplica_DO7		:=MBdataDO_byte_read.6;
					Teplica_DO8		:=MBdataDO_byte_read.7;

			END_IF
(*			IF (mb.Error = TRUE ) THEN
				Modbus_array_errors[e_rs1]	:= teplica_ADM4188_id;
				e_rs1	:= e_rs1+1;
			END_IF
*)
			MB.ReadRegs(Execute:= FALSE);
			state:=105;
		END_IF



















(*	state:=105; *)

105: (*открываем канал*)


	Clear(Buffer := RxBufferCom1);
	arrSend[1]:=Merc_address;
	arrSend[2]:=1; (*код доступа*)
	arrSend[3]:=1; (*Уровень доступа*)

	MEMCPY(ADR(arrSend)+3,ADR(password_1),6); (*пароль*)
	crctest:=F_CRC16(ADR(arrSend),9); (*расчет контрольной суммы*)
	MEMCPY(ADR(arrSend)+9,ADR(crctest),SIZEOF(crctest)); (*прибавление контрольной суммы к запросу*)
	SendDatacom1(pSendData:=ADR(arrSend),Length:=11,TXBuffer:=TxBuffercom1,Busy=>,Error=>);
(*	tmCheck(in:=FALSE); *)
	tmCheckM(in:=FALSE);
	tmCheckM(in:=TRUE, pt:=t#3s); 	(*запуск таймера проверки - потеря связи\обрыв кабеля*)
	state:=106;

106: (*ответ*)
	ReceiveDatacom1(pPrefix:=,LenPrefix:=,pSuffix:=,LenSuffix:=,
	pReceiveData:=ADR(arrReceive),SizeReceiveData:=4,
	Timeout:=t#2s,Reset:=,
	RXbuffer:=RxBuffercom1,
	DataReceived=>,busy=>,Error=>,RxTimeout=>,LenReceiveData=>);
	IF ReceiveDatacom1.Error <> 0 THEN
		state:=888;
	END_IF
	IF receiveDatacom1.DataReceived THEN
		state:=107;
	ELSIF tmCheckM.Q THEN
		state:=888;
	END_IF
107: (*проверка ответа*)

	IF arrReceive[1] = Merc_address THEN
		state:= 108;
	ELSE
		state:=888;
	END_IF



108:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_supply_done := FALSE;
		get_supply( byte1:=16#8, byte2:=16#16, byte3:=16#11,  supply1=>Modbus.UV1,supply2=>Modbus.UV2,supply3=>Modbus.UV3, done=>get_supply_done);
		IF get_supply_done = TRUE THEN
			Modbus.RS485_3_cnt_success := Modbus.RS485_3_cnt_success+1;
			state:=109;
		ELSIF tmcheck.Q THEN
			Modbus.RS485_3_cnt_error := Modbus.RS485_3_cnt_error+1;
			 state:=888;
		END_IF



 (*запрос на чтение тока  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
109:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_current_done := FALSE;
		get_current(byte1:=16#8, byte2:=16#16, byte3:=16#21,  current1=>Modbus.Ia1,current2=>Modbus.Ia2,current3=>Modbus.Ia3, done=>get_current_done);
		IF get_current_done = TRUE THEN
			state:=110;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение мощности  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

110:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_power_done := FALSE;
		get_power(byte1:=16#8, byte2:=16#16, byte3:=16#0,  power_total=>Modbus.pw_total, power1=>Modbus.pw1, power2=>Modbus.pw2,power3=>Modbus.pw3,done=>get_power_done);
		IF get_power_done = TRUE THEN
			state:=111;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение энергии T1
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
111:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T1_done := FALSE;
		get_energy_E_T1(byte1:=5, byte2:=16#0, byte3:=1,  energy=>Modbus.E_T1, done=>get_energy_E_T1_done);
		IF get_energy_E_T1_done = TRUE THEN
			state:=112;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF
 (*запрос на чтение энергии T2
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

112:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T2_done := FALSE;
		get_energy_E_T2(byte1:=5, byte2:=16#0, byte3:=2,  energy=>Modbus.E_T2, done=>get_energy_E_T2_done);
		IF get_energy_E_T2_done = TRUE THEN
			state:=888;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

113:
		Timer_day(IN:=NOT Timer_dayQ , PT:=T#60m , Q=>Timer_dayQ , ET=> );
			IF timer_day.q THEN
				state:=114;
			ELSE
				state:=888;
			END_IF

114:
	(*	tmCheck(in:=FALSE);	*)
		tmCheckE(in:=NOT tmCheckE.q,pt:=t#2s, Q=>tmCheckEQ , ET=>);
		get_energy_MT_done := FALSE;

	(*	IF (tmCheckEQ) THEN *)
			get_energy_MT(byte1:=5, byte2:=INT_TO_BYTE(48+m), byte3:=INT_TO_BYTE(t),   energy=>energyMT[m,t],done=>get_energy_MT_done);
(*		END_IF *)

		IF get_energy_MT_done = TRUE THEN
			t:=t+1;
			IF (t>2 AND m<13) THEN
				t:=1;
				m:=m+1;
				state:=114;
			END_IF

					IF ( m=13) THEN
						t:=1;
						m:=1;
						Modbus.M1T1:=energyMT[1,1];
						Modbus.M1T2:=energyMT[1,2];
						Modbus.M2T1:=energyMT[2,1];
						Modbus.M2T2:=energyMT[2,2];
						Modbus.M3T1:=energyMT[3,1];
						Modbus.M3T2:=energyMT[3,2];
						Modbus.M4T1:=energyMT[4,1];
						Modbus.M4T2:=energyMT[4,2];
						Modbus.M5T1:=energyMT[5,1];
						Modbus.M5T2:=energyMT[5,2];
						Modbus.M6T1:=energyMT[6,1];
						Modbus.M6T2:=energyMT[6,2];
						Modbus.M7T1:=energyMT[7,1];
						Modbus.M7T2:=energyMT[7,2];
						Modbus.M8T1:=energyMT[8,1];
						Modbus.M8T2:=energyMT[8,2];
						Modbus.M9T1:=energyMT[9,1];
						Modbus.M9T2:=energyMT[9,2];
						Modbus.M10T1:=energyMT[10,1];
						Modbus.M10T2:=energyMT[10,2];
						Modbus.M11T1:=energyMT[11,1];
						Modbus.M11T2:=energyMT[11,2];
						Modbus.M12T1:=energyMT[12,1];
						Modbus.M12T2:=energyMT[12,2];
						state:=888;
					END_IF
		ELSIF tmcheckE.Q THEN state:=114;
		END_IF






888:
		Modbus_errors 				:=  BYTE_TO_DWORD(Modbus_array_errors[0]) + BYTE_TO_DWORD(Modbus_array_errors[1]) * 16#100 + BYTE_TO_DWORD(Modbus_array_errors[2]) * 16#10000 + BYTE_TO_DWORD(Modbus_array_errors[3]) * 16#1000000;
		Modbus.Modbus_4errors 		:= Modbus_errors;
		Modbus.Modbus_qual_errors	:= e_rs1;

		IF Modbus.Teplica_poliv_status_PLC=2 AND Modbus.Teplica_type_poliv = TRUE AND Poliv_liters>Modbus.Teplica_set_poliv_before_fert-10 AND MBdataDO_byte <> MBdataDO_byte_read THEN
			tTimerValue	:= t#1s;
		ELSE
			tTimerValue	:= t#60s;
		END_IF

		Timer1(IN:=NOT Timer1Q , PT:=tTimerValue , Q=>Timer1Q , ET=> );
		IF timer1.q THEN
			state:=0;
		END_IF

END_CASE

FtrigBusy(CLK:=mb.BUSY );
IF FtrigBusy.Q THEN
	IF mb.Error THEN
		LastModbusError := mb.ErrorDiagnostics;
		LastErrorstate := state;
		Modbus.RS485_1_cnt_error := Modbus.RS485_1_cnt_error + 1;
	ELSE
		Modbus.RS485_1_cnt_success := Modbus.RS485_1_cnt_success + 1;
	END_IF
END_IF



SerialLinecontrolCom1(
	mode:=SerialLinemode_kl6_22b_standard,
	pComIn:=ADR(RS485read.MB.InData),
	pComOut:=ADR(RS485read.MB.OutData),
	SizeComIn:=SIZEOF(RS485read.MB.OutData),
	TxBuffer:=TxBufferCom1,
	RxBuffer:=RxBufferCom1,
	Error=>,
	errorid=>);


END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)

PROGRAM RS485read_2
VAR

(*	KLConfiguration: KL6configuration; *)
(*	Period_vent_switch	: INT:=180; *)
	tTimerValue			: TIME	:=	t#60s; (* Период опроса RS485*)

	MBdata_pzem			 : ARRAY [1..2] OF INT;

	FtrigBusy				: F_TRIG;
	timeoutvalue				: TIME := T#2000ms;		(* timeout while waiting for an answer of the modbus slave *)
	state					: INT;
	busy					: BOOL;
	LastErrorstate				: INT;
	LastModbusError			: ST_ModbusErrorDiagnostics;
	CounterError				: DINT;
	CounterSuccess			: DINT;

	sensors_PZEM_id			: BYTE:=16#02;
	sensors_PZEM_data		: ARRAY[1..2] OF REAL:=2(0);

(*	sensors_DS18B20_id			: BYTE:=16#01;
	sensors_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);
*)
(*
	get_co2_mh_z19b_1floor	: FB_GET_CO2_MH_Z19B;
	get_co2_mh_z19b_1floor_done	: BOOL;
*)




	PWM_YC110_id			: BYTE:= 16#20 ; (*32 *)
	PWM_levels				 : ARRAY [1..4] OF INT;	(* reg dec 32*)
	PWM_levels_mem		 : ARRAY [1..4] OF INT;
	PWM_freq				 : ARRAY [1..4] OF INT; (* reg dec 64*)
	PWM_freq_mem			 : ARRAY [1..4] OF INT;
	PWM_cycle				 : ARRAY [1..4] OF INT;

	PWM_param_polar		:  INT;	(* reg dec 18*)
	PWM_param_polar_1		:  INT:=1;
	PWM_param_prz			: INT;	(* reg dec 30*)
	PWM_param_prz_1		: INT:=1;	(* reg dec 30*)

	PWM_cycle_1			:  UINT:=65535;
	PWM_cycle_2			:  UINT:=65535;
	PWM_cycle_3			:  UINT:=65535;
	PWM_cycle_4			:  UINT:=65535;

	PWM_set_freq			: INT:=300;
	set_param				: BOOL;
END_VAR


(* @END_DECLARATION := '0' *)
(*Modbus.RS485_2_cnt_error		:= CounterError;
Modbus.RS485_2_cnt_success	:= Modbus.RS485_2_cnt_success; *)




CASE state OF
0:
		MB2.ReadRegs(Execute:= FALSE);
		state := 1;

1:

		MB2.ReadInputRegs(
			UnitID:= sensors_PZEM_id,
			Quantity:= 2,
			MBAddr:= 0,
			cbLength:= 4,
			pMemoryAddr:= ADR(MBdata_pzem),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
				sensors_PZEM_data[1]:=INT_TO_REAL(MBdata_pzem[1])/100;
				sensors_PZEM_data[2]:=INT_TO_REAL(MBdata_pzem[2])/100;
				Modbus.DC_Uv:=sensors_PZEM_data[1];
				Modbus.DC_Ia:=sensors_PZEM_data[2];

			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=888;

		END_IF



2:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 32,
					cbLength:= 2,
					pMemoryAddr:= ADR(fert_pwm_levelA),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=3;
		END_IF

3:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 33,
					cbLength:= 2,
					pMemoryAddr:= ADR(fert_pwm_levelB),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=4;
		END_IF






4:
IF (set_param= FALSE) THEN
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 30,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_param_prz_1) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			MB2.ReadRegs(Execute:= FALSE);
			state:=5;
		END_IF
ELSE
	state:=11;
END_IF





5:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 96,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_1) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=7;
		END_IF


7:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 97,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_2) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=8;
		END_IF


8:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 98,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_3) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=9;
		END_IF

9:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 99,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_4) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=10;
		END_IF




10:
	MB2.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 64,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_set_freq) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			set_param:= TRUE;
			state:=11;
		END_IF







11:
	MB2.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 18,
					cbLength:= 2,
					pMemoryAddr:= ADR(PWM_param_polar),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=12;
		END_IF

12:
	MB2.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 4,
					MBAddr:= 96,
					cbLength:= 8,
					pMemoryAddr:= ADR(PWM_cycle),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=13;
		END_IF



13:
	MB2.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 4,
					MBAddr:= 32,
					cbLength:= 8,
					pMemoryAddr:= ADR(PWM_levels),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (MB2.Error = FALSE ) THEN
				PWM_levels_mem[1]	:=	PWM_levels[1];
				PWM_levels_mem[2]	:=	PWM_levels[2];
				PWM_levels_mem[3]	:=	PWM_levels[3];
				PWM_levels_mem[4]	:=	PWM_levels[4];

			END_IF

			MB2.ReadRegs(Execute:= FALSE);
			state:=14;
		END_IF

14:
	MB2.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 4,
					MBAddr:= 64,
					cbLength:= 8,
					pMemoryAddr:= ADR(PWM_freq),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (MB2.Error = FALSE ) THEN
				PWM_freq_mem[1]	:=	PWM_freq[1];
				PWM_freq_mem[2]	:=	PWM_freq[2];
				PWM_freq_mem[3]	:=	PWM_freq[3];
				PWM_freq_mem[4]	:=	PWM_freq[4];

			END_IF

			MB2.ReadRegs(Execute:= FALSE);
			state:=888;
		END_IF

(*

5:
	MB2.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 30,
					cbLength:= 2,
					pMemoryAddr:= ADR(PWM_param_prz),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (MB2.Error = FALSE ) THEN

			END_IF
		*)
			MB2.ReadRegs(Execute:= FALSE);
			state:=6;
		END_IF

*)


888:
		TimerRS485_2(IN:=NOT TimerRS485_2Q , PT:=tTimerValue , Q=>TimerRS485_2Q , ET=> );
		IF TimerRS485_2.q THEN
			state:=0;
		END_IF

END_CASE

FtrigBusy(CLK:=mb2.BUSY );
IF FtrigBusy.Q THEN
	IF mb2.Error THEN
		LastModbusError := mb2.ErrorDiagnostics;
		LastErrorstate := state;
		Modbus.RS485_2_cnt_error := Modbus.RS485_2_cnt_error + 1;
	ELSE
		Modbus.RS485_2_cnt_success := Modbus.RS485_2_cnt_success + 1;
	END_IF
END_IF

SerialLinecontrolCom2(
	mode:=SerialLinemode_kl6_5b_standard,
	pComIn:=ADR(RS485read_2.MB2.InData),
	pComOut:=ADR(RS485read_2.MB2.OutData),
	SizeComIn:=SIZEOF(RS485read_2.MB2.OutData),
	TxBuffer:=TxBufferCom2,
	RxBuffer:=RxBufferCom2,
	Error=>,
	errorid=>);




END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)

PROGRAM RS485read_2_old
VAR
	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)






	get_energy_E_T1			: FB_GET_ENERGY;
	get_energy_E_T2			: FB_GET_ENERGY;
	get_energy_MT			: FB_GET_ENERGY;
	get_supply				: FB_GET_SUPPLY;
	get_current				: FB_GET_CURRENT;
	get_power				: FB_GET_POWER;
	energyMT					: ARRAY[1..12,1..2] OF REAL;

	get_current_done			: BOOL;
	get_power_done			: BOOL;

	get_energy_E_T1_done	: BOOL;
	get_energy_E_T2_done	: BOOL;
	get_energy_MT_done		: BOOL;

	get_supply_done			: BOOL;
(*	CounterError_M			: DINT;
	CounterSuccess_M		: DINT;
*)




	flag: BOOL := TRUE;
	KLConfiguration: KL6configuration;
(*	Period_vent_switch	: INT:=180; *)
	CO2_period			: TIME;
	tTimerValue			: TIME	:=	t#10s; (* Период опроса RS485*)

	crctest					: WORD;

	arrReceive				: ARRAY[1..5] OF BYTE;
	arrSend					: ARRAY[1..5] OF BYTE;

	MBdata					 : ARRAY [1..2] OF INT;
	MBdata_pzem			 : ARRAY [1..2] OF INT;
	MBdata8					 : ARRAY [1..8] OF INT;
	FtrigBusy				: F_TRIG;
	timeoutvalue				: TIME := T#2000ms;		(* timeout while waiting for an answer of the modbus slave *)
	state					: INT;
	busy					: BOOL;
	LastErrorstate				: INT;
	LastModbusError			: ST_ModbusErrorDiagnostics;
	CounterError				: DINT;
	CounterSuccess			: DINT;

	i,k,l,m,t					: INT:=1;



	sensors_CO2_id				: ARRAY[1..2] OF BYTE:=16#68, 16#69;
	sensors_CO2_ppm			: ARRAY[1..2] OF INT;

	sensors_PZEM_id			: BYTE:=16#02;
	sensors_PZEM_data		: ARRAY[1..2] OF REAL:=2(0);

	sensors_DS18B20_id			: BYTE:=16#01;
	sensors_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);


	get_co2_mh_z19b_1floor	: FB_GET_CO2_MH_Z19B;
(*	get_co2_mh_z19b_2floor	: FB_GET_CO2_MH_Z19B; *)
	get_co2_mh_z19b_1floor_done	: BOOL;
(*	get_co2_mh_z19b_2floor_done	: BOOL; *)
	sensor_ponics_PH_id		: BYTE:= 16#4F ;
	MBdata_sensor_ponics_PH : ARRAY [1..4] OF INT;
	Ponics_PH_temp			: REAL;

	sensor_ponics_PH_int		:INT;

	sensor_ponics_EC_id		: BYTE:= 16#51 ;
(*	sensor_ponics_EC2_id		: BYTE:= 16#50 ; *)
	sensor_ponics_EC_int		:INT;

	balkon_light_sensor_id			: BYTE:=16#5A;
	balkon_light_low				: BYTE;
	balkon_light_high				: BYTE;
	balkon_light_word				:WORD;
	balkon_light_array				: ARRAY [1..2] OF BYTE;


END_VAR


(* @END_DECLARATION := '0' *)
Modbus.RS485_2_cnt_error		:= CounterError;
Modbus.RS485_2_cnt_success	:= CounterSuccess;

IF (Modbus.Security_status = TRUE) THEN
	CO2_period	:= T#30m;
ELSE
	CO2_period 	:= T#2m;
END_IF



CASE state OF
	0:
		MB2.ReadRegs(Execute:= FALSE);
		state := 3;


3:
	(*	Clear2(Buffer := RxBufferCom2); *)
		MB2.ReadInputRegs(
			UnitID:=sensors_CO2_id[k], (* station address *)
			Quantity:= 1,
			MBAddr:= 3,
			cbLength:= 4,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy	);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
				sensors_CO2_ppm[k]	:=	(MBdata[1]);
			END_IF
			k:=k+1;
			MB2.ReadRegs(Execute:= FALSE);
			IF (k>2 )	THEN
				k:=1;

				Modbus.Second_floor_CO2		:=	(sensors_CO2_ppm[1]);
				Modbus.First_floor_CO2		:=	(sensors_CO2_ppm[2]);
				state :=4;
			ELSE
				state :=3;
			END_IF
		END_IF



4:

		MB2.ReadInputRegs(
			UnitID:= sensors_PZEM_id,
			Quantity:= 2,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata_pzem),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
				sensors_PZEM_data[1]:=INT_TO_REAL(MBdata_pzem[1])/100;
				sensors_PZEM_data[2]:=INT_TO_REAL(MBdata_pzem[2])/100;
				Modbus.DC_Uv:=sensors_PZEM_data[1];
				Modbus.DC_Ia:=sensors_PZEM_data[2];

			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=5;

		END_IF


5:

		MB2.ReadRegs(
			UnitID:= sensors_DS18B20_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
				sensors_DS18B20_temp[1]:=INT_TO_REAL(MBdata8[1])/10;
				sensors_DS18B20_temp[2]:=INT_TO_REAL(MBdata8[2])/10;
				sensors_DS18B20_temp[3]:=INT_TO_REAL(MBdata8[3])/10;
				sensors_DS18B20_temp[4]:=INT_TO_REAL(MBdata8[4])/10;

			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=17;

		END_IF

17:

		MB2.ReadRegs(
			UnitID:= balkon_light_sensor_id,
			Quantity:= 1,
			MBAddr:= 6,
			cbLength:= 2,
			pMemoryAddr:= ADR(balkon_light_array),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
				balkon_light_high:=balkon_light_array[1];
				balkon_light_low:=balkon_light_array[2];
				balkon_light_word:=(balkon_light_array[2]*256)+balkon_light_array[1];

				Modbus.Balkon_light_lux		:=	WORD_TO_UDINT(balkon_light_word);
			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=18;

		END_IF
18:

		MB2.ReadRegs(
			UnitID:= sensor_ponics_PH_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_ponics_PH),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
				Modbus.Ponics_PH		:=	0.15+INT_TO_REAL(MBdata_sensor_ponics_PH[1])/100;
				Modbus.Ponics_tank_temp			:=	INT_TO_REAL(MBdata_sensor_ponics_PH[3])/10;

			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=21;

		END_IF

(*
21:

		MB2.ReadRegs(
			UnitID:= sensor_ponics_EC_id,
			Quantity:= 1,
			MBAddr:= 8,
			cbLength:= 2,
			pMemoryAddr:= ADR(sensor_ponics_EC_int),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
			Modbus.Ponics_EC	:=	-1.0 + INT_TO_REAL(sensor_ponics_EC_int)/1000;
			IF(Modbus.Ponics_EC < 0)	THEN
				Modbus.Ponics_EC	:= 0;
			END_IF

			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=888;

		END_IF
*)
21:

		MB2.ReadRegs(
			UnitID:= sensor_ponics_EC_id,
			Quantity:= 1,
			MBAddr:= 2,
			cbLength:= 2,
			pMemoryAddr:= ADR(sensor_ponics_EC_int),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb2.Error = FALSE ) THEN
			Modbus.Ponics_EC	:=	 INT_TO_REAL(sensor_ponics_EC_int)/1000;
			IF(Modbus.Ponics_EC < 0)	THEN
				Modbus.Ponics_EC	:= 0;
			END_IF

			END_IF
			MB2.ReadRegs(Execute:= FALSE);
			state:=888;

		END_IF



(*	state:=105; *)
(*
105: (*открываем канал*)


	Clear(Buffer := RxBufferCom2);
	arrSend[1]:=Merc_address;
	arrSend[2]:=1; (*код доступа*)
	arrSend[3]:=1; (*Уровень доступа*)

	MEMCPY(ADR(arrSend)+3,ADR(password_1),6); (*пароль*)
	crctest:=F_CRC16(ADR(arrSend),9); (*расчет контрольной суммы*)
	MEMCPY(ADR(arrSend)+9,ADR(crctest),SIZEOF(crctest)); (*прибавление контрольной суммы к запросу*)
	SendDataCom2(pSendData:=ADR(arrSend),Length:=11,TXBuffer:=TxBufferCom2,Busy=>,Error=>);
(*	tmCheck(in:=FALSE); *)
	tmCheckM(in:=FALSE);
	tmCheckM(in:=TRUE, pt:=t#3s); 	(*запуск таймера проверки - потеря связи\обрыв кабеля*)
	state:=106;

106: (*ответ*)
	ReceiveDataCom2(pPrefix:=,LenPrefix:=,pSuffix:=,LenSuffix:=,
	pReceiveData:=ADR(arrReceive),SizeReceiveData:=4,
	Timeout:=t#2s,Reset:=,
	RXbuffer:=RxBufferCom2,
	DataReceived=>,busy=>,Error=>,RxTimeout=>,LenReceiveData=>);
	IF ReceiveDataCom2.Error <> 0 THEN
		state:=888;
	END_IF
	IF receiveDataCom2.DataReceived THEN
		state:=107;
	ELSIF tmCheckM.Q THEN
		state:=888;
	END_IF
107: (*проверка ответа*)

	IF arrReceive[1] = Merc_address THEN
		state:= 108;
	ELSE
		state:=888;
	END_IF



108:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_supply_done := FALSE;
		get_supply( byte1:=16#8, byte2:=16#16, byte3:=16#11,  supply1=>Modbus.UV1,supply2=>Modbus.UV2,supply3=>Modbus.UV3, done=>get_supply_done);
		IF get_supply_done = TRUE THEN
			CounterSuccess := CounterSuccess+1;
			state:=109;
		ELSIF tmcheck.Q THEN
			CounterError := CounterError+1;
			 state:=888;
		END_IF



 (*запрос на чтение тока  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
109:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_current_done := FALSE;
		get_current(byte1:=16#8, byte2:=16#16, byte3:=16#21,  current1=>Modbus.Ia1,current2=>Modbus.Ia2,current3=>Modbus.Ia3, done=>get_current_done);
		IF get_current_done = TRUE THEN
			state:=110;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение мощности  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

110:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_power_done := FALSE;
		get_power(byte1:=16#8, byte2:=16#16, byte3:=16#0,  power_total=>Modbus.pw_total, power1=>Modbus.pw1, power2=>Modbus.pw2,power3=>Modbus.pw3,done=>get_power_done);
		IF get_power_done = TRUE THEN
			state:=111;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение энергии T1
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
111:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T1_done := FALSE;
		get_energy_E_T1(byte1:=5, byte2:=16#0, byte3:=1,  energy=>Modbus.E_T1, done=>get_energy_E_T1_done);
		IF get_energy_E_T1_done = TRUE THEN
			state:=112;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF
 (*запрос на чтение энергии T2
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

112:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T2_done := FALSE;
		get_energy_E_T2(byte1:=5, byte2:=16#0, byte3:=2,  energy=>Modbus.E_T2, done=>get_energy_E_T2_done);
		IF get_energy_E_T2_done = TRUE THEN
			state:=113;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

113:
		Timer_day(IN:=NOT Timer_dayQ , PT:=T#30m , Q=>Timer_dayQ , ET=> );
			IF timer_day.q THEN
				state:=114;
			ELSE
				state:=888;
			END_IF

114:
	(*	tmCheck(in:=FALSE);	*)
		tmCheckE(in:=NOT tmCheckE.q,pt:=t#2s, Q=>tmCheckEQ , ET=>);
		get_energy_MT_done := FALSE;

	(*	IF (tmCheckEQ) THEN *)
			get_energy_MT(byte1:=5, byte2:=INT_TO_BYTE(48+m), byte3:=INT_TO_BYTE(t),   energy=>energyMT[m,t],done=>get_energy_MT_done);
(*		END_IF *)

		IF get_energy_MT_done = TRUE THEN
			t:=t+1;
			IF (t>2 AND m<13) THEN
				t:=1;
				m:=m+1;
				state:=114;
			END_IF

					IF ( m=13) THEN
						t:=1;
						m:=1;
						Modbus.M1T1:=energyMT[1,1];
						Modbus.M1T2:=energyMT[1,2];
						Modbus.M2T1:=energyMT[2,1];
						Modbus.M2T2:=energyMT[2,2];
						Modbus.M3T1:=energyMT[3,1];
						Modbus.M3T2:=energyMT[3,2];
						Modbus.M4T1:=energyMT[4,1];
						Modbus.M4T2:=energyMT[4,2];
						Modbus.M5T1:=energyMT[5,1];
						Modbus.M5T2:=energyMT[5,2];
						Modbus.M6T1:=energyMT[6,1];
						Modbus.M6T2:=energyMT[6,2];
						Modbus.M7T1:=energyMT[7,1];
						Modbus.M7T2:=energyMT[7,2];
						Modbus.M8T1:=energyMT[8,1];
						Modbus.M8T2:=energyMT[8,2];
						Modbus.M9T1:=energyMT[9,1];
						Modbus.M9T2:=energyMT[9,2];
						Modbus.M10T1:=energyMT[10,1];
						Modbus.M10T2:=energyMT[10,2];
						Modbus.M11T1:=energyMT[11,1];
						Modbus.M11T2:=energyMT[11,2];
						Modbus.M12T1:=energyMT[12,1];
						Modbus.M12T2:=energyMT[12,2];
						state:=888;
					END_IF
		ELSIF tmcheckE.Q THEN state:=114;
		END_IF


*)


888:
		TimerRS485_2(IN:=NOT TimerRS485_2Q , PT:=tTimerValue , Q=>TimerRS485_2Q , ET=> );
		IF TimerRS485_2.q THEN
			state:=0;
		END_IF

END_CASE

FtrigBusy(CLK:=mb2.BUSY );
IF FtrigBusy.Q THEN
	IF mb2.Error THEN
		LastModbusError := mb2.ErrorDiagnostics;
		LastErrorstate := state;
		CounterError := CounterError + 1;
	ELSE
		CounterSuccess := CounterSuccess + 1;
	END_IF
END_IF

SerialLinecontrolCom2(
	mode:=SerialLinemode_kl6_5b_standard,
	pComIn:=ADR(RS485read_2.MB2.InData),
	pComOut:=ADR(RS485read_2.MB2.OutData),
	SizeComIn:=SIZEOF(RS485read_2.MB2.OutData),
	TxBuffer:=TxBufferCom2,
	RxBuffer:=RxBufferCom2,
	Error=>,
	errorid=>);




END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)

PROGRAM RS485read_3
VAR

	tTimerValue			: TIME	:=	t#30s; (* Период опроса RS485*)

(*	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)
	crctest					: WORD;
	arrReceive				: ARRAY[1..22] OF BYTE;
	arrSend					: ARRAY[1..22] OF BYTE;
*)
	MBdata					 : ARRAY [1..2] OF INT;
	FtrigBusy				: F_TRIG;
	timeoutvalue				: TIME := T#1000ms;		(* timeout while waiting for an answer of the modbus slave *)
	state					: INT;
	busy					: BOOL;
	LastErrorstate				: INT;
	LastModbusError			: ST_ModbusErrorDiagnostics;
	CounterError				: DINT;
	CounterSuccess			: DINT;
	teplica_DS18B20_id			: BYTE:=16#44;
	teplica_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);
	MBdata8					 : ARRAY [1..8] OF UINT;
(*	teplica_ADM4188_id			: BYTE:=16#45; *)
	teplica_light_sensor_id			: BYTE:=16#3C;
	teplica_light_low				: WORD;
	teplica_light_high				: WORD;
	teplica_light_dword				:DWORD;
	teplica_light_array				: ARRAY [1..2] OF WORD;
	sensors_SHT30_v3_id			:  BYTE:= 16#32 ;
	sensors_SHT30_v3_hum		:  REAL;
	sensors_SHT30_v3_temp		:  REAL;
	sensor_teplica_PH_id		: BYTE:= 16#78 ;
	sensor_teplica_EC_id			: BYTE:= 16#C8 ;
	MBdata_sensor_teplica_EC		 : ARRAY [1..4] OF INT;
	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)
	crctest					: WORD;
	get_energy_E_T1			: FB_GET_ENERGY;
	get_energy_E_T2			: FB_GET_ENERGY;
	get_energy_MT			: FB_GET_ENERGY;
	get_supply				: FB_GET_SUPPLY;
	get_current				: FB_GET_CURRENT;
	get_power				: FB_GET_POWER;
	energyMT					: ARRAY[1..12,1..2] OF REAL;
	get_current_done			: BOOL;
	get_power_done			: BOOL;
	get_energy_E_T1_done	: BOOL;
	get_energy_E_T2_done	: BOOL;
	get_energy_MT_done		: BOOL;

	get_supply_done			: BOOL;
	arrReceive				: ARRAY[1..5] OF BYTE;
	arrSend					: ARRAY[1..5] OF BYTE;
	t,m						: INT:=1;
	MBdata_sensor_ponics_PH : ARRAY [1..4] OF INT;
	Teplica_ph_sensor_temp	: REAL;

END_VAR


(* @END_DECLARATION := '0' *)

Modbus.RS485_3_cnt_error		:= CounterError;
Modbus.RS485_3_cnt_success	:= CounterSuccess;





CASE state OF
0:
	MB3.ReadRegs(Execute:= FALSE);
	state :=888;




15:

		MB3.ReadRegs(
			UnitID:= teplica_DS18B20_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8),
			Execute:= TRUE,
			Timeout:=  T#2000ms,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				IF (MBdata8[1] < 10000)
					THEN	teplica_DS18B20_temp[1]:=UINT_TO_REAL(MBdata8[1])/10;
				ELSE
					teplica_DS18B20_temp[1]:=-1*UINT_TO_REAL(MBdata8[1]-10000)/10;
				END_IF

				IF (MBdata8[2] < 10000)
					THEN	teplica_DS18B20_temp[2]:=UINT_TO_REAL(MBdata8[2])/10;
				ELSE
					teplica_DS18B20_temp[2]:=-1*UINT_TO_REAL(MBdata8[2]-10000)/10;
				END_IF


				IF (MBdata8[3] < 10000)
					THEN	teplica_DS18B20_temp[3]:=UINT_TO_REAL(MBdata8[3])/10;
				ELSE
					teplica_DS18B20_temp[3]:=-1*UINT_TO_REAL(MBdata8[3]-10000)/10;
				END_IF

				IF (MBdata8[4] < 10000)
					THEN	teplica_DS18B20_temp[4]:=UINT_TO_REAL(MBdata8[4])/10;
				ELSE
					teplica_DS18B20_temp[4]:=-1*UINT_TO_REAL(MBdata8[4]-10000)/10;
				END_IF

				IF  (teplica_DS18B20_temp[1] <>0 AND teplica_DS18B20_temp[1] <>85)	THEN
					Modbus.Teplica_temp_air			:=	teplica_DS18B20_temp[1];
				END_IF

				IF  (teplica_DS18B20_temp[2] <>0 AND teplica_DS18B20_temp[2] <>85)	THEN
					Modbus.Teplica_temp_ground		:=	teplica_DS18B20_temp[2];
				END_IF

				IF  (teplica_DS18B20_temp[3] <>0 AND teplica_DS18B20_temp[3] <>85)	THEN
					Modbus.Teplica_temp_pipe_heat 	:=	teplica_DS18B20_temp[3];
				END_IF

				IF  (teplica_DS18B20_temp[4] <>0 AND teplica_DS18B20_temp[4] <>85)	THEN
					Modbus.Teplica_temp_water_tank 	:=	teplica_DS18B20_temp[4];
				END_IF


			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=16;

		END_IF


16:

		MB3.ReadRegs(
			UnitID:= teplica_light_sensor_id,
			Quantity:= 2,
			MBAddr:= 2,
			cbLength:= 4,
			pMemoryAddr:= ADR(teplica_light_array),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				teplica_light_high:=teplica_light_array[1];
				teplica_light_low:=teplica_light_array[2];
				teplica_light_dword:=(teplica_light_array[1]*65535)+teplica_light_array[2];

				Modbus.Teplica_light_lux		:=	DWORD_TO_REAL(teplica_light_dword);


			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=18;

		END_IF





18:
		MB3.ReadRegs(
			UnitID:= sensors_SHT30_v3_id,
			Quantity:= 2,
			MBAddr:= 512,
			cbLength:= 6,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				sensors_SHT30_v3_temp:=INT_TO_REAL(MBdata[1])/10;
				sensors_SHT30_v3_hum:=INT_TO_REAL(MBdata[2])/10;

				Internal.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp;
				Internal.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum;
				Modbus.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp;
				Modbus.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum;
			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state :=19;
		END_IF

19:

		MB3.ReadRegs(
			UnitID:= sensor_teplica_PH_id,
			(*Quantity:= 1,
			MBAddr:= 0,
			cbLength:= 2,
			pMemoryAddr:= ADR(sensor_teplica_PH_int),*)
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_ponics_PH),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN

(*				Modbus.Teplica_sensor_soil_PH		:=	INT_TO_REAL(sensor_teplica_PH_int)/100;	*)
				Modbus.Teplica_sensor_soil_PH	:=	INT_TO_REAL(MBdata_sensor_ponics_PH[1])/100;
				Teplica_ph_sensor_temp			:=	INT_TO_REAL(MBdata_sensor_ponics_PH[3])/10;

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=20;

		END_IF

20:

		MB3.ReadRegs(
			UnitID:= sensor_teplica_EC_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_teplica_EC),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
			Modbus.Teplica_sensor_soil_Hum	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[1])/10;
			Modbus.Teplica_sensor_soil_Temp	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[2])/10;
			Modbus.Teplica_sensor_soil_EC	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[3]);
			Modbus.Teplica_sensor_soil_PH2	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[4])/10;

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=105;

		END_IF



(*	state:=105; *)

105: (*открываем канал*)


	Clear(Buffer := RxBufferCom3);
	arrSend[1]:=Merc_address;
	arrSend[2]:=1; (*код доступа*)
	arrSend[3]:=1; (*Уровень доступа*)

	MEMCPY(ADR(arrSend)+3,ADR(password_1),6); (*пароль*)
	crctest:=F_CRC16(ADR(arrSend),9); (*расчет контрольной суммы*)
	MEMCPY(ADR(arrSend)+9,ADR(crctest),SIZEOF(crctest)); (*прибавление контрольной суммы к запросу*)
	SendDataCom3(pSendData:=ADR(arrSend),Length:=11,TXBuffer:=TxBufferCom3,Busy=>,Error=>);
(*	tmCheck(in:=FALSE); *)
	tmCheckM(in:=FALSE);
	tmCheckM(in:=TRUE, pt:=t#3s); 	(*запуск таймера проверки - потеря связи\обрыв кабеля*)
	state:=106;

106: (*ответ*)
	ReceiveDataCom3(pPrefix:=,LenPrefix:=,pSuffix:=,LenSuffix:=,
	pReceiveData:=ADR(arrReceive),SizeReceiveData:=4,
	Timeout:=t#2s,Reset:=,
	RXbuffer:=RxBufferCom3,
	DataReceived=>,busy=>,Error=>,RxTimeout=>,LenReceiveData=>);
	IF ReceiveDataCom3.Error <> 0 THEN
		state:=888;
	END_IF
	IF receiveDataCom3.DataReceived THEN
		state:=107;
	ELSIF tmCheckM.Q THEN
		state:=888;
	END_IF
107: (*проверка ответа*)

	IF arrReceive[1] = Merc_address THEN
		state:= 108;
	ELSE
		state:=888;
	END_IF



108:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_supply_done := FALSE;
		get_supply( byte1:=16#8, byte2:=16#16, byte3:=16#11,  supply1=>Modbus.UV1,supply2=>Modbus.UV2,supply3=>Modbus.UV3, done=>get_supply_done);
		IF get_supply_done = TRUE THEN
			CounterSuccess := CounterSuccess+1;
			state:=109;
		ELSIF tmcheck.Q THEN
			CounterError := CounterError+1;
			 state:=888;
		END_IF



 (*запрос на чтение тока  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
109:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_current_done := FALSE;
		get_current(byte1:=16#8, byte2:=16#16, byte3:=16#21,  current1=>Modbus.Ia1,current2=>Modbus.Ia2,current3=>Modbus.Ia3, done=>get_current_done);
		IF get_current_done = TRUE THEN
			state:=110;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение мощности  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

110:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_power_done := FALSE;
		get_power(byte1:=16#8, byte2:=16#16, byte3:=16#0,  power_total=>Modbus.pw_total, power1=>Modbus.pw1, power2=>Modbus.pw2,power3=>Modbus.pw3,done=>get_power_done);
		IF get_power_done = TRUE THEN
			state:=111;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение энергии T1
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
111:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T1_done := FALSE;
		get_energy_E_T1(byte1:=5, byte2:=16#0, byte3:=1,  energy=>Modbus.E_T1, done=>get_energy_E_T1_done);
		IF get_energy_E_T1_done = TRUE THEN
			state:=112;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF
 (*запрос на чтение энергии T2
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

112:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T2_done := FALSE;
		get_energy_E_T2(byte1:=5, byte2:=16#0, byte3:=2,  energy=>Modbus.E_T2, done=>get_energy_E_T2_done);
		IF get_energy_E_T2_done = TRUE THEN
			state:=888;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

113:
		Timer_day(IN:=NOT Timer_dayQ , PT:=T#30m , Q=>Timer_dayQ , ET=> );
			IF timer_day.q THEN
				state:=114;
			ELSE
				state:=888;
			END_IF

114:
	(*	tmCheck(in:=FALSE);	*)
		tmCheckE(in:=NOT tmCheckE.q,pt:=t#2s, Q=>tmCheckEQ , ET=>);
		get_energy_MT_done := FALSE;

	(*	IF (tmCheckEQ) THEN *)
			get_energy_MT(byte1:=5, byte2:=INT_TO_BYTE(48+m), byte3:=INT_TO_BYTE(t),   energy=>energyMT[m,t],done=>get_energy_MT_done);
(*		END_IF *)

		IF get_energy_MT_done = TRUE THEN
			t:=t+1;
			IF (t>2 AND m<13) THEN
				t:=1;
				m:=m+1;
				state:=114;
			END_IF

					IF ( m=13) THEN
						t:=1;
						m:=1;
						Modbus.M1T1:=energyMT[1,1];
						Modbus.M1T2:=energyMT[1,2];
						Modbus.M2T1:=energyMT[2,1];
						Modbus.M2T2:=energyMT[2,2];
						Modbus.M3T1:=energyMT[3,1];
						Modbus.M3T2:=energyMT[3,2];
						Modbus.M4T1:=energyMT[4,1];
						Modbus.M4T2:=energyMT[4,2];
						Modbus.M5T1:=energyMT[5,1];
						Modbus.M5T2:=energyMT[5,2];
						Modbus.M6T1:=energyMT[6,1];
						Modbus.M6T2:=energyMT[6,2];
						Modbus.M7T1:=energyMT[7,1];
						Modbus.M7T2:=energyMT[7,2];
						Modbus.M8T1:=energyMT[8,1];
						Modbus.M8T2:=energyMT[8,2];
						Modbus.M9T1:=energyMT[9,1];
						Modbus.M9T2:=energyMT[9,2];
						Modbus.M10T1:=energyMT[10,1];
						Modbus.M10T2:=energyMT[10,2];
						Modbus.M11T1:=energyMT[11,1];
						Modbus.M11T2:=energyMT[11,2];
						Modbus.M12T1:=energyMT[12,1];
						Modbus.M12T2:=energyMT[12,2];
						state:=888;
					END_IF
		ELSIF tmcheckE.Q THEN state:=114;
		END_IF






888:
		TimerRS485_3(IN:=NOT TimerRS485_3Q , PT:=tTimerValue , Q=>TimerRS485_3Q , ET=> );
		IF TimerRS485_3.q THEN
			state:=0;
		END_IF


END_CASE

FtrigBusy(CLK:=mb3.BUSY );
IF FtrigBusy.Q THEN
	IF mb3.Error THEN
		LastModbusError := mb3.ErrorDiagnostics;
		LastErrorstate := state;
		CounterError := CounterError + 1;
	ELSE
		CounterSuccess := CounterSuccess + 1;
	END_IF
END_IF



SerialLinecontrolCom3(
	mode:=SerialLinemode_kl6_22b_standard,
	pComIn:=ADR(RS485read_3.MB3.InData),
	pComOut:=ADR(RS485read_3.MB3.OutData),
	SizeComIn:=SIZEOF(RS485read_3.MB3.OutData),
	TxBuffer:=TxBufferCom3,
	RxBuffer:=RxBufferCom3,
	Error=>,
	errorid=>);


END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)

PROGRAM RS485read_3_old
VAR
(*	Period_vent_switch	: INT:=180; *)

	tTimerValue			: TIME	:=	t#10s; (* Период опроса RS485*)

(*	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)
	crctest					: WORD;
	arrReceive				: ARRAY[1..22] OF BYTE;
	arrSend					: ARRAY[1..22] OF BYTE;
*)
	MBdata					 : ARRAY [1..2] OF INT;
	FtrigBusy				: F_TRIG;
	timeoutvalue				: TIME := T#1000ms;		(* timeout while waiting for an answer of the modbus slave *)
	state					: INT;
	busy					: BOOL;
	LastErrorstate				: INT;
	LastModbusError			: ST_ModbusErrorDiagnostics;
	CounterError				: DINT;
	CounterSuccess			: DINT;
	CounterError_M			: DINT;
	CounterSuccess_M		: DINT;

(*	i,k,l,m,t					: INT:=1; *)





	teplica_DS18B20_id			: BYTE:=16#44;
	teplica_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);
	MBdata8					 : ARRAY [1..8] OF UINT;

(*	Modbus_DO					: INT:=1; *)
	teplica_ADM4188_id			: BYTE:=16#45;
(*	teplica_ADM4188_DI_1			:  INT;
	teplica_ADM4188_DO_1		:  INT;
	teplica_ADM4188_DO_1_ACK	:  INT; *)

	teplica_light_sensor_id			: BYTE:=16#3C;
	teplica_light_low				: WORD;
	teplica_light_high				: WORD;
	teplica_light_dword				:DWORD;
	teplica_light_array				: ARRAY [1..2] OF WORD;


	balkon_light_sensor_id			: BYTE:=16#5A;
	balkon_light_low				: BYTE;
	balkon_light_high				: BYTE;
	balkon_light_word				:WORD;
	balkon_light_array				: ARRAY [1..2] OF BYTE;






	MBdataDI		 			 : ARRAY [1..8] OF UINT;
	MBdataDO_byte					: INT;
	MBdataDO_byte_old				: INT;


(*	teplica_ADM4188_DO_ACK		:  INT;
	teplica_ADM4188_DI_ACK		: INT; *)
(*	teplica_ADM4188_DO_1		:  INT; *)

	zero						: INT:=0;



(*	TRIG_start_reset			:	R_TRIG; *)

	Teplica_DI1_cnt			:	UINT;
	Teplica_DI2_cnt			:	UINT;
	Teplica_DI3_cnt			:	UINT;
	Teplica_DI1_cnt_mem		:	UINT;
	Teplica_DI2_cnt_mem		:	UINT;
	Teplica_DI3_cnt_mem		:	UINT;

	check0					: INT:=0;
	check1					: INT:=0;
	check2					: INT:=0;
	check3					: INT:=0;

	sensors_SHT30_v3_id			:  BYTE:= 16#32 ;
	sensors_SHT30_v3_hum		:  REAL;
	sensors_SHT30_v3_temp		:  REAL;

	sensor_teplica_PH_id			: BYTE:= 16#78 ;
	sensor_teplica_PH_int		:INT;

	sensor_teplica_EC_id			: BYTE:= 16#C8 ;
	MBdata_sensor_teplica_EC		 : ARRAY [1..4] OF INT;

	cnt_clear_di_1			: BOOL;
	cnt_clear_di_2			: BOOL;
	cnt_clear_di_3			: BOOL;
	cnt_overload_1			:INT;
	cnt_overload_2			:INT;
	cnt_overload_3			:INT;

END_VAR


(* @END_DECLARATION := '0' *)

Modbus.RS485_3_cnt_error		:= CounterError;
Modbus.RS485_3_cnt_success	:= CounterSuccess;


MBdataDO_byte.0			:=	Modbus.Teplica_DO1_vent;
MBdataDO_byte.1			:=	Modbus.Teplica_DO2_heat;
MBdataDO_byte.2			:=	Modbus.Teplica_DO3_light;
MBdataDO_byte.3			:=	Modbus.Teplica_DO4_pomp_poliv;
MBdataDO_byte.4			:=	Modbus.Teplica_DO5_pomp_fertA;
MBdataDO_byte.5			:=	Modbus.Teplica_DO6_pomp_fertB;
MBdataDO_byte.6			:=	Modbus.Teplica_DO7;
MBdataDO_byte.7			:=	Modbus.Teplica_DO8;



CASE state OF
0:
MB3.ReadRegs(Execute:= FALSE);

IF (Modbus.Teplica_poliv_status_PLC =1 )   THEN
	state := 1;
	check0:=check0+1;
ELSE
	state :=9;
END_IF




1:
(*Обнуление счётчиков полива и фертигации при старте полива*)

	Modbus.Teplica_poliv_message_PLC	:=	1;
	Modbus.Teplica_poliv_status_PLC 		:=	4;
	check1:=check1+1;
	cnt_clear_di_1	:= FALSE;
	MB3.WriteSingleRegister(
					UnitID:= teplica_ADM4188_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 0,
					cbLength:= 2,
					pMemoryAddr:= ADR(zero),
					Execute:= TRUE,
					Timeout:= T#2000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
					Modbus.Teplica_poliv_message_PLC	:=	2;
					Cnt_Teplica_poliv_message_PLC_M3	:=	0;
					cnt_clear_di_1	:=	TRUE;


			END_IF
			IF (mb3.Error = TRUE ) THEN
					Modbus.Teplica_DI1_poliv				:=	0;
					cnt_clear_di_1	:=	FALSE;
					Cnt_Teplica_poliv_message_PLC_M3	 :=	Cnt_Teplica_poliv_message_PLC_M3+1;
					Cnt_Teplica_poliv_status_PLC_N3		:=	Cnt_Teplica_poliv_status_PLC_N3+1;
					IF (Cnt_Teplica_poliv_message_PLC_M3 >2) THEN
						Modbus.Teplica_poliv_status_PLC		:=	3;
						Modbus.Teplica_poliv_message_PLC	:=	3;
					END_IF

			END_IF


			MB3.ReadRegs(Execute:= FALSE);
			state:=2;
		END_IF

2:
	check2:=check2+1;
	cnt_clear_di_2	:=	FALSE;

	MB3.WriteSingleRegister(
					UnitID:= teplica_ADM4188_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 1,
					cbLength:= 2,
					pMemoryAddr:= ADR(zero),
					Execute:= TRUE,
					Timeout:= T#2000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
					Modbus.Teplica_poliv_message_PLC	:=	4;
					Cnt_Teplica_poliv_message_PLC_M5	 :=	0;
					Modbus.Teplica_DI2_fertA				:=	0;
					cnt_clear_di_2	:=	TRUE;

			END_IF
			IF (mb3.Error = TRUE ) THEN
					Cnt_Teplica_poliv_message_PLC_M5	 :=	Cnt_Teplica_poliv_message_PLC_M5+1;
					cnt_clear_di_2	:=	FALSE;
					IF (Cnt_Teplica_poliv_message_PLC_M5 >2) THEN
						Modbus.Teplica_poliv_status_PLC		:=	3;
						Modbus.Teplica_poliv_message_PLC	:=	5;
					END_IF

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=3;
		END_IF

3:
		check3:=check3+1;
		cnt_clear_di_3	:=	FALSE;
		MB3.WriteSingleRegister(
					UnitID:= teplica_ADM4188_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 2,
					cbLength:= 2,
					pMemoryAddr:= ADR(zero),
					Execute:= TRUE,
					Timeout:= T#2000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
					Modbus.Teplica_poliv_status_PLC	:=	2;
					Modbus.Teplica_poliv_message_PLC	:=	6;
					Cnt_Teplica_poliv_message_PLC_M7	 :=	0;
					Modbus.Teplica_DI3_fertB				:=	0;
					cnt_clear_di_3	:=	TRUE;
					IF (cnt_clear_di_1 = TRUE AND cnt_clear_di_2 = TRUE AND cnt_clear_di_3 = TRUE ) THEN
						Teplica_DI1_cnt_mem		:=0;
						Teplica_DI2_cnt_mem		:=0;
						Teplica_DI3_cnt_mem		:=0;
						cnt_overload_1			:=0;
						cnt_overload_2			:=0;
						cnt_overload_3			:=0;
						Cnt_cleared	:=	TRUE;
					END_IF

			END_IF
			IF (mb3.Error = TRUE ) THEN
					Cnt_Teplica_poliv_message_PLC_M7	 :=	Cnt_Teplica_poliv_message_PLC_M7+1;
					cnt_clear_di_3	:=	FALSE;
					IF (Cnt_Teplica_poliv_message_PLC_M7 >2) THEN
						Modbus.Teplica_poliv_status_PLC		:=	3;
						Modbus.Teplica_poliv_message_PLC	:=	7;
					END_IF

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=9;
		END_IF

(*Запись DO значений*)


(*считывание DI значений *)
9:
	MB3.ReadRegs(
					UnitID:= teplica_ADM4188_id, (* station address *)
					Quantity:= 8,
					MBAddr:= 0,
					cbLength:= 16,
					pMemoryAddr:= ADR(MBdataDI),
					Execute:= TRUE,
					Timeout:= T#2000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
					Modbus.Teplica_poliv_message_PLC	:=	10;
					Teplica_DI1_cnt	:=MBdataDI[1];
					Teplica_DI2_cnt	:=MBdataDI[2];
					Teplica_DI3_cnt	:=MBdataDI[3];

			IF (Cnt_cleared = TRUE) THEN
				IF ( Teplica_DI1_cnt_mem > Teplica_DI1_cnt AND Teplica_DI1_cnt_mem > 50000)  THEN
					cnt_overload_1	:=	cnt_overload_1+1;
					Modbus.Teplica_DI1_poliv	:= Modbus.Teplica_DI1_poliv + (65535-Teplica_DI1_cnt_mem);
				END_IF
				Modbus.Teplica_DI1_poliv	:= cnt_overload_1*65535+Teplica_DI1_cnt;


				IF ( Teplica_DI2_cnt_mem > Teplica_DI2_cnt AND Teplica_DI2_cnt_mem > 50000)   THEN
					cnt_overload_2	:=	cnt_overload_2+1;
					Modbus.Teplica_DI2_fertA	:= Modbus.Teplica_DI2_fertA + (65535-Teplica_DI2_cnt_mem);
				END_IF
				Modbus.Teplica_DI2_fertA	:= cnt_overload_2*65535+Teplica_DI2_cnt;


				IF ( Teplica_DI3_cnt_mem > Teplica_DI3_cnt AND Teplica_DI3_cnt_mem > 50000)  THEN
					cnt_overload_3	:=	cnt_overload_3+1;
					Modbus.Teplica_DI3_fertB	:= Modbus.Teplica_DI3_fertB + (65535-Teplica_DI3_cnt_mem);
				END_IF
				Modbus.Teplica_DI3_fertB	:= cnt_overload_3*65535+Teplica_DI3_cnt;

				Teplica_DI1_cnt_mem		:=Teplica_DI1_cnt;
				Teplica_DI2_cnt_mem		:=Teplica_DI2_cnt;
				Teplica_DI3_cnt_mem		:=Teplica_DI3_cnt;

				IF (Modbus.Teplica_DO5_pomp_fertA =  TRUE OR FertA_init_stop = TRUE) THEN
					Modbus.Cnt_water_fertA	:=	Modbus.Teplica_DI1_poliv -Cnt_water_fertA_start;
				END_IF

				IF (Modbus.Teplica_DO6_pomp_fertB =  TRUE OR FertB_init_stop = TRUE) THEN
					Modbus.Cnt_water_fertB	:=	Modbus.Teplica_DI1_poliv -Cnt_water_fertB_start;
				END_IF

			END_IF

				Cnt_Teplica_poliv_message_PLC_M11	 :=	0;

			END_IF

			IF (mb3.Error = TRUE ) THEN

					Cnt_Teplica_poliv_message_PLC_M11	 :=	Cnt_Teplica_poliv_message_PLC_M11+1;
					IF (Cnt_Teplica_poliv_message_PLC_M11 >2) THEN
						Modbus.Teplica_poliv_message_PLC	:=	11;
						Modbus.Teplica_poliv_status_PLC		:=	3;
					END_IF


			END_IF

			MB3.ReadRegs(Execute:= FALSE);
			state:=10;
		END_IF

10:
	IF (MBdataDO_byte <> MBdataDO_byte_old OR 	Cnt_Teplica_poliv_message_PLC_M9	>	0) THEN
	MB3.WriteMultipleCoils(
			UnitID:= teplica_ADM4188_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdataDO_byte),
			Execute:= TRUE,
			Timeout:= T#2000ms,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
					Modbus.Teplica_poliv_message_PLC	:=	8;
					Cnt_Teplica_poliv_message_PLC_M9	 :=	0;


					IF (MBdataDO_byte.4=0 AND FertA_init_stop = TRUE) THEN
						Modbus.Cnt_water_fertA	:=	Modbus.Teplica_DI1_poliv -Cnt_water_fertA_start;
						Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
						FertA_init_stop	:=	FALSE;
					END_IF

					IF (MBdataDO_byte.5=0 AND  FertB_init_stop = TRUE) THEN
						Modbus.Cnt_water_fertB	:=	Modbus.Teplica_DI1_poliv -Cnt_water_fertB_start;
						Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
						FertB_init_stop	:=	FALSE;
					END_IF

					IF (  Poliv_init_stop = TRUE) THEN
						Modbus.Teplica_poliv_status_PLC :=  10;
						Poliv_init_stop := FALSE;
					END_IF


					MBdataDO_byte_old	:=	MBdataDO_byte;
			END_IF
			IF (mb3.Error = TRUE ) THEN

					Cnt_Teplica_poliv_message_PLC_M9	 :=	Cnt_Teplica_poliv_message_PLC_M9+1;
					IF (Cnt_Teplica_poliv_message_PLC_M9 >2) THEN
						Modbus.Teplica_poliv_message_PLC	:=	9;
						Modbus.Teplica_poliv_status_PLC	:=	3;
					END_IF

			END_IF



			MB3.ReadRegs(Execute:= FALSE);
			state:=15;

		END_IF
	ELSE

			IF (  Poliv_init_stop = TRUE) THEN
						Modbus.Teplica_poliv_status_PLC :=  10;
						Poliv_init_stop := FALSE;
			END_IF
			state:=15;

	END_IF




















15:

		MB3.ReadRegs(
			UnitID:= teplica_DS18B20_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8),
			Execute:= TRUE,
			Timeout:=  T#2000ms,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				IF (MBdata8[1] < 10000)
					THEN	teplica_DS18B20_temp[1]:=UINT_TO_REAL(MBdata8[1])/10;
				ELSE
					teplica_DS18B20_temp[1]:=-1*UINT_TO_REAL(MBdata8[1]-10000)/10;
				END_IF

				IF (MBdata8[2] < 10000)
					THEN	teplica_DS18B20_temp[2]:=UINT_TO_REAL(MBdata8[2])/10;
				ELSE
					teplica_DS18B20_temp[2]:=-1*UINT_TO_REAL(MBdata8[2]-10000)/10;
				END_IF


				IF (MBdata8[3] < 10000)
					THEN	teplica_DS18B20_temp[3]:=UINT_TO_REAL(MBdata8[3])/10;
				ELSE
					teplica_DS18B20_temp[3]:=-1*UINT_TO_REAL(MBdata8[3]-10000)/10;
				END_IF

				IF (MBdata8[4] < 10000)
					THEN	teplica_DS18B20_temp[4]:=UINT_TO_REAL(MBdata8[4])/10;
				ELSE
					teplica_DS18B20_temp[4]:=-1*UINT_TO_REAL(MBdata8[4]-10000)/10;
				END_IF

				Modbus.Teplica_temp_air			:=	teplica_DS18B20_temp[1];
				Modbus.Teplica_temp_ground		:=	teplica_DS18B20_temp[2];
				Modbus.Teplica_temp_pipe_heat 	:=	teplica_DS18B20_temp[3];
				Modbus.Teplica_temp_water_tank 	:=	teplica_DS18B20_temp[4];

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=16;

		END_IF


16:

		MB3.ReadRegs(
			UnitID:= teplica_light_sensor_id,
			Quantity:= 2,
			MBAddr:= 2,
			cbLength:= 4,
			pMemoryAddr:= ADR(teplica_light_array),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				teplica_light_high:=teplica_light_array[1];
				teplica_light_low:=teplica_light_array[2];
				teplica_light_dword:=(teplica_light_array[1]*65535)+teplica_light_array[2];

				Modbus.Teplica_light_lux		:=	DWORD_TO_REAL(teplica_light_dword);


			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=17;

		END_IF



17:

		MB3.ReadRegs(
			UnitID:= balkon_light_sensor_id,
			Quantity:= 1,
			MBAddr:= 6,
			cbLength:= 2,
			pMemoryAddr:= ADR(balkon_light_array),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				balkon_light_high:=balkon_light_array[1];
				balkon_light_low:=balkon_light_array[2];
				balkon_light_word:=(balkon_light_array[2]*256)+balkon_light_array[1];

				Modbus.Balkon_light_lux		:=	WORD_TO_UDINT(balkon_light_word);
			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=18;

		END_IF


18:
		MB3.ReadRegs(
			UnitID:= sensors_SHT30_v3_id,
			Quantity:= 2,
			MBAddr:= 512,
			cbLength:= 6,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				sensors_SHT30_v3_temp:=INT_TO_REAL(MBdata[1])/10;
				sensors_SHT30_v3_hum:=INT_TO_REAL(MBdata[2])/10;

				Internal.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp;
				Internal.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum;
				Modbus.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp;
				Modbus.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum;
			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state :=19;
		END_IF

19:

		MB3.ReadRegs(
			UnitID:= sensor_teplica_PH_id,
			Quantity:= 1,
			MBAddr:= 0,
			cbLength:= 2,
			pMemoryAddr:= ADR(sensor_teplica_PH_int),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN

				Modbus.Teplica_sensor_soil_PH		:=	INT_TO_REAL(sensor_teplica_PH_int)/100;
			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=20;

		END_IF

20:

		MB3.ReadRegs(
			UnitID:= sensor_teplica_EC_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_teplica_EC),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
			Modbus.Teplica_sensor_soil_Hum	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[1])/10;
			Modbus.Teplica_sensor_soil_Temp	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[2])/10;
			Modbus.Teplica_sensor_soil_EC	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[3]);
			Modbus.Teplica_sensor_soil_PH2	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[4])/10;

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=888;

		END_IF


888:
		TimerRS485_3(IN:=NOT TimerRS485_3Q , PT:=tTimerValue , Q=>TimerRS485_3Q , ET=> );
		IF TimerRS485_3.q THEN
			state:=0;
		END_IF


END_CASE

FtrigBusy(CLK:=mb3.BUSY );
IF FtrigBusy.Q THEN
	IF mb3.Error THEN
		LastModbusError := mb3.ErrorDiagnostics;
		LastErrorstate := state;
		CounterError := CounterError + 1;
	ELSE
		CounterSuccess := CounterSuccess + 1;
	END_IF
END_IF



SerialLinecontrolCom3(
	mode:=SerialLinemode_kl6_22b_standard,
	pComIn:=ADR(RS485read_3.MB3.InData),
	pComOut:=ADR(RS485read_3.MB3.OutData),
	SizeComIn:=SIZEOF(RS485read_3.MB3.OutData),
	TxBuffer:=TxBufferCom3,
	RxBuffer:=RxBufferCom3,
	Error=>,
	errorid=>);


END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)

PROGRAM RS485read_3_old2
VAR
(*	Period_vent_switch	: INT:=180; *)

	tTimerValue			: TIME	:=	t#3s; (* Период опроса RS485*)

(*	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)
	crctest					: WORD;
	arrReceive				: ARRAY[1..22] OF BYTE;
	arrSend					: ARRAY[1..22] OF BYTE;
*)
	MBdata					 : ARRAY [1..2] OF INT;
	FtrigBusy				: F_TRIG;
	timeoutvalue				: TIME := T#1000ms;		(* timeout while waiting for an answer of the modbus slave *)
	state					: INT;
	busy					: BOOL;
	LastErrorstate				: INT;
	LastModbusError			: ST_ModbusErrorDiagnostics;
	CounterError				: DINT;
	CounterSuccess			: DINT;
	CounterError_M			: DINT;
	CounterSuccess_M		: DINT;

(*	i,k,l,m,t					: INT:=1; *)


	PWM_YC110_id			: BYTE:= 16#20 ; (*32 *)
	PWM_levels				 : ARRAY [1..4] OF INT;	(* reg dec 32*)
	PWM_levels_mem		 : ARRAY [1..4] OF INT;
	PWM_freq				 : ARRAY [1..4] OF INT; (* reg dec 64*)
	PWM_freq_mem			 : ARRAY [1..4] OF INT;
	PWM_cycle				 : ARRAY [1..4] OF INT;

	PWM_param_polar		:  INT;	(* reg dec 18*)
	PWM_param_polar_1		:  INT:=1;
	PWM_param_prz			: INT;	(* reg dec 30*)
	PWM_param_prz_1		: INT:=1;	(* reg dec 30*)

	PWM_cycle_1			:  UINT:=65535;
	PWM_cycle_2			:  UINT:=65535;
	PWM_cycle_3			:  UINT:=65535;
	PWM_cycle_4			:  UINT:=65535;

	teplica_DS18B20_id			: BYTE:=16#44;
	teplica_DS18B20_temp		: ARRAY[1..8] OF REAL:=8(0);
	MBdata8					 : ARRAY [1..8] OF UINT;

(*	Modbus_DO					: INT:=1; *)
	teplica_ADM4188_id			: BYTE:=16#45;
(*	teplica_ADM4188_DI_1			:  INT;
	teplica_ADM4188_DO_1		:  INT;
	teplica_ADM4188_DO_1_ACK	:  INT; *)

	teplica_light_sensor_id			: BYTE:=16#3C;
	teplica_light_low				: WORD;
	teplica_light_high				: WORD;
	teplica_light_dword				:DWORD;
	teplica_light_array				: ARRAY [1..2] OF WORD;








	MBdataDI		 			 : ARRAY [1..8] OF UINT;
	MBdataDO_byte					: INT;
	MBdataDO_byte_old				: INT;


(*	teplica_ADM4188_DO_ACK		:  INT;
	teplica_ADM4188_DI_ACK		: INT; *)
(*	teplica_ADM4188_DO_1		:  INT; *)

	zero						: INT:=0;



(*	TRIG_start_reset			:	R_TRIG; *)

	Teplica_DI1_cnt			:	UINT;
	Teplica_DI2_cnt			:	UINT;
	Teplica_DI3_cnt			:	UINT;
	Teplica_DI1_cnt_mem		:	UINT;
	Teplica_DI2_cnt_mem		:	UINT;
	Teplica_DI3_cnt_mem		:	UINT;

	check0					: INT:=0;
	check1					: INT:=0;
	check2					: INT:=0;
	check3					: INT:=0;

	sensors_SHT30_v3_id			:  BYTE:= 16#32 ;
	sensors_SHT30_v3_hum		:  REAL;
	sensors_SHT30_v3_temp		:  REAL;

	sensor_teplica_PH_id		: BYTE:= 16#78 ;
	sensor_teplica_PH_int		:INT;


	sensor_teplica_EC_id			: BYTE:= 16#C8 ;
	MBdata_sensor_teplica_EC		 : ARRAY [1..4] OF INT;

	cnt_clear_di_1			: BOOL;
	cnt_clear_di_2			: BOOL;
	cnt_clear_di_3			: BOOL;
	cnt_overload_1			:INT;
	cnt_overload_2			:INT;
	cnt_overload_3			:INT;
	password_1				: ARRAY [1..6] OF BYTE:=6(1); (* пароль к меркуриям, по умолчанию 6 единиц*)
	crctest					: WORD;
	get_energy_E_T1			: FB_GET_ENERGY;
	get_energy_E_T2			: FB_GET_ENERGY;
	get_energy_MT			: FB_GET_ENERGY;
	get_supply				: FB_GET_SUPPLY;
	get_current				: FB_GET_CURRENT;
	get_power				: FB_GET_POWER;
	energyMT					: ARRAY[1..12,1..2] OF REAL;

	get_current_done			: BOOL;
	get_power_done			: BOOL;

	get_energy_E_T1_done	: BOOL;
	get_energy_E_T2_done	: BOOL;
	get_energy_MT_done		: BOOL;

	get_supply_done			: BOOL;
	arrReceive				: ARRAY[1..5] OF BYTE;
	arrSend					: ARRAY[1..5] OF BYTE;
	i,k,l,m,t					: INT:=1;
	MBdata_sensor_ponics_PH : ARRAY [1..4] OF INT;
	Teplica_ph_sensor_temp	: REAL;

END_VAR


(* @END_DECLARATION := '0' *)

Modbus.RS485_3_cnt_error		:= CounterError;
Modbus.RS485_3_cnt_success	:= CounterSuccess;





CASE state OF
0:
	MB3.ReadRegs(Execute:= FALSE);
	state :=2;


2:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 32,
					cbLength:= 2,
					pMemoryAddr:= ADR(fert_pwm_levelA),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=3;
		END_IF

3:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 33,
					cbLength:= 2,
					pMemoryAddr:= ADR(fert_pwm_levelB),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=5;
		END_IF






4:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 30,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_param_prz_1) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=5;
		END_IF


5:
	MB3.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 30,
					cbLength:= 2,
					pMemoryAddr:= ADR(PWM_param_prz),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=10;
		END_IF



(*
6:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 96,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_1) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=7;
		END_IF


7:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 97,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_2) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=8;
		END_IF


8:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 98,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_3) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=9;
		END_IF

9:
	MB3.WriteSingleRegister(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 99,
					cbLength:= 2,
					pMemoryAddr:=ADR(PWM_cycle_4) ,
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=10;
		END_IF



*)


10:
	MB3.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 1,
					MBAddr:= 18,
					cbLength:= 2,
					pMemoryAddr:= ADR(PWM_param_polar),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=11;
		END_IF

11:
	MB3.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 4,
					MBAddr:= 96,
					cbLength:= 8,
					pMemoryAddr:= ADR(PWM_cycle),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
		(*	IF (mb3.Error = FALSE ) THEN

			END_IF
		*)
			MB3.ReadRegs(Execute:= FALSE);
			state:=13;
		END_IF



13:
	MB3.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 4,
					MBAddr:= 32,
					cbLength:= 8,
					pMemoryAddr:= ADR(PWM_levels),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				PWM_levels_mem[1]	:=	PWM_levels[1];
				PWM_levels_mem[2]	:=	PWM_levels[2];
				PWM_levels_mem[3]	:=	PWM_levels[3];
				PWM_levels_mem[4]	:=	PWM_levels[4];

			END_IF

			MB3.ReadRegs(Execute:= FALSE);
			state:=14;
		END_IF

14:
	MB3.ReadRegs(
					UnitID:= PWM_YC110_id, (* station address *)
					Quantity:= 4,
					MBAddr:= 64,
					cbLength:= 8,
					pMemoryAddr:= ADR(PWM_freq),
					Execute:= TRUE,
					Timeout:= T#1000ms,
					Busy => busy,
					);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				PWM_freq_mem[1]	:=	PWM_freq[1];
				PWM_freq_mem[2]	:=	PWM_freq[2];
				PWM_freq_mem[3]	:=	PWM_freq[3];
				PWM_freq_mem[4]	:=	PWM_freq[4];

			END_IF

			MB3.ReadRegs(Execute:= FALSE);
			state:=15;
		END_IF


15:

		MB3.ReadRegs(
			UnitID:= teplica_DS18B20_id,
			Quantity:= 8,
			MBAddr:= 0,
			cbLength:= 16,
			pMemoryAddr:= ADR(MBdata8),
			Execute:= TRUE,
			Timeout:=  T#2000ms,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				IF (MBdata8[1] < 10000)
					THEN	teplica_DS18B20_temp[1]:=UINT_TO_REAL(MBdata8[1])/10;
				ELSE
					teplica_DS18B20_temp[1]:=-1*UINT_TO_REAL(MBdata8[1]-10000)/10;
				END_IF

				IF (MBdata8[2] < 10000)
					THEN	teplica_DS18B20_temp[2]:=UINT_TO_REAL(MBdata8[2])/10;
				ELSE
					teplica_DS18B20_temp[2]:=-1*UINT_TO_REAL(MBdata8[2]-10000)/10;
				END_IF


				IF (MBdata8[3] < 10000)
					THEN	teplica_DS18B20_temp[3]:=UINT_TO_REAL(MBdata8[3])/10;
				ELSE
					teplica_DS18B20_temp[3]:=-1*UINT_TO_REAL(MBdata8[3]-10000)/10;
				END_IF

				IF (MBdata8[4] < 10000)
					THEN	teplica_DS18B20_temp[4]:=UINT_TO_REAL(MBdata8[4])/10;
				ELSE
					teplica_DS18B20_temp[4]:=-1*UINT_TO_REAL(MBdata8[4]-10000)/10;
				END_IF

				IF  (teplica_DS18B20_temp[1] <>0 AND teplica_DS18B20_temp[1] <>85)	THEN
					Modbus.Teplica_temp_air			:=	teplica_DS18B20_temp[1];
				END_IF

				IF  (teplica_DS18B20_temp[2] <>0 AND teplica_DS18B20_temp[2] <>85)	THEN
					Modbus.Teplica_temp_ground		:=	teplica_DS18B20_temp[2];
				END_IF

				IF  (teplica_DS18B20_temp[3] <>0 AND teplica_DS18B20_temp[3] <>85)	THEN
					Modbus.Teplica_temp_pipe_heat 	:=	teplica_DS18B20_temp[3];
				END_IF

				IF  (teplica_DS18B20_temp[4] <>0 AND teplica_DS18B20_temp[4] <>85)	THEN
					Modbus.Teplica_temp_water_tank 	:=	teplica_DS18B20_temp[4];
				END_IF


			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=16;

		END_IF


16:

		MB3.ReadRegs(
			UnitID:= teplica_light_sensor_id,
			Quantity:= 2,
			MBAddr:= 2,
			cbLength:= 4,
			pMemoryAddr:= ADR(teplica_light_array),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				teplica_light_high:=teplica_light_array[1];
				teplica_light_low:=teplica_light_array[2];
				teplica_light_dword:=(teplica_light_array[1]*65535)+teplica_light_array[2];

				Modbus.Teplica_light_lux		:=	DWORD_TO_REAL(teplica_light_dword);


			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=18;

		END_IF





18:
		MB3.ReadRegs(
			UnitID:= sensors_SHT30_v3_id,
			Quantity:= 2,
			MBAddr:= 512,
			cbLength:= 6,
			pMemoryAddr:= ADR(MBdata),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
				sensors_SHT30_v3_temp:=INT_TO_REAL(MBdata[1])/10;
				sensors_SHT30_v3_hum:=INT_TO_REAL(MBdata[2])/10;

				Internal.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp;
				Internal.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum;
				Modbus.Teplica_temp_SHT30		:=	sensors_SHT30_v3_temp;
				Modbus.Teplica_hum_SHT30		:=	sensors_SHT30_v3_hum;
			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state :=19;
		END_IF

19:

		MB3.ReadRegs(
			UnitID:= sensor_teplica_PH_id,
			(*Quantity:= 1,
			MBAddr:= 0,
			cbLength:= 2,
			pMemoryAddr:= ADR(sensor_teplica_PH_int),*)
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_ponics_PH),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN

(*				Modbus.Teplica_sensor_soil_PH		:=	INT_TO_REAL(sensor_teplica_PH_int)/100;	*)
				Modbus.Teplica_sensor_soil_PH	:=	INT_TO_REAL(MBdata_sensor_ponics_PH[1])/100;
				Teplica_ph_sensor_temp			:=	INT_TO_REAL(MBdata_sensor_ponics_PH[3])/10;

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=20;

		END_IF

20:

		MB3.ReadRegs(
			UnitID:= sensor_teplica_EC_id,
			Quantity:= 4,
			MBAddr:= 0,
			cbLength:= 8,
			pMemoryAddr:= ADR(MBdata_sensor_teplica_EC),
			Execute:= TRUE,
			Timeout:= timeoutvalue,
			Busy => busy,
		);
		IF NOT busy THEN
			IF (mb3.Error = FALSE ) THEN
			Modbus.Teplica_sensor_soil_Hum	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[1])/10;
			Modbus.Teplica_sensor_soil_Temp	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[2])/10;
			Modbus.Teplica_sensor_soil_EC	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[3]);
			Modbus.Teplica_sensor_soil_PH2	:=	INT_TO_REAL(MBdata_sensor_teplica_EC[4])/10;

			END_IF
			MB3.ReadRegs(Execute:= FALSE);
			state:=105;

		END_IF



(*	state:=105; *)

105: (*открываем канал*)


	Clear(Buffer := RxBufferCom3);
	arrSend[1]:=Merc_address;
	arrSend[2]:=1; (*код доступа*)
	arrSend[3]:=1; (*Уровень доступа*)

	MEMCPY(ADR(arrSend)+3,ADR(password_1),6); (*пароль*)
	crctest:=F_CRC16(ADR(arrSend),9); (*расчет контрольной суммы*)
	MEMCPY(ADR(arrSend)+9,ADR(crctest),SIZEOF(crctest)); (*прибавление контрольной суммы к запросу*)
	SendDataCom3(pSendData:=ADR(arrSend),Length:=11,TXBuffer:=TxBufferCom3,Busy=>,Error=>);
(*	tmCheck(in:=FALSE); *)
	tmCheckM(in:=FALSE);
	tmCheckM(in:=TRUE, pt:=t#3s); 	(*запуск таймера проверки - потеря связи\обрыв кабеля*)
	state:=106;

106: (*ответ*)
	ReceiveDataCom3(pPrefix:=,LenPrefix:=,pSuffix:=,LenSuffix:=,
	pReceiveData:=ADR(arrReceive),SizeReceiveData:=4,
	Timeout:=t#2s,Reset:=,
	RXbuffer:=RxBufferCom3,
	DataReceived=>,busy=>,Error=>,RxTimeout=>,LenReceiveData=>);
	IF ReceiveDataCom3.Error <> 0 THEN
		state:=888;
	END_IF
	IF receiveDataCom3.DataReceived THEN
		state:=107;
	ELSIF tmCheckM.Q THEN
		state:=888;
	END_IF
107: (*проверка ответа*)

	IF arrReceive[1] = Merc_address THEN
		state:= 108;
	ELSE
		state:=888;
	END_IF



108:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_supply_done := FALSE;
		get_supply( byte1:=16#8, byte2:=16#16, byte3:=16#11,  supply1=>Modbus.UV1,supply2=>Modbus.UV2,supply3=>Modbus.UV3, done=>get_supply_done);
		IF get_supply_done = TRUE THEN
			CounterSuccess := CounterSuccess+1;
			state:=109;
		ELSIF tmcheck.Q THEN
			CounterError := CounterError+1;
			 state:=888;
		END_IF



 (*запрос на чтение тока  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
109:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_current_done := FALSE;
		get_current(byte1:=16#8, byte2:=16#16, byte3:=16#21,  current1=>Modbus.Ia1,current2=>Modbus.Ia2,current3=>Modbus.Ia3, done=>get_current_done);
		IF get_current_done = TRUE THEN
			state:=110;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение мощности  на всех фазах
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

110:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_power_done := FALSE;
		get_power(byte1:=16#8, byte2:=16#16, byte3:=16#0,  power_total=>Modbus.pw_total, power1=>Modbus.pw1, power2=>Modbus.pw2,power3=>Modbus.pw3,done=>get_power_done);
		IF get_power_done = TRUE THEN
			state:=111;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

 (*запрос на чтение энергии T1
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)
111:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T1_done := FALSE;
		get_energy_E_T1(byte1:=5, byte2:=16#0, byte3:=1,  energy=>Modbus.E_T1, done=>get_energy_E_T1_done);
		IF get_energy_E_T1_done = TRUE THEN
			state:=112;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF
 (*запрос на чтение энергии T2
--------------------------------------------------------------------------------------------------------------------------------------------------------------------
*)

112:
	(*	tmCheck(in:=FALSE);	*)
		tmCheck(in:=NOT tmCheck.q,pt:=t#2s);
		get_energy_E_T2_done := FALSE;
		get_energy_E_T2(byte1:=5, byte2:=16#0, byte3:=2,  energy=>Modbus.E_T2, done=>get_energy_E_T2_done);
		IF get_energy_E_T2_done = TRUE THEN
			state:=888;
		ELSIF tmcheck.Q THEN state:=888;
		END_IF

113:
		Timer_day(IN:=NOT Timer_dayQ , PT:=T#30m , Q=>Timer_dayQ , ET=> );
			IF timer_day.q THEN
				state:=114;
			ELSE
				state:=888;
			END_IF

114:
	(*	tmCheck(in:=FALSE);	*)
		tmCheckE(in:=NOT tmCheckE.q,pt:=t#2s, Q=>tmCheckEQ , ET=>);
		get_energy_MT_done := FALSE;

	(*	IF (tmCheckEQ) THEN *)
			get_energy_MT(byte1:=5, byte2:=INT_TO_BYTE(48+m), byte3:=INT_TO_BYTE(t),   energy=>energyMT[m,t],done=>get_energy_MT_done);
(*		END_IF *)

		IF get_energy_MT_done = TRUE THEN
			t:=t+1;
			IF (t>2 AND m<13) THEN
				t:=1;
				m:=m+1;
				state:=114;
			END_IF

					IF ( m=13) THEN
						t:=1;
						m:=1;
						Modbus.M1T1:=energyMT[1,1];
						Modbus.M1T2:=energyMT[1,2];
						Modbus.M2T1:=energyMT[2,1];
						Modbus.M2T2:=energyMT[2,2];
						Modbus.M3T1:=energyMT[3,1];
						Modbus.M3T2:=energyMT[3,2];
						Modbus.M4T1:=energyMT[4,1];
						Modbus.M4T2:=energyMT[4,2];
						Modbus.M5T1:=energyMT[5,1];
						Modbus.M5T2:=energyMT[5,2];
						Modbus.M6T1:=energyMT[6,1];
						Modbus.M6T2:=energyMT[6,2];
						Modbus.M7T1:=energyMT[7,1];
						Modbus.M7T2:=energyMT[7,2];
						Modbus.M8T1:=energyMT[8,1];
						Modbus.M8T2:=energyMT[8,2];
						Modbus.M9T1:=energyMT[9,1];
						Modbus.M9T2:=energyMT[9,2];
						Modbus.M10T1:=energyMT[10,1];
						Modbus.M10T2:=energyMT[10,2];
						Modbus.M11T1:=energyMT[11,1];
						Modbus.M11T2:=energyMT[11,2];
						Modbus.M12T1:=energyMT[12,1];
						Modbus.M12T2:=energyMT[12,2];
						state:=888;
					END_IF
		ELSIF tmcheckE.Q THEN state:=114;
		END_IF






888:
		TimerRS485_3(IN:=NOT TimerRS485_3Q , PT:=tTimerValue , Q=>TimerRS485_3Q , ET=> );
		IF TimerRS485_3.q THEN
			state:=0;
		END_IF


END_CASE

FtrigBusy(CLK:=mb3.BUSY );
IF FtrigBusy.Q THEN
	IF mb3.Error THEN
		LastModbusError := mb3.ErrorDiagnostics;
		LastErrorstate := state;
		CounterError := CounterError + 1;
	ELSE
		CounterSuccess := CounterSuccess + 1;
	END_IF
END_IF



SerialLinecontrolCom3(
	mode:=SerialLinemode_kl6_22b_standard,
	pComIn:=ADR(RS485read_3.MB3.InData),
	pComOut:=ADR(RS485read_3.MB3.OutData),
	SizeComIn:=SIZEOF(RS485read_3.MB3.OutData),
	TxBuffer:=TxBufferCom3,
	RxBuffer:=RxBufferCom3,
	Error=>,
	errorid=>);


END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Security
VAR
	TRIG_PIR_terrasa			:	F_TRIG;
	TRIG_PIR_zapad			:	F_TRIG;
	TRIG_PIR_vostok			:	F_TRIG;
	TRIG_PIR_sport			:	F_TRIG;
	TRIG_GERKON_drovnik	:	F_TRIG;
	TRIG_sensor_smoke_1floor:	F_TRIG;

	trig_mem_terrasa				:	BOOL:=FALSE;
	trig_mem_zapad				:	BOOL:=FALSE;
	trig_mem_vostok				:	BOOL:=FALSE;
	trig_mem_sport				:	BOOL:=FALSE;
	trig_mem_drovnik				:	BOOL:=FALSE;
	trig_mem_sensor_smoke_1floor	:	BOOL:=FALSE;

END_VAR
(* @END_DECLARATION := '0' *)
(*  Используем триггеры для исключения ложной информации о сработке датчиков при перезагрузке ПЛК *)


TRIG_PIR_terrasa(CLK :=HW_PIR_terrasa);
TRIG_PIR_zapad(CLK :=HW_PIR_zapad);
TRIG_PIR_vostok(CLK :=HW_PIR_vostok);
TRIG_PIR_sport(CLK :=HW_PIR_sport);
TRIG_GERKON_drovnik(CLK :=HW_GERKON_drovnik);
TRIG_sensor_smoke_1floor(CLK :=HW_sensor_smoke_1floor);


IF (NOT TRIG_PIR_terrasa.Q) THEN
	iobroker.PIR_terrasa:=NOT TRIG_PIR_terrasa.Q;
END_IF
IF (trig_mem_terrasa=TRUE) THEN
	iobroker.PIR_terrasa:=FALSE;
	trig_mem_terrasa:=FALSE;
END_IF
IF (TRIG_PIR_terrasa.Q) THEN
	trig_mem_terrasa:=TRUE;
END_IF



IF (NOT TRIG_PIR_zapad.Q) THEN
	iobroker.PIR_zapad:=NOT TRIG_PIR_zapad.Q;
END_IF
IF (trig_mem_zapad=TRUE) THEN
	iobroker.PIR_zapad:=FALSE;
	trig_mem_zapad:=FALSE;
END_IF
IF (TRIG_PIR_zapad.Q) THEN
	trig_mem_zapad:=TRUE;
END_IF


IF (NOT TRIG_PIR_vostok.Q) THEN
	iobroker.PIR_vostok:=NOT TRIG_PIR_vostok.Q;
END_IF
IF (trig_mem_vostok=TRUE) THEN
	iobroker.PIR_vostok:=FALSE;
	trig_mem_vostok:=FALSE;
END_IF
IF (TRIG_PIR_vostok.Q) THEN
	trig_mem_vostok:=TRUE;
END_IF


IF (NOT TRIG_PIR_sport.Q) THEN
	iobroker.PIR_sport:=NOT TRIG_PIR_sport.Q;
END_IF
IF (trig_mem_sport=TRUE) THEN
	iobroker.PIR_sport:=FALSE;
	trig_mem_sport:=FALSE;
END_IF
IF (TRIG_PIR_sport.Q) THEN
	trig_mem_sport:=TRUE;
END_IF

IF (NOT TRIG_GERKON_drovnik.Q) THEN
	iobroker.GERKON_drovnik:=NOT TRIG_GERKON_drovnik.Q;
END_IF
IF (trig_mem_drovnik=TRUE) THEN
	iobroker.GERKON_drovnik:=FALSE;
	trig_mem_drovnik:=FALSE;
END_IF
IF (TRIG_GERKON_drovnik.Q) THEN
	trig_mem_drovnik:=TRUE;
END_IF


IF (NOT TRIG_sensor_smoke_1floor.Q) THEN
	iobroker.SMOKE:=NOT TRIG_sensor_smoke_1floor.Q;
END_IF
IF (trig_mem_sensor_smoke_1floor=TRUE) THEN
	iobroker.SMOKE:=FALSE;
	trig_mem_sensor_smoke_1floor:=FALSE;
END_IF
IF (TRIG_sensor_smoke_1floor.Q) THEN
	trig_mem_sensor_smoke_1floor:=TRUE;
END_IF

END_PROGRAM


