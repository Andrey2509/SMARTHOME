(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Sensors
VAR
(*	Period_sensors_read		: INT:=30; *) (* Частота присвоения значений аналоговых температурных датчиков с модулей KL, секунды *)
	Timer					: TON;
	TimerQ					: BOOL;
	tTimerValue				: TIME:=t#30s; (* Частота присвоения значений аналоговых температурных датчиков с модулей KL, секунды *)
	Trigger_water_cold: F_TRIG;
	Water_count_house		: REAL;
	Water_count_teplica		: REAL;
END_VAR
(* @END_DECLARATION := '0' *)
Timer();
Trigger_water_cnt_impulse_teplica(CLK:=HW_I_rez5);

Trigger_water_cold(CLK :=HW_water_counter);
IF (Trigger_water_cold.Q) THEN

	(*Modbus.Kitchen_stat_cold_water:=Modbus.Kitchen_stat_cold_water+1; *)
	Water_count_house	:=	Water_count_house+1;
	Modbus.Sensor_house_water_imp	:=	Modbus.Sensor_house_water_imp+1;
END_IF

IF Trigger_water_cnt_impulse_teplica.Q THEN
	Water_count_teplica	:=	Water_count_teplica+1;
	Modbus.Teplica_cnt_water_pipe	:= 	Modbus.Teplica_cnt_water_pipe+1;
END_IF




(* tTimerValue := DINT_TO_TIME(Period_sensors_read*1000); *)

	Timer(IN:=NOT TimerQ , PT:=tTimerValue , Q=>TimerQ , ET=> );
	IF timer.q THEN

		Modbus.First_floor_temp		:=	INT_TO_REAL(HW_temp_first_floor)/10;
(*		Modbus.First_floor_temp		:=	Internal.First_floor_temp_SHT30; *)

		Modbus.Second_floor_temp	:=	INT_TO_REAL(HW_temp_second_floor)/10;
		Modbus.Sauna_temp			:=	INT_TO_REAL(HW_temp_sauna)/10;
		Modbus.Sport_temp			:=	INT_TO_REAL(HW_temp_sport)/10;

		Modbus.Underfloor_temp		:=	INT_TO_REAL(HW_temp_underfloor)/10;
(*		Modbus.Sport_underfloor_temp	:=	INT_TO_REAL(HW_temp_sport_underfloor)/10;	*)
		Modbus.Street_temp			:=	INT_TO_REAL(HW_temp_street)/10;
		Modbus.Vent_temp			:=	INT_TO_REAL(HW_temp_vent)/10;

		Modbus.Balkon_temp			:=	INT_TO_REAL(HW_temp_balkon)/10;
(*		Modbus.Drovnik_temp			:=	INT_TO_REAL(HW_temp_drovnik)/10;
		Modbus.Sklad_temp			:= 	INT_TO_REAL(HW_temp_sklad)/10;	*)

	END_IF
END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK SM_BUTT            (* ФУНКЦИОНАЛЬНЫЙ БЛОК ДЛЯ ПРОСТОЙ КНОПКИ *)
    VAR_INPUT
       	IN: BOOL;          	(*ВХОД ЗА КОТОРЫМ МЫ СЛЕДИМ *)
	IN1:BOOL;				(*ВЫХОД ЗА КОТОРЫМ ТОЖЕ СЛЕДИМ*)
    END_VAR

    VAR_OUTPUT
	Q : BOOL;        			(*СОСТОЯНИЕ ВЫХОДА*)
    END_VAR
    VAR
  MEM : BOOL;    			(* ВНУТРЕННЯЯ ПЕРЕМЕННАЯ ДЛЯ ХРАНЕНИЯ СОСТОЯНИЯ КНОПКИ *)
    END_VAR
(* @END_DECLARATION := '0' *)
Q:=IN1;

IF IN AND NOT MEM THEN 	(* ПОЙМАЛИ ПЕРЕДНИЙ ФРОНТ - НАЖАЛИ НА КНОПКУ *)
	Q := NOT IN1;    			(* МЕНЯЕМ СОСТОЯНИЕ ВЫХОДА НА ПРОТИВОПОЛОЖНОЕ *)
END_IF

MEM := IN;                       		(* ЗАПОМИНАЕМ ТЕКУЩЕЕ ЗНАЧЕНИЕ КНОПКИ *)
END_FUNCTION_BLOCK


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Teplica
VAR
	Timer_poliv_all			: TON;
	Timer_poliv_allQ			: BOOL;

	Timer_1_clear			: TON;
	Timer_2_fertA				: TON;
	Timer_3_clear			: TON;
	Timer_4_fertB				: TON;
	Timer_poliv_with_fert		: TON;

	Timer_1_clearQ			: BOOL;
	Timer_2_fertAQ			: BOOL;
	Timer_3_clearQ			: BOOL;
	Timer_4_fertBQ			: BOOL;
	Step_1_clear				: BOOL;

	 tTimerValue_poliv_all		: TIME:=t#60s;  (* Максимальное время полива*)
	 tTimerValue_1_clear		: TIME:=t#10s;  (* Промывка перед 1 фертигацией*)
	 tTimerValue_2_fertA		: TIME:=t#30s;  (* Ограничение фертигации из бака А*)
	 tTimerValue_3_clear		: TIME:=t#60s;  (* Промывка перед OFF*)
	 tTimerValue_4_fertB		: TIME:=t#10s;  (* Ограничение фертигации из бака Б*)
	 tTimerValue_poliv_with_fert	: TIME:=t#90m;  (* Ограничение полива с фертигацией *)

	Timer_valve				: TON;
	Timer_valveQ			: BOOL;
	 tTimerValue_valve_water	: TIME:=t#60m;  (* Максимальное время открытия клапана подачи воды в теплицу*)

	TRIG_start_poliv			:	R_TRIG;
	TRIG_valve_tank_F		:	F_TRIG;
	TRIG_valve_tank_R		:	R_TRIG;


(*	TRIG_end_poliv_timer		:	R_TRIG; *)
(*	TRIG_end_poliv_count		:	R_TRIG; *)

	Bool_poliv_before_fert		: 	BOOL;

	TRIG_poliv_break			:	R_TRIG;

(*	TRIG_end_1_clear_timer	:	R_TRIG; *)
(*	TRIG_end_1_clear_cnt		:	R_TRIG; *)
(*	TRIG_end_2_fertA_timer	:	R_TRIG; *)
(*	TRIG_end_2_fertA_cnt		:	R_TRIG; *)
(*	TRIG_end_3_clear_timer	:	R_TRIG; *)
(*	TRIG_end_3_clear_cnt		:	R_TRIG; *)
(*	TRIG_end_4_fertB_timer	:	R_TRIG; *)
(*	TRIG_end_4_fertB_cnt		:	R_TRIG; *)

(*	BOOL_cnt_poliv			:	BOOL;
	BOOL_cnt_fertA			:	BOOL;
	BOOL_cnt_fertB			:	BOOL; *)

	Poliv_liters				:	REAL;
	FertA_liters				:	REAL;
	FertB_liters				:	REAL;
(*
	Cnt_water_fertA_start		:	UDINT;
	Cnt_water_fertB_start		:	UDINT;
*)
(*
	t_Started_poliv			:	TIME;
	t_Started_fertA			:	TIME;
	t_Started_fertB			:	TIME;
*)
	gisterezis_lux				:	INT:=1000;
	Poliv_before_fert			:	INT:=0;
	Timer_poliv_with_fertQ		: 	BOOL;
	Trigger_water_impulse_teplica	: F_TRIG;
	Trigger_water_impulse2_teplica	: R_TRIG;

	Trigger_fertA_impulse_teplica	: F_TRIG;
	Trigger_fertB_impulse_teplica	: F_TRIG;

	Impulse_water_teplica		:	UDINT:=0;
	Impulse2_water_teplica	:	UDINT:=0;
	Impulse_fertA_teplica		:	UDINT:=0;
	Impulse_fertB_teplica		:	UDINT:=0;

END_VAR
(* @END_DECLARATION := '0' *)
Trigger_water_impulse_teplica(CLK:=HW_impulse_water_teplica);
Trigger_water_impulse2_teplica(CLK:=HW_impulse_water_teplica);

Trigger_fertA_impulse_teplica(CLK:=HW_impulse_fertA_teplica);
Trigger_fertB_impulse_teplica(CLK:=HW_impulse_fertB_teplica);

IF Trigger_water_impulse_teplica.Q THEN
	Impulse_water_teplica	:= 	Impulse_water_teplica+1;
END_IF
IF Trigger_water_impulse2_teplica.Q THEN
	Impulse2_water_teplica	:= 	Impulse2_water_teplica+1;
END_IF


IF Trigger_fertA_impulse_teplica.Q THEN
	Impulse_fertA_teplica	:= 	Impulse_fertA_teplica+1;
END_IF
IF Trigger_fertB_impulse_teplica.Q THEN
	Impulse_fertB_teplica	:= 	Impulse_fertB_teplica+1;
END_IF



tTimerValue_poliv_all	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_poliv_time);
tTimerValue_1_clear	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_clear_time);
tTimerValue_2_fertA	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_fertA_time);
tTimerValue_3_clear	:=	t#60s;
tTimerValue_4_fertB	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_fertB_time);



Timer_poliv_all();
Timer_poliv_with_fert();
Timer_1_clear();
Timer_2_fertA();
Timer_3_clear();
Timer_4_fertB();
Timer_valve();


TRIG_start_poliv(CLK :=Modbus.Teplica_poliv_active);
TRIG_poliv_break(CLK :=Modbus.Teplica_poliv_break);

TRIG_valve_tank_F(CLK:=HW_water_tank_teplica_level);
TRIG_valve_tank_R(CLK:=HW_water_tank_teplica_level);

Modbus.Teplica_tank_teplica_level	:=	HW_water_tank_teplica_level;

IF (TRIG_valve_tank_F.Q) THEN
	Timer_valve(IN:=NOT Timer_valveQ , PT:=tTimerValue_valve_water , Q=>Timer_valveQ , ET=> );
	HW_valve_pomp_teplica :=	TRUE;
END_IF

IF (TRIG_valve_tank_R.Q	OR Timer_valveQ = TRUE) THEN
	HW_valve_pomp_teplica :=	FALSE;
	Timer_valveQ	:= FALSE;
	Timer_valve.IN	:= FALSE;
END_IF



IF (TRIG_start_poliv.Q AND  Modbus.Teplica_poliv_status_PLC <> 2)   THEN
		Cnt_cleared	:= 	FALSE;
		Step_1_clear	 :=	FALSE;
		Poliv_liters	:=	0;
		FertA_liters	:=	0;
		FertB_liters	:=	0;
		Cnt_water_fertA_start	:=	0;
		Cnt_water_fertB_start	:=	0;
		Modbus.Cnt_water_fertA	:=	0;
		Modbus.Cnt_water_fertB	:=	0;
		Modbus.Teplica_DI1_poliv	:=	0;
		Modbus.Teplica_DI2_fertA	:=	0;
		Modbus.Teplica_DI3_fertB	:=	0;
		Modbus.Teplica_poliv_status_PLC:=1;
		Modbus.Teplica_poliv_message_PLC:=1;
		Modbus.Teplica_time_elapsed_poliv :=0;
		Modbus.Teplica_time_elapsed_fertA :=0;
		Modbus.Teplica_time_elapsed_fertB :=0;

		Timer_1_clearQ			:= FALSE;
		Timer_2_fertAQ			:= FALSE;
		Timer_3_clearQ			:= FALSE;
		Timer_4_fertBQ			:= FALSE;
		Step_1_clear				:= FALSE;
		Poliv_init_stop			:= FALSE;
		FertA_init_stop			:=	FALSE;
		FertB_init_stop			:=	FALSE;
		Bool_poliv_before_fert		:=	FALSE;
END_IF

(*ограничитель полива  в случае невозможности обнулить счётчики из-за недоступности RS485-шлюза*)
(*
	IF (Poliv_init_stop	=	FALSE AND (Modbus.Teplica_poliv_break=TRUE  OR  Cnt_Teplica_poliv_message_PLC_M3 > 2 OR  Cnt_Teplica_poliv_message_PLC_M5 > 2 OR  Cnt_Teplica_poliv_message_PLC_M7 > 2 OR  Cnt_Teplica_poliv_message_PLC_M9 > 2 OR  Cnt_Teplica_poliv_message_PLC_M11 > 2))
	THEN
		Cnt_cleared	:= 	FALSE;
		Modbus.Teplica_poliv_status_PLC :=  0;
		Poliv_init_stop	:=	TRUE;
		Modbus.Teplica_poliv_active:= FALSE;

		Modbus.Teplica_DO4_pomp_poliv:=FALSE;
		Modbus.Teplica_DO5_pomp_fertA :=  FALSE;
		Modbus.Teplica_DO6_pomp_fertB :=  FALSE;

		Step_1_clear	 :=	FALSE;

		Timer_poliv_all.IN := FALSE;
		Timer_1_clear.IN := FALSE;
		Timer_2_fertA.IN:=FALSE;
		Timer_3_clear.IN := FALSE;
		Timer_4_fertB.IN:=FALSE;
	END_IF
*)

(*Нормальный режим старта полива после обнуления счётчиков*)

IF (Modbus.Teplica_poliv_status_PLC=2 AND Cnt_cleared=TRUE AND Step_1_clear = FALSE ) THEN
	DO3_poliv_writed_0		:=	FALSE;
	DO4_fertA_writed_0		:=	FALSE;
	DO5_fertB_writed_0		:=	FALSE;

	Step_1_clear	 :=	TRUE;
	Modbus.Teplica_DO4_pomp_poliv:=TRUE;
	 t_Started_poliv := TIME();
	Timer_poliv_all(IN:=NOT Timer_poliv_allQ , PT:=tTimerValue_poliv_all , Q=>Timer_poliv_allQ , ET=> );
	Timer_poliv_with_fert(IN:=NOT Timer_poliv_with_fertQ , PT:=tTimerValue_poliv_with_fert , Q=>Timer_poliv_with_fertQ , ET=> );
	Timer_1_clear(IN:=NOT Timer_1_clearQ , PT:=tTimerValue_1_clear , Q=>Timer_1_clearQ , ET=> );
END_IF

IF (Modbus.Teplica_poliv_status_PLC=2 AND Cnt_cleared=TRUE  ) THEN


	Poliv_liters 	:= 	UDINT_TO_REAL(Modbus.Teplica_DI1_poliv)/INT_TO_REAL(Modbus.Teplica_poliv_kf);
	FertA_liters	:=	UDINT_TO_REAL(Modbus.Teplica_DI2_fertA)/INT_TO_REAL(Modbus.Teplica_fertA_kf);
	FertB_liters	:=	UDINT_TO_REAL(Modbus.Teplica_DI3_fertB)/INT_TO_REAL(Modbus.Teplica_fertB_kf);
	Modbus.Teplica_time_elapsed_poliv :=(TIME_TO_UDINT( TIME() - t_Started_poliv))/1000;

(* промывка и фертигация   OR Modbus.Teplica_set_poliv_before_fert >Poliv_liters*)

IF (Modbus.Teplica_type_poliv = TRUE) THEN
	IF ((Timer_1_clear.Q OR Poliv_liters>Modbus.Teplica_set_poliv_before_fert) AND Bool_poliv_before_fert=FALSE) THEN
		Timer_1_clear.IN 		:= FALSE;
		Bool_poliv_before_fert	:= TRUE;
		IF (Modbus.Teplica_type_fert = FALSE) THEN
			Modbus.Teplica_DO5_pomp_fertA :=  TRUE;  (*включение насоса фертигации из бака А*)
			Timer_2_fertA(IN:=NOT Timer_2_fertAQ , PT:=tTimerValue_2_fertA , Q=>Timer_2_fertAQ , ET=> );
			t_Started_fertA := TIME();
			Cnt_water_fertA_start :=Modbus.Teplica_DI1_poliv;


		ELSE
			Modbus.Teplica_DO6_pomp_fertB :=  TRUE;   (*включение насоса фертигации из бака B*)
			Timer_4_fertB(IN:=NOT Timer_4_fertBQ , PT:=tTimerValue_4_fertB , Q=>Timer_4_fertBQ , ET=> );
			t_Started_fertB := TIME();
			Cnt_water_fertB_start :=Modbus.Teplica_DI1_poliv;

		END_IF


	END_IF





	IF ( (Timer_2_fertA.Q OR FertA_liters > Modbus.Teplica_set_fertA) AND Modbus.Teplica_DO5_pomp_fertA =  TRUE) THEN
		Modbus.Teplica_DO5_pomp_fertA :=  FALSE; (*отключение насоса фертигации из бака А*)
		Timer_2_fertA.IN:=FALSE;
		FertA_init_stop	:=	TRUE;
		Timer_3_clear(IN:=NOT Timer_3_clearQ , PT:=tTimerValue_3_clear , Q=>Timer_3_clearQ , ET=> );
	END_IF

	IF ( (Timer_4_fertB.Q OR FertB_liters > Modbus.Teplica_set_fertB) AND Modbus.Teplica_DO6_pomp_fertB =  TRUE ) THEN
		Modbus.Teplica_DO6_pomp_fertB :=  FALSE; (*отключение насоса фертигации из бака B*)
		Timer_4_fertB.IN:=FALSE;
		FertB_init_stop	:=	TRUE;
		Timer_3_clear(IN:=NOT Timer_3_clearQ , PT:=tTimerValue_3_clear , Q=>Timer_3_clearQ , ET=> );
	END_IF

END_IF

(*ограничитель полива  в нормальном режиме*)
	IF (Modbus.Teplica_type_poliv = FALSE) THEN
		IF ((Timer_poliv_all.Q=TRUE OR (Poliv_liters > Modbus.Teplica_set_poliv)  OR Modbus.Teplica_poliv_break=TRUE OR Timer_3_clear.Q=TRUE) AND  Poliv_init_stop = FALSE )THEN
			IF (Modbus.Teplica_DO5_pomp_fertA =  TRUE) THEN
				Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
			END_IF
			IF (Modbus.Teplica_DO6_pomp_fertB =  TRUE) THEN
				Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
			END_IF

			Poliv_init_stop	:=	TRUE;
			Cnt_cleared	:= 	FALSE;
			Modbus.Teplica_poliv_status_PLC :=  0;
			Modbus.Teplica_poliv_active:= FALSE;
			Modbus.Teplica_DO4_pomp_poliv:=FALSE;
			Modbus.Teplica_DO5_pomp_fertA :=  FALSE;
			Modbus.Teplica_DO6_pomp_fertB :=  FALSE;
			Timer_poliv_all.IN := FALSE;
			Timer_poliv_with_fert.IN := FALSE;
			Timer_1_clear.IN := FALSE;
			Timer_2_fertA.IN:=FALSE;
			Timer_3_clear.IN := FALSE;
			Timer_4_fertB.IN:=FALSE;
		END_IF
	ELSE
		IF ((Timer_poliv_with_fert.Q=TRUE OR   Modbus.Teplica_poliv_break=TRUE OR Timer_3_clear.Q=TRUE) AND  Poliv_init_stop = FALSE )THEN
			IF (Modbus.Teplica_DO5_pomp_fertA =  TRUE) THEN
				Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
			END_IF
			IF (Modbus.Teplica_DO6_pomp_fertB =  TRUE) THEN
				Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
			END_IF

			Poliv_init_stop	:=	TRUE;
			Cnt_cleared	:= 	FALSE;
			Modbus.Teplica_poliv_status_PLC :=  0;
			Modbus.Teplica_poliv_active:= FALSE;
			Modbus.Teplica_DO4_pomp_poliv:=FALSE;
			Modbus.Teplica_DO5_pomp_fertA :=  FALSE;
			Modbus.Teplica_DO6_pomp_fertB :=  FALSE;
			Timer_poliv_all.IN := FALSE;
			Timer_poliv_with_fert.IN := FALSE;
			Timer_1_clear.IN := FALSE;
			Timer_2_fertA.IN:=FALSE;
			Timer_3_clear.IN := FALSE;
			Timer_4_fertB.IN:=FALSE;
		END_IF
	END_IF
END_IF











(*LIGHT TEPLICA *)

IF (Modbus.Teplica_DO3_light = FALSE) THEN

	IF ((Modbus.Teplica_light_lux > Modbus.Teplica_light_set_low+gisterezis_lux) OR Modbus.Teplica_light_allow = FALSE  ) THEN
		Modbus.Teplica_DO3_light :=FALSE;
	END_IF

	IF ((Modbus.Teplica_light_lux <  Modbus.Teplica_light_set_low-gisterezis_lux ) AND Modbus.Teplica_light_allow ) THEN
		Modbus.Teplica_DO3_light:=TRUE;
	END_IF

END_IF

IF (Modbus.Teplica_DO3_light = TRUE) THEN

	IF ((Modbus.Teplica_light_lux-Modbus.Teplica_power_light_lux > Modbus.Teplica_light_set_low+gisterezis_lux) OR Modbus.Teplica_light_allow = FALSE  ) THEN
		Modbus.Teplica_DO3_light :=FALSE;
	END_IF

	IF ((Modbus.Teplica_light_lux-Modbus.Teplica_power_light_lux <  Modbus.Teplica_light_set_low-gisterezis_lux ) AND Modbus.Teplica_light_allow ) THEN
		Modbus.Teplica_DO3_light:=TRUE;
	END_IF

END_IF



(*HEAT TEPLICA *)

	IF ((Modbus.Teplica_temp_air > Modbus.Teplica_temp_set_low+1)   ) THEN
		Modbus.Teplica_DO2_heat :=FALSE;
	END_IF

	IF ((Modbus.Teplica_temp_air <  Modbus.Teplica_temp_set_low-1 ) ) THEN
		Modbus.Teplica_DO2_heat:=TRUE;
	END_IF

(*VENT  TEPLICA *)

	IF ((Modbus.Teplica_temp_air < Modbus.Teplica_temp_set_high-1)   ) THEN
		Modbus.Teplica_DO1_vent			 :=FALSE;
	END_IF

	IF ((Modbus.Teplica_temp_air >  Modbus.Teplica_temp_set_high+1 ) ) THEN
		Modbus.Teplica_DO1_vent:=TRUE;
	END_IF


	IF (Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_window_open-1 ) THEN
		HW_window_opener				:=FALSE;
		Modbus.Teplica_window_opener	:=FALSE;
	END_IF
	IF (Modbus.Teplica_temp_air >  Modbus.Teplica_set_temp_window_open+1 AND   Modbus.Street_temp > 5 ) THEN
		HW_window_opener				:=TRUE;
		Modbus.Teplica_window_opener	:=TRUE;
	END_IF


	IF (Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_pomp_cold-2   ) THEN
		HW_pomp_cold				:=FALSE;
		Modbus.Teplica_pomp_cold	:=FALSE;
	END_IF
	IF (Modbus.Teplica_temp_air >  Modbus.Teplica_set_temp_pomp_cold+2 AND   Modbus.Street_temp > 5 ) THEN
		HW_pomp_cold				:=TRUE;
		Modbus.Teplica_pomp_cold	:=TRUE;
	END_IF






END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM teplica_ai
VAR
    (* Общие таймеры *)
    Timer_poliv_all : TON;
    Timer_poliv_with_fert : TON;
    Timer_1_clear : TON;
    Timer_3_clear : TON;
    Timer_poliv_finish : TON;
    Timer_calc_kf : TON;
    Timer_valve : TON;

    (* Таймеры для баков (A и B) *)
    Timer_fert : ARRAY[1..2] OF TON;
    Timer_fertQ : ARRAY[1..2] OF BOOL;

    (* Триггеры *)
    TRIG_start_poliv : R_TRIG;
    TRIG_poliv_break : R_TRIG;
    TRIG_valve_tank_F : F_TRIG;
    TRIG_valve_tank_R : R_TRIG;
    TRIG_level_tank_low : R_TRIG;
    TRIG_level_tank_high : R_TRIG;

    (* ПИ-регуляторы и их параметры (для двух баков) *)
    pi_fert : ARRAY[1..2] OF FB_CTRL_PI;
    pi_par : ARRAY[1..2] OF ST_CTRL_PI_PARAMS;
    kf_calc : ARRAY[1..2] OF REAL;
    cnt_water_fert_start : ARRAY[1..2] OF UDINT;
    cnt_fert_calc_start : ARRAY[1..2] OF REAL;
    vol_fert : ARRAY[1..2] OF REAL;
    fOut : ARRAY[1..2] OF REAL;
    act : ARRAY[1..2] OF REAL;
    pwm_data : ARRAY[1..2] OF REAL;
    pwm_cnt : ARRAY[1..2] OF UDINT;
    pwm_avg : ARRAY[1..2] OF REAL;
    fert_pwm_level : ARRAY[1..2] OF UINT;

    (* Переменные для объёмов *)
    Poliv_liters : REAL;
    FertA_liters : REAL;
    FertB_liters : REAL;
    Cnt_water_calc_kf_start : REAL;
    vol_water : REAL;

    (* Прочие переменные *)
    Cnt_water_pipe : UDINT;
    Cnt_water_finish_clear_start : UDINT;
    Cnt_water_finish_clear : REAL;
    t_Started_poliv : TIME;
    t_Started_fert : ARRAY[1..2] OF TIME;
    tTimerValue_poliv_all : TIME := t#60s;
    tTimerValue_1_clear : TIME := t#10s;
    tTimerValue_2_fert : ARRAY[1..2] OF TIME := t#30s, t#10s;
    tTimerValue_3_clear : TIME := t#60s;
    tTimerValue_poliv_with_fert : TIME := t#60m;
    tTimerValue_poliv_finish : TIME := t#3s;
    tTimerValue_valve_water : TIME := t#60m;
    Bool_poliv_before_fert : BOOL;
    max_EC : REAL;
    avg_light_ma : FB_CTRL_MOVING_AVERAGE;
    stParams_avg_light : ST_CTRL_MOVING_AVERAGE_PARAMS;
    arr_table : ARRAY[1..20] OF FLOAT;
    start_cfg_avg_light : BOOL;
    start_cfg_pi_par : BOOL;
    gisterezis_lux : INT := 1000;
    tank_level_low : BOOL;
    tank_level_high : BOOL;
    fert_idx : INT;
    setpoint : REAL;
    zone_offset : INT;
END_VAR

(* @END_DECLARATION := '0' *)
(* ---------- Инициализация скользящего среднего ---------- *)
IF NOT start_cfg_avg_light THEN
    stParams_avg_light.tCtrlCycleTime := T#60s;
    stParams_avg_light.tTaskCycleTime := T#10ms;
    stParams_avg_light.nSamplesToFilter := 20;
    stParams_avg_light.pWorkArray_ADR := ADR(arr_table);
    stParams_avg_light.nWorkArray_SIZEOF := SIZEOF(arr_table);
    start_cfg_avg_light := TRUE;
END_IF
avg_light_ma(fIn:=Modbus.Teplica_light_lux, fManSyncValue:=0, bSync:=0,
             eMode:=eCTRL_MODE_ACTIVE, bHold:=0, stParams:=stParams_avg_light,
             fOut=>Modbus.Teplica_avg_lux);

(* ---------- Инициализация ПИ-регуляторов и коэффициентов ---------- *)
IF NOT start_cfg_pi_par THEN
    FOR fert_idx := 1 TO 2 DO
        pi_par[fert_idx].bARWOnIPartOnly := 0;
        pi_par[fert_idx].fKp := 300000;
        pi_par[fert_idx].fOutMaxLimit := 32765;
        pi_par[fert_idx].fOutMinLimit := 16800;
        pi_par[fert_idx].tCtrlCycleTime := T#4s;
        pi_par[fert_idx].tTaskCycleTime := T#10ms;
        pi_par[fert_idx].tTn := T#8s;
        kf_calc[fert_idx] := 12.0;   (* начальное значение Kf *)
    END_FOR
    start_cfg_pi_par := TRUE;
END_IF

(* ---------- Защита от нулевых коэффициентов ---------- *)
FOR fert_idx := 1 TO 2 DO
    IF kf_calc[fert_idx] = 0.0 THEN
        kf_calc[fert_idx] := 12.0;
    END_IF
END_FOR
IF Modbus.Teplica_fert_kf = 0 THEN
    Modbus.Teplica_fert_kf := 24;
END_IF
setpoint := 1.0 / INT_TO_REAL(Modbus.Teplica_fert_kf);

(* ---------- Установка времён из Modbus (перевод минут в мс) ---------- *)
tTimerValue_poliv_all        := UDINT_TO_TIME(60000 * Modbus.Teplica_set_max_poliv_time);
tTimerValue_1_clear          := UDINT_TO_TIME(60000 * Modbus.Teplica_set_clear_time);
tTimerValue_2_fert[1]        := UDINT_TO_TIME(60000 * Modbus.Teplica_set_max_fertA_time);
tTimerValue_2_fert[2]        := UDINT_TO_TIME(60000 * Modbus.Teplica_set_max_fertB_time);
tTimerValue_3_clear          := UDINT_TO_TIME(60000 * Modbus.Teplica_set_finish_clear_time);

(* ---------- Вызов таймеров ---------- *)
Timer_poliv_all();
Timer_poliv_with_fert();
Timer_1_clear();
Timer_3_clear();
FOR fert_idx := 1 TO 2 DO Timer_fert[fert_idx](); END_FOR
Timer_poliv_finish();
Timer_calc_kf();
Timer_valve();

(* ---------- Триггеры ---------- *)
TRIG_start_poliv(CLK := Modbus.Teplica_poliv_active);
TRIG_poliv_break(CLK := Modbus.Teplica_poliv_break);
TRIG_valve_tank_F(CLK := HW_water_tank_teplica_level);
TRIG_valve_tank_R(CLK := HW_water_tank_teplica_level);

tank_level_low   := Modbus.Teplica_tank_level < 1000;
tank_level_high  := Modbus.Teplica_tank_level > 1200;
TRIG_level_tank_low(CLK := tank_level_low);
TRIG_level_tank_high(CLK := tank_level_high);
Modbus.Teplica_tank_teplica_level := HW_water_tank_teplica_level;

(* ---------- Управление клапаном воды в бак ---------- *)
IF TRIG_valve_tank_F.Q OR TRIG_level_tank_low.Q THEN
    Timer_valve(IN := NOT Timer_valve.Q, PT := tTimerValue_valve_water);
    HW_valve_pomp_teplica := TRUE;
    Modbus.Teplica_valve_water_in := TRUE;
END_IF
IF TRIG_valve_tank_R.Q OR Timer_valve.Q OR TRIG_level_tank_high.Q THEN
    HW_valve_pomp_teplica := FALSE;
    Modbus.Teplica_valve_water_in := FALSE;
    Timer_valve.IN := FALSE;
END_IF

(* ---------- Старт полива ---------- *)
IF TRIG_start_poliv.Q AND Modbus.Teplica_tank_level > 400 THEN
    FOR fert_idx := 1 TO 2 DO
        pwm_data[fert_idx] := 0.0;
        pwm_cnt[fert_idx] := 0;
        pwm_avg[fert_idx] := 0.0;
        cnt_water_fert_start[fert_idx] := 0;
        cnt_fert_calc_start[fert_idx] := 0.0;
    END_FOR
    Modbus.Teplica_impulse_fertA_cnt := 0;
    Modbus.Teplica_impulse_fertB_cnt := 0;
    Modbus.Teplica_impulse_water_cnt := 0;
    Modbus.Teplica_cnt_water_pipe := 0;
    Modbus.Teplica_time_elapsed_poliv := 0;
    Modbus.Teplica_time_elapsed_fertA := 0;
    Modbus.Teplica_time_elapsed_fertB := 0;
    Poliv_liters := 0.0;
    FertA_liters := 0.0;
    FertB_liters := 0.0;
    Cnt_water_finish_clear := 0.0;
    Cnt_water_finish_clear_start := 0;
    Cnt_water_calc_kf_start := 0.0;
    max_EC := 0.0;
    Bool_poliv_before_fert := FALSE;

    FOR fert_idx := 1 TO 2 DO
        Timer_fert[fert_idx].IN := FALSE;
    END_FOR
    Timer_1_clear.IN := FALSE;
    Timer_3_clear.IN := FALSE;
    Timer_calc_kf.IN := FALSE;
    Timer_poliv_finish.IN := FALSE;
    Timer_poliv_all.IN := FALSE;
    Timer_poliv_with_fert.IN := FALSE;

    Modbus.Teplica_pomp_poliv := TRUE;
    t_Started_poliv := TIME();
    Timer_poliv_all(IN := NOT Timer_poliv_all.Q, PT := tTimerValue_poliv_all);
    Timer_poliv_with_fert(IN := NOT Timer_poliv_with_fert.Q, PT := tTimerValue_poliv_with_fert);
    Timer_1_clear(IN := NOT Timer_1_clear.Q, PT := tTimerValue_1_clear);
    Modbus.Teplica_poliv_status_PLC := 2;
    (* вычисляем смещение для зоны *)
    zone_offset := 0;
    IF Modbus.Teplica_zone_poliv <> 0 THEN zone_offset := 1; END_IF
    Modbus.Teplica_poliv_message_PLC := 1 + zone_offset;
END_IF

(* ---------- Основной цикл полива ---------- *)
IF Modbus.Teplica_poliv_status_PLC = 2 THEN
    Cnt_water_pipe := Modbus.Teplica_cnt_water_pipe;
    Poliv_liters  := UDINT_TO_REAL(Modbus.Teplica_impulse_water_cnt) / INT_TO_REAL(Modbus.Teplica_poliv_kf);
    FertA_liters  := UDINT_TO_REAL(Modbus.Teplica_impulse_fertA_cnt) / INT_TO_REAL(Modbus.Teplica_fertA_kf);
    FertB_liters  := UDINT_TO_REAL(Modbus.Teplica_impulse_fertB_cnt) / INT_TO_REAL(Modbus.Teplica_fertB_kf);
    Modbus.Teplica_time_elapsed_poliv := (TIME_TO_UDINT(TIME() - t_Started_poliv)) / 1000;
    IF Modbus.Teplica_sensor_soil_EC > max_EC THEN max_EC := Modbus.Teplica_sensor_soil_EC; END_IF

    (* выбор бака: 1 – A, 2 – B *)
    IF Modbus.Teplica_type_fert THEN
        fert_idx := 2;
    ELSE
        fert_idx := 1;
    END_IF

    (* смещение для зоны (используется далее) *)
    zone_offset := 0;
    IF Modbus.Teplica_zone_poliv <> 0 THEN zone_offset := 1; END_IF

    (* ------------------- Полив с фертигацией ------------------- *)
    IF Modbus.Teplica_type_poliv THEN
        (* Этап 1: промывка перед фертигацией *)
        IF NOT Timer_1_clear.Q AND NOT Bool_poliv_before_fert THEN
            Modbus.Teplica_poliv_message_PLC := 3 + (fert_idx-1)*2 + zone_offset;
        END_IF

        (* Переход к фертигации *)
        IF (Timer_1_clear.Q OR Poliv_liters > Modbus.Teplica_set_poliv_before_fert) AND NOT Bool_poliv_before_fert THEN
            Timer_1_clear.IN := FALSE;
            Bool_poliv_before_fert := TRUE;
            IF fert_idx = 1 THEN
                Modbus.Teplica_pomp_fertA := TRUE;
            ELSE
                Modbus.Teplica_pomp_fertB := TRUE;
            END_IF
            Timer_fert[fert_idx](IN := NOT Timer_fert[fert_idx].Q, PT := tTimerValue_2_fert[fert_idx]);
            t_Started_fert[fert_idx] := TIME();
            cnt_water_fert_start[fert_idx] := Modbus.Teplica_impulse_water_cnt;
            cnt_fert_calc_start[fert_idx] := Poliv_liters;
            Cnt_water_calc_kf_start := Poliv_liters;
            Modbus.Teplica_poliv_message_PLC := 7 + (fert_idx-1)*2 + zone_offset;
        END_IF

        (* Работа активного бака *)
        IF (fert_idx = 1 AND Modbus.Teplica_pomp_fertA) OR (fert_idx = 2 AND Modbus.Teplica_pomp_fertB) THEN
            act[fert_idx] := 1.0 / kf_calc[fert_idx];
            pi_fert[fert_idx](fSetpointValue := setpoint, fActualValue := act[fert_idx],
                fManSyncValue := 0, bSync := 0, eMode := 2, bHold := 0,
                stParams := pi_par[fert_idx], fOut => fOut[fert_idx]);

            IF fert_idx = 1 THEN
                Modbus.Teplica_time_elapsed_fertA := (TIME_TO_UDINT(TIME() - t_Started_fert[1])) / 1000;
                Modbus.Cnt_water_fertA := Modbus.Teplica_impulse_water_cnt - cnt_water_fert_start[1];
            ELSE
                Modbus.Teplica_time_elapsed_fertB := (TIME_TO_UDINT(TIME() - t_Started_fert[2])) / 1000;
                Modbus.Cnt_water_fertB := Modbus.Teplica_impulse_water_cnt - cnt_water_fert_start[2];
            END_IF

            Timer_calc_kf(IN := NOT Timer_calc_kf.Q, PT := t#3s);
            IF Timer_calc_kf.Q THEN
                vol_water := Poliv_liters - Cnt_water_calc_kf_start;
                IF fert_idx = 1 THEN
                    vol_fert[1] := FertA_liters - cnt_fert_calc_start[1];
                ELSE
                    vol_fert[2] := FertB_liters - cnt_fert_calc_start[2];
                END_IF
                IF vol_fert[fert_idx] > 0.0 THEN
                    kf_calc[fert_idx] := vol_water / vol_fert[fert_idx];
                ELSE
                    kf_calc[fert_idx] := 1000.0;
                END_IF
                Cnt_water_calc_kf_start := Poliv_liters;
                IF fert_idx = 1 THEN
                    cnt_fert_calc_start[1] := FertA_liters;
                ELSE
                    cnt_fert_calc_start[2] := FertB_liters;
                END_IF
                Timer_calc_kf.IN := FALSE;
            END_IF

            fert_pwm_level[fert_idx] := REAL_TO_UINT(fOut[fert_idx]);
            pwm_data[fert_idx] := pwm_data[fert_idx] + fert_pwm_level[fert_idx];
            pwm_cnt[fert_idx] := pwm_cnt[fert_idx] + 1;
            pwm_avg[fert_idx] := pwm_data[fert_idx] / pwm_cnt[fert_idx];
        END_IF

        (* Завершение фертигации (переход к промывке) *)
        IF (fert_idx = 1 AND Modbus.Teplica_pomp_fertA) AND (Timer_fert[1].Q OR FertA_liters > Modbus.Teplica_set_fertA) THEN
            Modbus.Teplica_pomp_fertA := FALSE;
            Modbus.Teplica_time_elapsed_fertA := (TIME_TO_UDINT(TIME() - t_Started_fert[1])) / 1000;
            Modbus.Cnt_water_fertA := Modbus.Teplica_impulse_water_cnt - cnt_water_fert_start[1];
            Timer_fert[1].IN := FALSE;
            Cnt_water_finish_clear_start := Modbus.Teplica_impulse_water_cnt;
            Timer_3_clear(IN := NOT Timer_3_clear.Q, PT := tTimerValue_3_clear);
            Modbus.Teplica_poliv_message_PLC := 11 + zone_offset;
        END_IF
        IF (fert_idx = 2 AND Modbus.Teplica_pomp_fertB) AND (Timer_fert[2].Q OR FertB_liters > Modbus.Teplica_set_fertB) THEN
            Modbus.Teplica_pomp_fertB := FALSE;
            Modbus.Teplica_time_elapsed_fertB := (TIME_TO_UDINT(TIME() - t_Started_fert[2])) / 1000;
            Modbus.Cnt_water_fertB := Modbus.Teplica_impulse_water_cnt - cnt_water_fert_start[2];
            Timer_fert[2].IN := FALSE;
            Cnt_water_finish_clear_start := Modbus.Teplica_impulse_water_cnt;
            Timer_3_clear(IN := NOT Timer_3_clear.Q, PT := tTimerValue_3_clear);
            Modbus.Teplica_poliv_message_PLC := 13 + zone_offset;
        END_IF

        (* Расчёт объёма промывки *)
        IF Modbus.Teplica_poliv_message_PLC >= 11 AND Modbus.Teplica_poliv_message_PLC <= 14 THEN
            Cnt_water_finish_clear := UDINT_TO_REAL(Modbus.Teplica_impulse_water_cnt - Cnt_water_finish_clear_start) / Modbus.Teplica_poliv_kf;
        END_IF

        (* Условия окончания полива с фертигацией *)
        IF Timer_poliv_with_fert.Q OR Modbus.Teplica_poliv_break OR Timer_3_clear.Q OR
           Cnt_water_finish_clear > Modbus.Teplica_set_finish_clear_vol THEN
            Modbus.Teplica_max_EC := max_EC;
            Modbus.Teplica_poliv_active := FALSE;
            Modbus.Teplica_pomp_poliv := FALSE;
            Modbus.Teplica_pomp_fertA := FALSE;
            Modbus.Teplica_pomp_fertB := FALSE;
            Timer_poliv_all.IN := FALSE;
            Timer_poliv_with_fert.IN := FALSE;
            Timer_1_clear.IN := FALSE;
            Timer_3_clear.IN := FALSE;
            FOR fert_idx := 1 TO 2 DO
                Timer_fert[fert_idx].IN := FALSE;
            END_FOR
            Timer_calc_kf.IN := FALSE;
            Modbus.Teplica_poliv_message_PLC := 15 + (fert_idx-1)*2 + zone_offset;
            Modbus.Teplica_poliv_status_PLC := 10;
            Timer_poliv_finish(IN := NOT Timer_poliv_finish.Q, PT := tTimerValue_poliv_finish);
        END_IF

    (* ------------------- Полив без фертигации ------------------- *)
    ELSE
        IF Timer_poliv_all.Q OR (Poliv_liters > Modbus.Teplica_set_poliv) OR Modbus.Teplica_poliv_break THEN
            Modbus.Teplica_poliv_message_PLC := 19 + zone_offset;
            Modbus.Teplica_poliv_active := FALSE;
            Modbus.Teplica_pomp_poliv := FALSE;
            Modbus.Teplica_pomp_fertA := FALSE;
            Modbus.Teplica_pomp_fertB := FALSE;
            Timer_poliv_all.IN := FALSE;
            Timer_poliv_with_fert.IN := FALSE;
            Timer_1_clear.IN := FALSE;
            Timer_3_clear.IN := FALSE;
            FOR fert_idx := 1 TO 2 DO
                Timer_fert[fert_idx].IN := FALSE;
            END_FOR
            Modbus.Teplica_poliv_status_PLC := 10;
        END_IF
    END_IF

    (* Обнуление ШИМ, если насосы не активны *)
    IF NOT Modbus.Teplica_type_poliv OR (Modbus.Teplica_type_poliv AND NOT (Modbus.Teplica_pomp_fertA OR Modbus.Teplica_pomp_fertB)) THEN
        fert_pwm_level[1] := 0;
        fert_pwm_level[2] := 0;
    END_IF

    (* Вывод данных для Modbus *)
    Modbus.Teplica_fert_actA := kf_calc[1];
    Modbus.Teplica_fert_actB := kf_calc[2];
    Modbus.Teplica_fert_pwm_levelA := REAL_TO_INT(100.0 * fert_pwm_level[1] / 32765.0);
    Modbus.Teplica_fert_pwm_levelB := REAL_TO_INT(100.0 * fert_pwm_level[2] / 32765.0);
    Modbus.Teplica_pwm_avg_A := REAL_TO_INT(100.0 * pwm_avg[1] / 32765.0);
    Modbus.Teplica_pwm_avg_B := REAL_TO_INT(100.0 * pwm_avg[2] / 32765.0);
END_IF

(* ---------- Управление освещением ---------- *)
IF Modbus.Teplica_light THEN
    IF (Modbus.Teplica_avg_lux > Modbus.Teplica_light_set_low + gisterezis_lux) OR (Modbus.Teplica_temp_air > 28) OR NOT Modbus.Teplica_light_allow THEN
        Modbus.Teplica_light := FALSE;
        HW_teplica_light := FALSE;
    END_IF
ELSE
    IF (Modbus.Teplica_avg_lux < Modbus.Teplica_light_set_low - gisterezis_lux) AND (Modbus.Teplica_temp_air < 27) AND Modbus.Teplica_light_allow THEN
        Modbus.Teplica_light := TRUE;
        HW_teplica_light := TRUE;
    END_IF
END_IF

(* ---------- Управление отоплением ---------- *)
IF Modbus.Teplica_temp_air > Modbus.Teplica_temp_set_low + 1 THEN
    Modbus.Teplica_heat := FALSE;
    HW_teplica_heat := FALSE;
ELSIF Modbus.Teplica_temp_air < Modbus.Teplica_temp_set_low - 1 THEN
    Modbus.Teplica_heat := TRUE;
    HW_teplica_heat := TRUE;
END_IF

(* ---------- Управление подогревом бака ---------- *)
IF (Modbus.Teplica_temp_water_tank > Modbus.Teplica_set_temp_tank + 1) OR HW_teplica_heat OR (Modbus.Teplica_tank_level < 400) THEN
    Modbus.Teplica_tank_heat := FALSE;
    HW_teplica_tank_heat := FALSE;
ELSIF (Modbus.Teplica_temp_water_tank < Modbus.Teplica_set_temp_tank - 1) AND NOT HW_teplica_heat AND (Modbus.Teplica_tank_level > 400) THEN
    Modbus.Teplica_tank_heat := TRUE;
    HW_teplica_tank_heat := TRUE;
END_IF

(* ---------- Управление вентиляцией ---------- *)
IF Modbus.Teplica_temp_air < Modbus.Teplica_temp_set_high - 1 THEN
    Modbus.Teplica_vent := FALSE;
    HW_teplica_vent := FALSE;
ELSIF Modbus.Teplica_temp_air > Modbus.Teplica_temp_set_high + 1 THEN
    Modbus.Teplica_vent := TRUE;
    HW_teplica_vent := TRUE;
END_IF

(* ---------- Открытие форточки ---------- *)
IF Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_window_open - 1 THEN
    HW_teplica_window_opener := FALSE;
    Modbus.Teplica_window_opener := FALSE;
ELSIF Modbus.Teplica_temp_air > Modbus.Teplica_set_temp_window_open + 1 AND Modbus.Street_temp > 0 THEN
    HW_teplica_window_opener := TRUE;
    Modbus.Teplica_window_opener := TRUE;
END_IF

(* ---------- Холодный насос ---------- *)
IF Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_pomp_cold - 1 THEN
    HW_teplica_pomp_cold := FALSE;
    Modbus.Teplica_pomp_cold := FALSE;
ELSIF Modbus.Teplica_temp_air > Modbus.Teplica_set_temp_pomp_cold + 1 AND Modbus.Street_temp > 10 THEN
    HW_teplica_pomp_cold := TRUE;
    Modbus.Teplica_pomp_cold := TRUE;
END_IF

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM teplica_new
VAR
	Cnt_water_fertA_start	:	UDINT;
	Cnt_water_fertB_start	:	UDINT;
	Cnt_water_finish_clear_start	:	UDINT;
	Cnt_water_finish_clear	:		REAL;
	t_Started_poliv			:	TIME;
	t_Started_fertA			:	TIME;
	t_Started_fertB			:	TIME;


	Timer_poliv_all			: TON;
	Timer_poliv_allQ			: BOOL;

	Timer_1_clear			: TON;
	Timer_2_fertA				: TON;
	Timer_3_clear			: TON;
	Timer_4_fertB				: TON;
	Timer_poliv_with_fert		: TON;
	Timer_poliv_finish			: TON;

	Timer_calc_kf			: TON;
	Timer_calc_kfQ			:BOOL;
	Cnt_water_calc_kf_start		:REAL;
	Cnt_fertA_calc_kf_start		:REAL;
	Cnt_fertB_calc_kf_start		:REAL;
	Kf_calc_fertA				: REAL:=12;
	Kf_calc_fertB				: REAL:=12;
	vol_water				: REAL;
	vol_fertA					: REAL;
	vol_fertB					: REAL;

	Timer_poliv_finishQ		: BOOL;
	Timer_1_clearQ			: BOOL;
	Timer_2_fertAQ			: BOOL;
	Timer_3_clearQ			: BOOL;
	Timer_4_fertBQ			: BOOL;



	 tTimerValue_poliv_all		: TIME:=t#60s;  (* Максимальное время полива*)
	 tTimerValue_1_clear		: TIME:=t#10s;  (* Промывка перед 1 фертигацией*)
	 tTimerValue_2_fertA		: TIME:=t#30s;  (* Ограничение фертигации из бака А*)
	 tTimerValue_3_clear		: TIME:=t#60s;  (* Промывка перед OFF*)
	 tTimerValue_4_fertB		: TIME:=t#10s;  (* Ограничение фертигации из бака Б*)
	 tTimerValue_poliv_with_fert	: TIME:=t#60m;  (* Ограничение полива с фертигацией *)
	 tTimerValue_poliv_finish	: TIME:=t#3s;  (*Пауза перед статусом завршения полива для обновления регистров *)

	Timer_valve				: TON;
	Timer_valveQ			: BOOL;
	 tTimerValue_valve_water	: TIME:=t#60m;  (* Максимальное время открытия клапана подачи воды в теплицу*)

	TRIG_start_poliv			:	R_TRIG;
	TRIG_valve_tank_F		:	F_TRIG;
	TRIG_valve_tank_R		:	R_TRIG;

	TRIG_level_tank_low		:	R_TRIG;
	TRIG_level_tank_high		:	R_TRIG;

	Timer_light_avg			: TON;
	 tTimer_light_avg			: TIME:=t#1m;
	Timer_light_avgQ			: BOOL;
	Bool_poliv_before_fert		: 	BOOL;

	TRIG_poliv_break			:	R_TRIG;


	FertA_liters				:	REAL;
	FertB_liters				:	REAL;
	gisterezis_lux				:	INT:=1000;
(*	Poliv_before_fert			:	INT:=0; *)
	Timer_poliv_with_fertQ		: 	BOOL;


	max_EC					:	REAL;
	pi_fertA2 			: FB_CTRL_PI;
	pi_fertB2 			: FB_CTRL_PI;

	set_kf_fert		: INT:=12;
	start_cfg_pi_par	:BOOL;
	setA, setB, actA, actB, fOutA, fOutB	:REAL;

	avg_light_ma			: FB_CTRL_MOVING_AVERAGE;
	stParams_avg_light	: ST_CTRL_MOVING_AVERAGE_PARAMS;


	start_cfg_avg_light			:BOOL;

	avg_light					: REAL;
	arr_table					: ARRAY[1..20] OF FLOAT;
	Cnt_water_pipe			:UDINT;
	pwm_data_A	: REAL;
	pwm_cnt_A	: UDINT;
	pwm_avg_A	: REAL;
	pwm_data_B	: REAL;
	pwm_cnt_B	: UDINT;
	pwm_avg_B	: REAL;
	tank_level_low	:BOOL;
	tank_level_high	:BOOL;
	anti_hum_light	:BOOL;
(*	k_popr:	REAL; *)

END_VAR
(* @END_DECLARATION := '0' *)


IF NOT start_cfg_avg_light THEN

	stParams_avg_light.tCtrlCycleTime			:= T#60s;
	stParams_avg_light.tTaskCycleTime 			:= T#10ms;
	stParams_avg_light.nSamplesToFilter		:= 20;
	stParams_avg_light.pWorkArray_ADR		:= ADR(arr_table);
	stParams_avg_light.nWorkArray_SIZEOF		:= SIZEOF(arr_table);
	start_cfg_avg_light							:= TRUE;
END_IF

avg_light_ma(fIn:=Modbus.Teplica_light_lux, fManSyncValue :=0, bSync:=0, eMode:=eCTRL_MODE_ACTIVE,bHold:=0, stParams:=stParams_avg_light,  fOut =>avg_light);
Modbus.Teplica_avg_lux	:=	avg_light;


start_cfg_pi_par:=	FALSE;
IF NOT start_cfg_pi_par THEN


	pi_par_fertA.bARWOnIPartOnly:=0;
	pi_par_fertA.fKp:=300000*0.7;
	pi_par_fertA.fOutMaxLimit:=32765*0.7;
	pi_par_fertA.fOutMinLimit:=32765*0.25;

(*	pi_par_fertA.fOutMinLimit:=16800; *)
(*	pi_par_fertA.fOutMinLimit:=13100; *)
(*	pi_par_fertA.fOutMinLimit:=11460; *)
	pi_par_fertA.tCtrlCycleTime:=T#4s;
	pi_par_fertA.tTaskCycleTime:=T#10ms;
	pi_par_fertA.tTn:=T#12s;

	pi_par_fertB.bARWOnIPartOnly:=0;
	pi_par_fertB.fKp:=300000*0.7;
	pi_par_fertB.fOutMaxLimit:=32765*0.7;
	pi_par_fertB.fOutMinLimit:=32765*0.25;
(*	pi_par_fertB.fOutMinLimit:=16800; *)
(*	pi_par_fertB.fOutMinLimit:=13100; *)
(*	pi_par_fertA.fOutMinLimit:=11460; *)
	pi_par_fertB.tCtrlCycleTime:=T#4s;
	pi_par_fertB.tTaskCycleTime:=T#10ms;
	pi_par_fertB.tTn:=T#12s;

	start_cfg_pi_par			:=	TRUE;

END_IF


IF (Kf_calc_fertA = 0) THEN
	Kf_calc_fertA := Modbus.Teplica_fert_kf;
END_IF
IF (Kf_calc_fertB = 0) THEN
	Kf_calc_fertB := Modbus.Teplica_fert_kf;
END_IF
IF (Modbus.Teplica_fert_kf = 0) THEN
	Modbus.Teplica_fert_kf := 48;
END_IF

CASE Modbus.Teplica_fert_kf OF

79:
		pi_par_fertA.fOutMaxLimit:=32765*0.41*1.1;
		pi_par_fertA.fOutMinLimit:=32765*0.41*0.9;
		pi_par_fertB.fOutMaxLimit:=32765*0.42*1.05;
		pi_par_fertB.fOutMinLimit:=32765*0.42*0.95;

62:
		pi_par_fertA.fOutMaxLimit:=32765*0.5*1.1;
		pi_par_fertA.fOutMinLimit:=32765*0.5*0.8;
		pi_par_fertB.fOutMaxLimit:=32765*0.58*1.1;
		pi_par_fertB.fOutMinLimit:=32765*0.58*0.8;

49:
		pi_par_fertA.fOutMaxLimit:=32765*0.5*1.1;
		pi_par_fertA.fOutMinLimit:=32765*0.5*0.9;
		pi_par_fertB.fOutMaxLimit:=32765*0.58*1.1;
		pi_par_fertB.fOutMinLimit:=32765*0.58*0.9;

39:
		pi_par_fertA.fOutMaxLimit:=32765*0.53*1.1;
		pi_par_fertA.fOutMinLimit:=32765*0.53*0.9;
		pi_par_fertB.fOutMaxLimit:=32765*0.69*1.1;
		pi_par_fertB.fOutMinLimit:=32765*0.69*0.9;

30:
		pi_par_fertA.fOutMaxLimit:=32765*0.56*1.1;
		pi_par_fertA.fOutMinLimit:=32765*0.56*0.9;
		pi_par_fertB.fOutMaxLimit:=32765*0.73*1.1;
		pi_par_fertB.fOutMinLimit:=32765*0.73*0.9;

24:
		pi_par_fertA.fOutMaxLimit:=32765*0.6*1.1;
		pi_par_fertA.fOutMinLimit:=32765*0.6*0.9;
		pi_par_fertB.fOutMaxLimit:=32765*0.75*1.1;
		pi_par_fertB.fOutMinLimit:=32765*0.75*0.9;


END_CASE


setA		:=	1/(INT_TO_REAL(Modbus.Teplica_fert_kf));

setB		:=	1/(INT_TO_REAL(Modbus.Teplica_fert_kf));


(*
Trigger_water_impulse_teplica(CLK:=HW_impulse_water_teplica);
Trigger_fertA_impulse_teplica(CLK:=HW_impulse_fertA_teplica);
Trigger_fertB_impulse_teplica(CLK:=HW_impulse_fertB_teplica);

IF Trigger_water_impulse_teplica.Q THEN
	Modbus.Teplica_impulse_water_cnt	:= 	Modbus.Teplica_impulse_water_cnt+1;
END_IF


IF Trigger_fertA_impulse_teplica.Q THEN
	Modbus.Teplica_impulse_fertA_cnt	:= 	Modbus.Teplica_impulse_fertA_cnt+1;
END_IF
IF Trigger_fertB_impulse_teplica.Q THEN
	Modbus.Teplica_impulse_fertB_cnt	:= 	Modbus.Teplica_impulse_fertB_cnt+1;
END_IF
*)
tTimerValue_poliv_all	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_poliv_time);
tTimerValue_1_clear	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_clear_time);
tTimerValue_2_fertA	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_fertA_time);
tTimerValue_3_clear	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_finish_clear_time);
tTimerValue_4_fertB	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_fertB_time);

Timer_poliv_all();
Timer_poliv_with_fert();
Timer_1_clear();
Timer_2_fertA();
Timer_3_clear();
Timer_4_fertB();
Timer_valve();
Timer_poliv_finish();
Timer_calc_kf();

TRIG_start_poliv(CLK :=Modbus.Teplica_poliv_active);
TRIG_poliv_break(CLK :=Modbus.Teplica_poliv_break);

TRIG_valve_tank_F(CLK:=HW_water_tank_teplica_level);
TRIG_valve_tank_R(CLK:=HW_water_tank_teplica_level);

IF (Modbus.Teplica_tank_level <1000) THEN
	tank_level_low	:=	TRUE;
	tank_level_high	:=	FALSE;
END_IF
IF (Modbus.Teplica_tank_level >1200) THEN
	tank_level_high	:=	TRUE;
	tank_level_low	:=	FALSE;
END_IF



TRIG_level_tank_low(CLK:= tank_level_low);
TRIG_level_tank_high(CLK:= tank_level_high);

Modbus.Teplica_tank_teplica_level	:=	HW_water_tank_teplica_level;

IF (TRIG_valve_tank_F.Q OR TRIG_level_tank_low.Q ) THEN
	Timer_valve(IN:=NOT Timer_valveQ , PT:=tTimerValue_valve_water , Q=>Timer_valveQ , ET=> );
	HW_valve_pomp_teplica :=	TRUE;
	Modbus.Teplica_valve_water_in		:=	TRUE;
END_IF


IF (TRIG_valve_tank_R.Q	OR Timer_valveQ = TRUE OR TRIG_level_tank_high.Q) THEN
	HW_valve_pomp_teplica :=	FALSE;
	Modbus.Teplica_valve_water_in		:=	FALSE;
	Timer_valveQ	:= FALSE;
	Timer_valve.IN	:= FALSE;
END_IF



IF (TRIG_start_poliv.Q  (*AND Modbus.Teplica_tank_level > 400 *) )   THEN
		pwm_data_A	:=	0;
		pwm_cnt_A	:=	0;
		pwm_avg_A	:=	0;
		pwm_data_B	:=	0;
		pwm_cnt_B	:=	0;
		pwm_avg_B	:=	0;


		Cnt_water_pipe	:=	0;
		Poliv_liters	:=	0;
		FertA_liters	:=	0;
		FertB_liters	:=	0;
		Cnt_water_fertA_start	:=	0;
		Cnt_water_fertB_start	:=	0;
		Cnt_water_finish_clear	:=	0;
		Cnt_water_finish_clear_start		:=	0;
		Modbus.Teplica_impulse_water_cnt	:=	0;
		Modbus.Teplica_impulse_fertA_cnt	:=	0;
		Modbus.Teplica_impulse_fertB_cnt	:=	0;
		Modbus.Teplica_cnt_water_pipe			:=	0;

		Modbus.Teplica_time_elapsed_poliv :=0;
		Modbus.Teplica_time_elapsed_fertA :=0;
		Modbus.Teplica_time_elapsed_fertB :=0;
		max_EC	:=	0;
		Timer_1_clearQ			:= FALSE;
		Timer_2_fertAQ			:= FALSE;
		Timer_3_clearQ			:= FALSE;
		Timer_4_fertBQ			:= FALSE;
		Timer_poliv_finishQ		:= FALSE;
		Timer_calc_kfQ			:=FALSE;
		Bool_poliv_before_fert		:=FALSE;
		Modbus.Teplica_pomp_poliv:=TRUE;

		Timer_poliv_all.IN := FALSE;
		Timer_poliv_with_fert.IN := FALSE;
		Timer_1_clear.IN := FALSE;
		Timer_2_fertA.IN:=FALSE;
		Timer_3_clear.IN := FALSE;
		Timer_4_fertB.IN:=FALSE;
		Timer_calc_kf.IN	:=	FALSE;
		Timer_poliv_finish.IN := FALSE;

		 t_Started_poliv := TIME();
		Timer_poliv_all(IN:=NOT Timer_poliv_allQ , PT:=tTimerValue_poliv_all , Q=>Timer_poliv_allQ , ET=> );
		Timer_poliv_with_fert(IN:=NOT Timer_poliv_with_fertQ , PT:=tTimerValue_poliv_with_fert , Q=>Timer_poliv_with_fertQ , ET=> );
		Timer_1_clear(IN:=NOT Timer_1_clearQ , PT:=tTimerValue_1_clear , Q=>Timer_1_clearQ , ET=> );
		Modbus.Teplica_poliv_status_PLC:=2;
		IF  (Modbus.Teplica_zone_poliv = 0) THEN
			Modbus.Teplica_poliv_message_PLC:=1;
		ELSE
			Modbus.Teplica_poliv_message_PLC:=2;
		END_IF


END_IF

IF (Modbus.Teplica_poliv_status_PLC=2  ) THEN
	Cnt_water_pipe	:=	Modbus.Teplica_cnt_water_pipe;
	Poliv_liters 	:= 	UDINT_TO_REAL(Modbus.Teplica_impulse_water_cnt)/INT_TO_REAL(Modbus.Teplica_poliv_kf);
	FertA_liters	:=	UDINT_TO_REAL(Modbus.Teplica_impulse_fertA_cnt)/INT_TO_REAL(Modbus.Teplica_fertA_kf);
	FertB_liters	:=	UDINT_TO_REAL(Modbus.Teplica_impulse_fertB_cnt)/INT_TO_REAL(Modbus.Teplica_fertB_kf);
	Modbus.Teplica_time_elapsed_poliv :=(TIME_TO_UDINT( TIME() - t_Started_poliv))/1000;

(*	pi_fertA2(fSetpointValue:=setA, fActualValue := actA, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertA, fOut => );
	pi_fertB2(fSetpointValue:=setB, fActualValue :=actB, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertB, fOut => );
	fOutA	:=	pi_fertA2.fOut;
	fOutB	:=	pi_fertB2.fOut;
*)

	IF (Modbus.Teplica_sensor_soil_EC > max_EC) THEN
		max_EC	:=	Modbus.Teplica_sensor_soil_EC;
	END_IF

(* промывка и фертигация   OR Modbus.Teplica_set_poliv_before_fert >Poliv_liters*)

	IF (Modbus.Teplica_type_poliv = TRUE) THEN  (* Полив с фертигацией*)
		IF (NOT Timer_1_clear.Q AND Bool_poliv_before_fert	= FALSE)  THEN
			IF (Modbus.Teplica_type_fert = FALSE) THEN
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
						Modbus.Teplica_poliv_message_PLC:=3;
				ELSE
						Modbus.Teplica_poliv_message_PLC:=4;
				END_IF

			ELSE
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=5;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=6;
				END_IF

			END_IF
		END_IF


		IF ((Timer_1_clear.Q OR Poliv_liters>Modbus.Teplica_set_poliv_before_fert) AND Bool_poliv_before_fert=FALSE) THEN

			Timer_1_clear.IN 		:= FALSE;
			Bool_poliv_before_fert	:= TRUE;
			IF (Modbus.Teplica_type_fert = FALSE) THEN
				 (*Fert A *)
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=7;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=8;
				END_IF

				Modbus.Teplica_pomp_fertA :=  TRUE;  (*включение насоса фертигации из бака А*)
				Timer_2_fertA(IN:=NOT Timer_2_fertAQ , PT:=tTimerValue_2_fertA , Q=>Timer_2_fertAQ , ET=> );
				t_Started_fertA := TIME();
				Cnt_water_fertA_start :=Modbus.Teplica_impulse_water_cnt;
				Cnt_water_calc_kf_start	:=Poliv_liters;
				Cnt_fertA_calc_kf_start:=FertA_liters;

				Modbus.Teplica_pomp_fertB :=  TRUE;   (*включение насоса фертигации из бака B*)

				Cnt_water_fertB_start :=Modbus.Teplica_impulse_water_cnt;
				Cnt_fertB_calc_kf_start:=FertB_liters;

			END_IF
		END_IF

		IF ( (Timer_2_fertA.Q OR FertA_liters > Modbus.Teplica_set_fertA) AND Modbus.Teplica_pomp_fertA =  TRUE) THEN
			 (*start finish clear *)
			IF  (Modbus.Teplica_zone_poliv = 0) THEN
				Modbus.Teplica_poliv_message_PLC:=11;
			ELSE
				Modbus.Teplica_poliv_message_PLC:=12;
			END_IF

			Modbus.Teplica_pomp_fertA :=  FALSE; (*отключение насоса фертигации из бака А*)
			Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
			Modbus.Cnt_water_fertA	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertA_start;

			Modbus.Teplica_pomp_fertB :=  FALSE; (*отключение насоса фертигации из бака B*)
			Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
			Modbus.Cnt_water_fertB	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertB_start;


			Timer_2_fertA.IN:=FALSE;
			Cnt_water_finish_clear_start		:=	Modbus.Teplica_impulse_water_cnt;
			Timer_3_clear(IN:=NOT Timer_3_clearQ , PT:=tTimerValue_3_clear , Q=>Timer_3_clearQ , ET=> );

		END_IF

		IF  (Modbus.Teplica_pomp_fertA =  TRUE) THEN
			actA		:=	1/Kf_calc_fertA;
			pi_fertA2(fSetpointValue:=setA, fActualValue := actA, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertA, fOut => );
			fOutA	:=	pi_fertA2.fOut;
			Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
			Modbus.Cnt_water_fertA	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertA_start;


			actB		:=	1/Kf_calc_fertB;
			pi_fertB2(fSetpointValue:=setB, fActualValue :=actB, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertB, fOut => );
			fOutB	:=	pi_fertB2.fOut;
			Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
			Modbus.Cnt_water_fertB	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertB_start;

			Timer_calc_kf(IN:=NOT Timer_calc_kfQ , PT:=t#4s , Q=>Timer_calc_kfQ , ET=> );

			IF (Timer_calc_kf.Q)	THEN
			(*	vol_water	:=	Poliv_liters-Cnt_water_calc_kf_start *);
				vol_water	:=	0.46666;
				vol_fertA		:=	FertA_liters-Cnt_fertA_calc_kf_start;
				vol_fertB		:=	FertB_liters-Cnt_fertB_calc_kf_start;

				IF (vol_fertA > 0 ) THEN
					Kf_calc_fertA	:= 	 vol_water/vol_fertA;
				ELSE
					Kf_calc_fertA	:=	Modbus.Teplica_fert_kf;
				END_IF

				IF (vol_fertB > 0 ) THEN
					Kf_calc_fertB	:= 	 vol_water/vol_fertB;
				ELSE
					Kf_calc_fertB	:=	Modbus.Teplica_fert_kf;
				END_IF

				Cnt_water_calc_kf_start	:=Poliv_liters;
				Cnt_fertA_calc_kf_start:=FertA_liters;
				Cnt_fertB_calc_kf_start:=FertB_liters;

				Timer_calc_kfQ	:=	FALSE;
				Timer_calc_kf.IN	:=	FALSE;


			END_IF

			fert_pwm_levelA	:=	 REAL_TO_UINT(fOutA);
			pwm_data_A		:=	pwm_data_A + fert_pwm_levelA;
			pwm_cnt_A		:=	pwm_cnt_A + 1;
			pwm_avg_A		:=	pwm_data_A / pwm_cnt_A;

			fert_pwm_levelB	:=	 REAL_TO_UINT(fOutB);
			pwm_data_B		:=	pwm_data_B + fert_pwm_levelB;
			pwm_cnt_B		:=	pwm_cnt_B + 1;
			pwm_avg_B		:=	pwm_data_B / pwm_cnt_B;


		ELSE
			fert_pwm_levelA	:=	0;
			fert_pwm_levelB	:=	0;

		END_IF





		IF (Modbus.Teplica_poliv_message_PLC =11 OR Modbus.Teplica_poliv_message_PLC = 12 OR Modbus.Teplica_poliv_message_PLC = 13  OR Modbus.Teplica_poliv_message_PLC = 14) THEN
			Cnt_water_finish_clear	:=	UDINT_TO_REAL(Modbus.Teplica_impulse_water_cnt-Cnt_water_finish_clear_start)/Modbus.Teplica_poliv_kf;
		END_IF


		IF (Timer_poliv_with_fert.Q=TRUE OR   Modbus.Teplica_poliv_break=TRUE OR Timer_3_clear.Q=TRUE OR Cnt_water_finish_clear > Modbus.Teplica_set_finish_clear_vol  )THEN


			Modbus.Teplica_max_EC		:=	max_EC;

			Modbus.Teplica_poliv_active:= FALSE;
			Modbus.Teplica_pomp_poliv:=FALSE;
			Modbus.Teplica_pomp_fertA :=  FALSE;
			Modbus.Teplica_pomp_fertB :=  FALSE;
			Timer_poliv_all.IN := FALSE;
			Timer_poliv_with_fert.IN := FALSE;
			Timer_1_clear.IN := FALSE;
			Timer_2_fertA.IN:=FALSE;
			Timer_3_clear.IN := FALSE;
			Timer_4_fertB.IN:=FALSE;
			Timer_calc_kf.IN	:=	FALSE;
			Timer_1_clearQ			:= FALSE;
			Timer_2_fertAQ			:= FALSE;
			Timer_3_clearQ			:= FALSE;
			Timer_4_fertBQ			:= FALSE;

			IF (Modbus.Teplica_type_fert = FALSE) THEN
				 (*finished poliv with fert A*)
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=15;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=16;
				END_IF

			ELSE
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=17;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=18;
				END_IF

			END_IF

			Modbus.Teplica_poliv_status_PLC :=  10;
			Timer_poliv_finish(IN:=NOT Timer_poliv_finishQ, PT:=tTimerValue_poliv_finish , Q=>Timer_poliv_finishQ , ET=> );
		END_IF
		ELSE
			fert_pwm_levelA:=0;
			fert_pwm_levelB:=0;
	END_IF

	IF (Modbus.Teplica_type_poliv = FALSE) THEN (*Полив без фертигации*)
		IF (Timer_poliv_all.Q=TRUE OR (Poliv_liters > Modbus.Teplica_set_poliv)  OR Modbus.Teplica_poliv_break=TRUE   )THEN
			(*finished only poliv *)
			IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=19;
			ELSE
					Modbus.Teplica_poliv_message_PLC:=20;
			END_IF

			Modbus.Teplica_poliv_active:= FALSE;
			Modbus.Teplica_pomp_poliv:=FALSE;
			Modbus.Teplica_pomp_fertA :=  FALSE;
			Modbus.Teplica_pomp_fertB :=  FALSE;
			Timer_poliv_all.IN := FALSE;
			Timer_poliv_with_fert.IN := FALSE;
			Timer_1_clear.IN := FALSE;
			Timer_2_fertA.IN:=FALSE;
			Timer_3_clear.IN := FALSE;
			Timer_4_fertB.IN:=FALSE;
			Timer_1_clearQ			:= FALSE;
			Timer_2_fertAQ			:= FALSE;
			Timer_3_clearQ			:= FALSE;
			Timer_4_fertBQ			:= FALSE;
			Modbus.Teplica_poliv_status_PLC :=  10;
		END_IF
	END_IF
	ELSE
		fert_pwm_levelA:=0;
		fert_pwm_levelB:=0;
END_IF

Modbus.Teplica_fert_actA			:=	Kf_calc_fertA;
Modbus.Teplica_fert_actB			:=	Kf_calc_fertB;
Modbus.Teplica_fert_pwm_levelA	:=	REAL_TO_INT(100*fert_pwm_levelA/32765);
Modbus.Teplica_fert_pwm_levelB	:=	REAL_TO_INT(100*fert_pwm_levelB/32765);
Modbus.Teplica_pwm_avg_A		:=	REAL_TO_INT(100*pwm_avg_A/32765);
Modbus.Teplica_pwm_avg_B		:=	REAL_TO_INT(100*pwm_avg_B/32765);









(*LIGHT TEPLICA *)

IF (Modbus.Teplica_light = FALSE OR anti_hum_light = TRUE) THEN

(*	IF ((Modbus.Teplica_avg_lux > Modbus.Teplica_light_set_low+gisterezis_lux OR Modbus.Teplica_temp_air>25) OR Modbus.Teplica_light_allow = FALSE  ) THEN
		Modbus.Teplica_light :=FALSE;
		HW_teplica_light		:=	FALSE;
	END_IF
*)
	IF ((Modbus.Teplica_avg_lux <  Modbus.Teplica_light_set_low-gisterezis_lux  AND Modbus.Teplica_temp_air<27) AND Modbus.Teplica_light_allow ) THEN
		Modbus.Teplica_light:=TRUE;
		HW_teplica_light		:=	TRUE;
	END_IF

	IF anti_hum_light = TRUE THEN
		Modbus.Teplica_light:=TRUE;
		HW_teplica_light		:=	TRUE;
	END_IF

END_IF

IF (Modbus.Teplica_light = TRUE AND anti_hum_light = FALSE ) THEN

	IF ((Modbus.Teplica_avg_lux  >  Modbus.Teplica_light_set_low+gisterezis_lux  OR Modbus.Teplica_temp_air>28) OR Modbus.Teplica_light_allow = FALSE  ) THEN
		Modbus.Teplica_light :=FALSE;
		HW_teplica_light		:=	FALSE;
	END_IF


END_IF



(*HEAT TEPLICA *)

	IF ((Modbus.Teplica_temp_air > Modbus.Teplica_temp_set_low+1) ) THEN
		Modbus.Teplica_heat :=FALSE;
		HW_teplica_heat		:= FALSE;
	END_IF

	IF ((Modbus.Teplica_temp_air <  Modbus.Teplica_temp_set_low-1 ) ) THEN
		Modbus.Teplica_heat:=TRUE;
		HW_teplica_heat		:=	TRUE;
	END_IF


(*HEAT TANK TEPLICA *)

	IF ((Modbus.Teplica_temp_water_tank > Modbus.Teplica_set_temp_tank+1)  OR HW_teplica_heat = TRUE  OR HW_water_tank_teplica_level = FALSE  (* OR Modbus.Teplica_tank_level < 400 *) ) THEN
		Modbus.Teplica_tank_heat :=FALSE;
	(*	HW_teplica_tank_heat		:= FALSE; *)
	END_IF

	IF ((Modbus.Teplica_temp_water_tank <  Modbus.Teplica_set_temp_tank-1 ) AND HW_teplica_heat = FALSE  AND HW_water_tank_teplica_level = TRUE  (*AND Modbus.Teplica_tank_level > 400 *)) THEN
		Modbus.Teplica_tank_heat:=TRUE;
	(*	HW_teplica_tank_heat		:=	TRUE; *)
	END_IF




(*VENT  TEPLICA *)

(* 1. КРИТИЧЕСКИЙ ХОЛОД: Если внутри ниже +12, выключаем всё принудительно *)
IF (Modbus.Teplica_temp_air < 12) THEN
    Modbus.Teplica_vent := FALSE;
    HW_teplica_vent     := FALSE;
    anti_hum_light      := FALSE;

(* 2. НОЧНОЙ РЕЖИМ (ВЛАЖНОСТЬ) С ГИСТЕРЕЗИСОМ: *)
(* Включаем свет при >85%. Но если он УЖЕ горит, то держим его включенным, пока влажность выше 80% *)
ELSIF (Modbus.Teplica_hum_SHT30 > 85) OR (anti_hum_light AND (Modbus.Teplica_hum_SHT30 > 80)) THEN
    anti_hum_light      := TRUE;  (* Включаем/держим 2кВт LED для сушки *)
    Modbus.Teplica_vent := FALSE; (* Вытяжка принудительно выключена *)
    HW_teplica_vent     := FALSE;

(* 3. ШТАТНЫЙ РЕЖИМ: Если влажность упала ниже 80% *)
ELSE
    anti_hum_light      := FALSE; (* Выключаем свет сушки *)
    
    (* Четкий гистерезис вентиляции по температуре *)
    IF (Modbus.Teplica_temp_air < Modbus.Teplica_temp_set_high - 1) THEN
        Modbus.Teplica_vent := FALSE;
        HW_teplica_vent     := FALSE;
        
    ELSIF (Modbus.Teplica_temp_air > Modbus.Teplica_temp_set_high + 1) THEN
        Modbus.Teplica_vent := TRUE;
        HW_teplica_vent     := TRUE;
    END_IF
END_IF



	IF (Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_window_open-1 ) THEN
	(*	HW_teplica_window_opener		:=FALSE; *)
		Modbus.Teplica_window_opener	:=FALSE;
	END_IF
	IF (Modbus.Teplica_temp_air >  Modbus.Teplica_set_temp_window_open+1 AND   Modbus.Street_temp > 0 ) THEN
	(*	HW_teplica_window_opener		:=TRUE; *)
		Modbus.Teplica_window_opener	:=TRUE;
	END_IF


	IF (Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_pomp_cold-1  OR Modbus.Street_hum >71  ) THEN
	(*	HW_teplica_pomp_cold		:=FALSE; *)
		Modbus.Teplica_pomp_cold	:=FALSE;
	END_IF
	IF (Modbus.Teplica_temp_air >  Modbus.Teplica_set_temp_pomp_cold+1 AND   Modbus.Street_temp >10  AND Modbus.Street_hum <  69) THEN
	(*	HW_teplica_pomp_cold		:=TRUE; *)
		Modbus.Teplica_pomp_cold	:=TRUE;
	END_IF






END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '8, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM teplica_new_2025
VAR
	Cnt_water_fertA_start	:	UDINT;
	Cnt_water_fertB_start	:	UDINT;
	Cnt_water_finish_clear_start	:	UDINT;
	Cnt_water_finish_clear	:		REAL;
	t_Started_poliv			:	TIME;
	t_Started_fertA			:	TIME;
	t_Started_fertB			:	TIME;


	Timer_poliv_all			: TON;
	Timer_poliv_allQ			: BOOL;

	Timer_1_clear			: TON;
	Timer_2_fertA				: TON;
	Timer_3_clear			: TON;
	Timer_4_fertB				: TON;
	Timer_poliv_with_fert		: TON;
	Timer_poliv_finish			: TON;

	Timer_calc_kf			: TON;
	Timer_calc_kfQ			:BOOL;
	Cnt_water_calc_kf_start		:REAL;
	Cnt_fertA_calc_kf_start		:REAL;
	Cnt_fertB_calc_kf_start		:REAL;
	Kf_calc_fertA				: REAL:=12;
	Kf_calc_fertB				: REAL:=12;
	vol_water				: REAL;
	vol_fertA					: REAL;
	vol_fertB					: REAL;

	Timer_poliv_finishQ		: BOOL;
	Timer_1_clearQ			: BOOL;
	Timer_2_fertAQ			: BOOL;
	Timer_3_clearQ			: BOOL;
	Timer_4_fertBQ			: BOOL;



	 tTimerValue_poliv_all		: TIME:=t#60s;  (* Максимальное время полива*)
	 tTimerValue_1_clear		: TIME:=t#10s;  (* Промывка перед 1 фертигацией*)
	 tTimerValue_2_fertA		: TIME:=t#30s;  (* Ограничение фертигации из бака А*)
	 tTimerValue_3_clear		: TIME:=t#60s;  (* Промывка перед OFF*)
	 tTimerValue_4_fertB		: TIME:=t#10s;  (* Ограничение фертигации из бака Б*)
	 tTimerValue_poliv_with_fert	: TIME:=t#60m;  (* Ограничение полива с фертигацией *)
	 tTimerValue_poliv_finish	: TIME:=t#3s;  (*Пауза перед статусом завршения полива для обновления регистров *)

	Timer_valve				: TON;
	Timer_valveQ			: BOOL;
	 tTimerValue_valve_water	: TIME:=t#60m;  (* Максимальное время открытия клапана подачи воды в теплицу*)

	TRIG_start_poliv			:	R_TRIG;
	TRIG_valve_tank_F		:	F_TRIG;
	TRIG_valve_tank_R		:	R_TRIG;

	TRIG_level_tank_low		:	R_TRIG;
	TRIG_level_tank_high		:	R_TRIG;

	Timer_light_avg			: TON;
	 tTimer_light_avg			: TIME:=t#1m;
	Timer_light_avgQ			: BOOL;
	Bool_poliv_before_fert		: 	BOOL;

	TRIG_poliv_break			:	R_TRIG;


	FertA_liters				:	REAL;
	FertB_liters				:	REAL;
	gisterezis_lux				:	INT:=1000;
(*	Poliv_before_fert			:	INT:=0; *)
	Timer_poliv_with_fertQ		: 	BOOL;


	max_EC					:	REAL;
	pi_fertA2 			: FB_CTRL_PI;
	pi_fertB2 			: FB_CTRL_PI;

	set_kf_fert		: INT:=12;
	start_cfg_pi_par	:BOOL;
	setA, setB, actA, actB, fOutA, fOutB	:REAL;

	avg_light_ma			: FB_CTRL_MOVING_AVERAGE;
	stParams_avg_light	: ST_CTRL_MOVING_AVERAGE_PARAMS;


	start_cfg_avg_light			:BOOL;

	avg_light					: REAL;
	arr_table					: ARRAY[1..20] OF FLOAT;
	Cnt_water_pipe			:UDINT;
	pwm_data_A	: REAL;
	pwm_cnt_A	: UDINT;
	pwm_avg_A	: REAL;
	pwm_data_B	: REAL;
	pwm_cnt_B	: UDINT;
	pwm_avg_B	: REAL;
	tank_level_low	:BOOL;
	tank_level_high	:BOOL;

END_VAR
(* @END_DECLARATION := '0' *)

IF NOT start_cfg_avg_light THEN

	stParams_avg_light.tCtrlCycleTime			:= T#60s;
	stParams_avg_light.tTaskCycleTime 			:= T#10ms;
	stParams_avg_light.nSamplesToFilter		:= 20;
	stParams_avg_light.pWorkArray_ADR		:= ADR(arr_table);
	stParams_avg_light.nWorkArray_SIZEOF		:= SIZEOF(arr_table);
	start_cfg_avg_light							:= TRUE;
END_IF

avg_light_ma(fIn:=Modbus.Teplica_light_lux, fManSyncValue :=0, bSync:=0, eMode:=eCTRL_MODE_ACTIVE,bHold:=0, stParams:=stParams_avg_light,  fOut =>avg_light);
Modbus.Teplica_avg_lux	:=	avg_light;


start_cfg_pi_par:=	FALSE;
IF NOT start_cfg_pi_par THEN


	pi_par_fertA.bARWOnIPartOnly:=0;
	pi_par_fertA.fKp:=300000*0.7;
	pi_par_fertA.fOutMaxLimit:=32765*0.7;
	pi_par_fertA.fOutMinLimit:=32765*0.25;

(*	pi_par_fertA.fOutMinLimit:=16800; *)
(*	pi_par_fertA.fOutMinLimit:=13100; *)
(*	pi_par_fertA.fOutMinLimit:=11460; *)
	pi_par_fertA.tCtrlCycleTime:=T#4s;
	pi_par_fertA.tTaskCycleTime:=T#10ms;
	pi_par_fertA.tTn:=T#8s;

	pi_par_fertB.bARWOnIPartOnly:=0;
	pi_par_fertB.fKp:=300000*0.7;
	pi_par_fertB.fOutMaxLimit:=32765*0.7;
	pi_par_fertB.fOutMinLimit:=32765*0.25;
(*	pi_par_fertB.fOutMinLimit:=16800; *)
(*	pi_par_fertB.fOutMinLimit:=13100; *)
(*	pi_par_fertA.fOutMinLimit:=11460; *)
	pi_par_fertB.tCtrlCycleTime:=T#4s;
	pi_par_fertB.tTaskCycleTime:=T#10ms;
	pi_par_fertB.tTn:=T#8s;

	start_cfg_pi_par			:=	TRUE;

END_IF


IF (Kf_calc_fertA = 0) THEN
	Kf_calc_fertA := 48;
END_IF
IF (Kf_calc_fertB = 0) THEN
	Kf_calc_fertB := 48;
END_IF
IF (Modbus.Teplica_fert_kf = 0) THEN
	Modbus.Teplica_fert_kf := 48;
END_IF

CASE Modbus.Teplica_fert_kf OF

64:
		pi_par_fertA.fOutMaxLimit:=32765*0.4;
		pi_par_fertA.fOutMinLimit:=32765*0.3;
		pi_par_fertB.fOutMaxLimit:=32765*0.5;
		pi_par_fertB.fOutMinLimit:=32765*0.4;

48:
		pi_par_fertA.fOutMaxLimit:=32765*0.45;
		pi_par_fertA.fOutMinLimit:=32765*0.35;
		pi_par_fertB.fOutMaxLimit:=32765*0.55;
		pi_par_fertB.fOutMinLimit:=32765*0.45;


32:
		pi_par_fertA.fOutMaxLimit:=32765*0.6;
		pi_par_fertA.fOutMinLimit:=32765*0.45;
		pi_par_fertB.fOutMaxLimit:=32765*0.7;
		pi_par_fertB.fOutMinLimit:=32765*0.5;


END_CASE


setA		:=	1/INT_TO_REAL(Modbus.Teplica_fert_kf);

setB		:=	1/INT_TO_REAL(Modbus.Teplica_fert_kf);


(*
Trigger_water_impulse_teplica(CLK:=HW_impulse_water_teplica);
Trigger_fertA_impulse_teplica(CLK:=HW_impulse_fertA_teplica);
Trigger_fertB_impulse_teplica(CLK:=HW_impulse_fertB_teplica);

IF Trigger_water_impulse_teplica.Q THEN
	Modbus.Teplica_impulse_water_cnt	:= 	Modbus.Teplica_impulse_water_cnt+1;
END_IF


IF Trigger_fertA_impulse_teplica.Q THEN
	Modbus.Teplica_impulse_fertA_cnt	:= 	Modbus.Teplica_impulse_fertA_cnt+1;
END_IF
IF Trigger_fertB_impulse_teplica.Q THEN
	Modbus.Teplica_impulse_fertB_cnt	:= 	Modbus.Teplica_impulse_fertB_cnt+1;
END_IF
*)
tTimerValue_poliv_all	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_poliv_time);
tTimerValue_1_clear	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_clear_time);
tTimerValue_2_fertA	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_fertA_time);
tTimerValue_3_clear	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_finish_clear_time);
tTimerValue_4_fertB	:=	UDINT_TO_TIME(60*1000*Modbus.Teplica_set_max_fertB_time);

Timer_poliv_all();
Timer_poliv_with_fert();
Timer_1_clear();
Timer_2_fertA();
Timer_3_clear();
Timer_4_fertB();
Timer_valve();
Timer_poliv_finish();
Timer_calc_kf();

TRIG_start_poliv(CLK :=Modbus.Teplica_poliv_active);
TRIG_poliv_break(CLK :=Modbus.Teplica_poliv_break);

TRIG_valve_tank_F(CLK:=HW_water_tank_teplica_level);
TRIG_valve_tank_R(CLK:=HW_water_tank_teplica_level);

IF (Modbus.Teplica_tank_level <1000) THEN
	tank_level_low	:=	TRUE;
	tank_level_high	:=	FALSE;
END_IF
IF (Modbus.Teplica_tank_level >1200) THEN
	tank_level_high	:=	TRUE;
	tank_level_low	:=	FALSE;
END_IF



TRIG_level_tank_low(CLK:= tank_level_low);
TRIG_level_tank_high(CLK:= tank_level_high);

Modbus.Teplica_tank_teplica_level	:=	HW_water_tank_teplica_level;

IF (TRIG_valve_tank_F.Q OR TRIG_level_tank_low.Q ) THEN
	Timer_valve(IN:=NOT Timer_valveQ , PT:=tTimerValue_valve_water , Q=>Timer_valveQ , ET=> );
	HW_valve_pomp_teplica :=	TRUE;
	Modbus.Teplica_valve_water_in		:=	TRUE;
END_IF


IF (TRIG_valve_tank_R.Q	OR Timer_valveQ = TRUE OR TRIG_level_tank_high.Q) THEN
	HW_valve_pomp_teplica :=	FALSE;
	Modbus.Teplica_valve_water_in		:=	FALSE;
	Timer_valveQ	:= FALSE;
	Timer_valve.IN	:= FALSE;
END_IF



IF (TRIG_start_poliv.Q  AND Modbus.Teplica_tank_level > 400 )   THEN
		pwm_data_A	:=	0;
		pwm_cnt_A	:=	0;
		pwm_avg_A	:=	0;
		pwm_data_B	:=	0;
		pwm_cnt_B	:=	0;
		pwm_avg_B	:=	0;


		Cnt_water_pipe	:=	0;
		Poliv_liters	:=	0;
		FertA_liters	:=	0;
		FertB_liters	:=	0;
		Cnt_water_fertA_start	:=	0;
		Cnt_water_fertB_start	:=	0;
		Cnt_water_finish_clear	:=	0;
		Cnt_water_finish_clear_start		:=	0;
		Modbus.Teplica_impulse_water_cnt	:=	0;
		Modbus.Teplica_impulse_fertA_cnt	:=	0;
		Modbus.Teplica_impulse_fertB_cnt	:=	0;
		Modbus.Teplica_cnt_water_pipe			:=	0;

		Modbus.Teplica_time_elapsed_poliv :=0;
		Modbus.Teplica_time_elapsed_fertA :=0;
		Modbus.Teplica_time_elapsed_fertB :=0;
		max_EC	:=	0;
		Timer_1_clearQ			:= FALSE;
		Timer_2_fertAQ			:= FALSE;
		Timer_3_clearQ			:= FALSE;
		Timer_4_fertBQ			:= FALSE;
		Timer_poliv_finishQ		:= FALSE;
		Timer_calc_kfQ			:=FALSE;
		Bool_poliv_before_fert		:=FALSE;
		Modbus.Teplica_pomp_poliv:=TRUE;

		Timer_poliv_all.IN := FALSE;
		Timer_poliv_with_fert.IN := FALSE;
		Timer_1_clear.IN := FALSE;
		Timer_2_fertA.IN:=FALSE;
		Timer_3_clear.IN := FALSE;
		Timer_4_fertB.IN:=FALSE;
		Timer_calc_kf.IN	:=	FALSE;
		Timer_poliv_finish.IN := FALSE;

		 t_Started_poliv := TIME();
		Timer_poliv_all(IN:=NOT Timer_poliv_allQ , PT:=tTimerValue_poliv_all , Q=>Timer_poliv_allQ , ET=> );
		Timer_poliv_with_fert(IN:=NOT Timer_poliv_with_fertQ , PT:=tTimerValue_poliv_with_fert , Q=>Timer_poliv_with_fertQ , ET=> );
		Timer_1_clear(IN:=NOT Timer_1_clearQ , PT:=tTimerValue_1_clear , Q=>Timer_1_clearQ , ET=> );
		Modbus.Teplica_poliv_status_PLC:=2;
		IF  (Modbus.Teplica_zone_poliv = 0) THEN
			Modbus.Teplica_poliv_message_PLC:=1;
		ELSE
			Modbus.Teplica_poliv_message_PLC:=2;
		END_IF


END_IF

IF (Modbus.Teplica_poliv_status_PLC=2  ) THEN
	Cnt_water_pipe	:=	Modbus.Teplica_cnt_water_pipe;
	Poliv_liters 	:= 	UDINT_TO_REAL(Modbus.Teplica_impulse_water_cnt)/INT_TO_REAL(Modbus.Teplica_poliv_kf);
	FertA_liters	:=	UDINT_TO_REAL(Modbus.Teplica_impulse_fertA_cnt)/INT_TO_REAL(Modbus.Teplica_fertA_kf);
	FertB_liters	:=	UDINT_TO_REAL(Modbus.Teplica_impulse_fertB_cnt)/INT_TO_REAL(Modbus.Teplica_fertB_kf);
	Modbus.Teplica_time_elapsed_poliv :=(TIME_TO_UDINT( TIME() - t_Started_poliv))/1000;

(*	pi_fertA2(fSetpointValue:=setA, fActualValue := actA, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertA, fOut => );
	pi_fertB2(fSetpointValue:=setB, fActualValue :=actB, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertB, fOut => );
	fOutA	:=	pi_fertA2.fOut;
	fOutB	:=	pi_fertB2.fOut;
*)

	IF (Modbus.Teplica_sensor_soil_EC > max_EC) THEN
		max_EC	:=	Modbus.Teplica_sensor_soil_EC;
	END_IF

(* промывка и фертигация   OR Modbus.Teplica_set_poliv_before_fert >Poliv_liters*)

	IF (Modbus.Teplica_type_poliv = TRUE) THEN  (* Полив с фертигацией*)
		IF (NOT Timer_1_clear.Q AND Bool_poliv_before_fert	= FALSE)  THEN
			IF (Modbus.Teplica_type_fert = FALSE) THEN
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
						Modbus.Teplica_poliv_message_PLC:=3;
				ELSE
						Modbus.Teplica_poliv_message_PLC:=4;
				END_IF

			ELSE
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=5;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=6;
				END_IF

			END_IF
		END_IF


		IF ((Timer_1_clear.Q OR Poliv_liters>Modbus.Teplica_set_poliv_before_fert) AND Bool_poliv_before_fert=FALSE) THEN

			Timer_1_clear.IN 		:= FALSE;
			Bool_poliv_before_fert	:= TRUE;
			IF (Modbus.Teplica_type_fert = FALSE) THEN
				 (*Fert A *)
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=7;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=8;
				END_IF

				Modbus.Teplica_pomp_fertA :=  TRUE;  (*включение насоса фертигации из бака А*)
				Timer_2_fertA(IN:=NOT Timer_2_fertAQ , PT:=tTimerValue_2_fertA , Q=>Timer_2_fertAQ , ET=> );
				t_Started_fertA := TIME();
				Cnt_water_fertA_start :=Modbus.Teplica_impulse_water_cnt;
				Cnt_water_calc_kf_start	:=Poliv_liters;
				Cnt_fertA_calc_kf_start:=FertA_liters;

			ELSE
				 (*Fert B *)
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=9;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=10;
				END_IF

				Modbus.Teplica_pomp_fertB :=  TRUE;   (*включение насоса фертигации из бака B*)
				Timer_4_fertB(IN:=NOT Timer_4_fertBQ , PT:=tTimerValue_4_fertB , Q=>Timer_4_fertBQ , ET=> );
				t_Started_fertB := TIME();
				Cnt_water_fertB_start :=Modbus.Teplica_impulse_water_cnt;
				Cnt_water_calc_kf_start	:=Poliv_liters;
				Cnt_fertB_calc_kf_start:=FertB_liters;

			END_IF
		END_IF
		IF ( (Timer_2_fertA.Q OR FertA_liters > Modbus.Teplica_set_fertA) AND Modbus.Teplica_pomp_fertA =  TRUE) THEN
			 (*start finish clear *)
			IF  (Modbus.Teplica_zone_poliv = 0) THEN
				Modbus.Teplica_poliv_message_PLC:=11;
			ELSE
				Modbus.Teplica_poliv_message_PLC:=12;
			END_IF

			Modbus.Teplica_pomp_fertA :=  FALSE; (*отключение насоса фертигации из бака А*)
			Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
			Modbus.Cnt_water_fertA	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertA_start;
			Timer_2_fertA.IN:=FALSE;
			Cnt_water_finish_clear_start		:=	Modbus.Teplica_impulse_water_cnt;
			Timer_3_clear(IN:=NOT Timer_3_clearQ , PT:=tTimerValue_3_clear , Q=>Timer_3_clearQ , ET=> );
		END_IF
		IF ( (Timer_4_fertB.Q OR FertB_liters > Modbus.Teplica_set_fertB) AND Modbus.Teplica_pomp_fertB =  TRUE ) THEN
			 (*start finish clear *)
			IF  (Modbus.Teplica_zone_poliv = 0) THEN
				Modbus.Teplica_poliv_message_PLC:=13;
			ELSE
				Modbus.Teplica_poliv_message_PLC:=14;
			END_IF

			Modbus.Teplica_pomp_fertB :=  FALSE; (*отключение насоса фертигации из бака B*)
			Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
			Modbus.Cnt_water_fertB	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertB_start;

			Timer_4_fertB.IN:=FALSE;
			Cnt_water_finish_clear_start		:=	Modbus.Teplica_impulse_water_cnt;
			Timer_3_clear(IN:=NOT Timer_3_clearQ , PT:=tTimerValue_3_clear , Q=>Timer_3_clearQ , ET=> );
		END_IF

		IF  (Modbus.Teplica_pomp_fertA =  TRUE) THEN
			actA		:=	1/Kf_calc_fertA;
			pi_fertA2(fSetpointValue:=setA, fActualValue := actA, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertA, fOut => );
			fOutA	:=	pi_fertA2.fOut;
			Modbus.Teplica_time_elapsed_fertA :=(TIME_TO_UDINT( TIME() - t_Started_fertA))/1000;
			Modbus.Cnt_water_fertA	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertA_start;
			Timer_calc_kf(IN:=NOT Timer_calc_kfQ , PT:=t#4s , Q=>Timer_calc_kfQ , ET=> );
			IF (Timer_calc_kf.Q)	THEN
				vol_water	:=	Poliv_liters-Cnt_water_calc_kf_start;
				vol_fertA		:=	FertA_liters-Cnt_fertA_calc_kf_start;
				IF (vol_fertA > 0 ) THEN
					Kf_calc_fertA	:= 	 vol_water/vol_fertA;
				ELSE
					Kf_calc_fertA	:=	1000;
				END_IF
				Cnt_water_calc_kf_start	:=Poliv_liters;
				Cnt_fertA_calc_kf_start:=FertA_liters;
				Timer_calc_kfQ	:=	FALSE;
				Timer_calc_kf.IN	:=	FALSE;
			END_IF
			fert_pwm_levelA	:=	 REAL_TO_UINT(fOutA);
(*			IF (vol_fertA>0.05 ) THEN *)
				pwm_data_A		:=	pwm_data_A + fert_pwm_levelA;
				pwm_cnt_A		:=	pwm_cnt_A + 1;
				pwm_avg_A		:=	pwm_data_A / pwm_cnt_A;
(*			END_IF *)
		ELSE
			fert_pwm_levelA	:=	0;

		END_IF



		IF (Modbus.Teplica_pomp_fertB =  TRUE) THEN
			actB		:=	1/Kf_calc_fertB;
			pi_fertB2(fSetpointValue:=setB, fActualValue :=actB, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_fertB, fOut => );
			fOutB	:=	pi_fertB2.fOut;
			Modbus.Teplica_time_elapsed_fertB :=(TIME_TO_UDINT( TIME() - t_Started_fertB))/1000;
			Modbus.Cnt_water_fertB	:=	Modbus.Teplica_impulse_water_cnt -Cnt_water_fertB_start;
			Timer_calc_kf(IN:=NOT Timer_calc_kfQ , PT:=t#4s , Q=>Timer_calc_kfQ , ET=> );
			IF (Timer_calc_kf.Q)	THEN
				vol_water	:=	Poliv_liters-Cnt_water_calc_kf_start;
				vol_fertB		:=	FertB_liters-Cnt_fertB_calc_kf_start;
				IF (vol_fertB > 0 ) THEN
					Kf_calc_fertB	:= 	 vol_water/vol_fertB;
				ELSE
					Kf_calc_fertB	:=	1000;
				END_IF

				Cnt_water_calc_kf_start	:=Poliv_liters;
				Cnt_fertB_calc_kf_start:=FertB_liters;
				Timer_calc_kfQ	:=	FALSE;
				Timer_calc_kf.IN	:=	FALSE;
			END_IF
			fert_pwm_levelB	:=	 REAL_TO_UINT(fOutB);
(*			IF (vol_fertB>0.05 ) THEN *)
				pwm_data_B		:=	pwm_data_B + fert_pwm_levelB;
				pwm_cnt_B		:=	pwm_cnt_B + 1;
				pwm_avg_B		:=	pwm_data_B / pwm_cnt_B;
(*			END_IF *)
		ELSE
			fert_pwm_levelB	:=	0;

		END_IF


		IF (Modbus.Teplica_poliv_message_PLC =11 OR Modbus.Teplica_poliv_message_PLC = 12 OR Modbus.Teplica_poliv_message_PLC = 13  OR Modbus.Teplica_poliv_message_PLC = 14) THEN
			Cnt_water_finish_clear	:=	UDINT_TO_REAL(Modbus.Teplica_impulse_water_cnt-Cnt_water_finish_clear_start)/Modbus.Teplica_poliv_kf;
		END_IF


		IF (Timer_poliv_with_fert.Q=TRUE OR   Modbus.Teplica_poliv_break=TRUE OR Timer_3_clear.Q=TRUE OR Cnt_water_finish_clear > Modbus.Teplica_set_finish_clear_vol  )THEN


			Modbus.Teplica_max_EC		:=	max_EC;

			Modbus.Teplica_poliv_active:= FALSE;
			Modbus.Teplica_pomp_poliv:=FALSE;
			Modbus.Teplica_pomp_fertA :=  FALSE;
			Modbus.Teplica_pomp_fertB :=  FALSE;
			Timer_poliv_all.IN := FALSE;
			Timer_poliv_with_fert.IN := FALSE;
			Timer_1_clear.IN := FALSE;
			Timer_2_fertA.IN:=FALSE;
			Timer_3_clear.IN := FALSE;
			Timer_4_fertB.IN:=FALSE;
			Timer_calc_kf.IN	:=	FALSE;
			Timer_1_clearQ			:= FALSE;
			Timer_2_fertAQ			:= FALSE;
			Timer_3_clearQ			:= FALSE;
			Timer_4_fertBQ			:= FALSE;

			IF (Modbus.Teplica_type_fert = FALSE) THEN
				 (*finished poliv with fert A*)
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=15;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=16;
				END_IF

			ELSE
				IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=17;
				ELSE
					Modbus.Teplica_poliv_message_PLC:=18;
				END_IF

			END_IF

			Modbus.Teplica_poliv_status_PLC :=  10;
			Timer_poliv_finish(IN:=NOT Timer_poliv_finishQ, PT:=tTimerValue_poliv_finish , Q=>Timer_poliv_finishQ , ET=> );
		END_IF
		ELSE
			fert_pwm_levelA:=0;
			fert_pwm_levelB:=0;
	END_IF

	IF (Modbus.Teplica_type_poliv = FALSE) THEN (*Полив без фертигации*)
		IF (Timer_poliv_all.Q=TRUE OR (Poliv_liters > Modbus.Teplica_set_poliv)  OR Modbus.Teplica_poliv_break=TRUE   )THEN
			(*finished only poliv *)
			IF  (Modbus.Teplica_zone_poliv = 0) THEN
					Modbus.Teplica_poliv_message_PLC:=19;
			ELSE
					Modbus.Teplica_poliv_message_PLC:=20;
			END_IF

			Modbus.Teplica_poliv_active:= FALSE;
			Modbus.Teplica_pomp_poliv:=FALSE;
			Modbus.Teplica_pomp_fertA :=  FALSE;
			Modbus.Teplica_pomp_fertB :=  FALSE;
			Timer_poliv_all.IN := FALSE;
			Timer_poliv_with_fert.IN := FALSE;
			Timer_1_clear.IN := FALSE;
			Timer_2_fertA.IN:=FALSE;
			Timer_3_clear.IN := FALSE;
			Timer_4_fertB.IN:=FALSE;
			Timer_1_clearQ			:= FALSE;
			Timer_2_fertAQ			:= FALSE;
			Timer_3_clearQ			:= FALSE;
			Timer_4_fertBQ			:= FALSE;
			Modbus.Teplica_poliv_status_PLC :=  10;
		END_IF
	END_IF
	ELSE
		fert_pwm_levelA:=0;
		fert_pwm_levelB:=0;
END_IF

Modbus.Teplica_fert_actA			:=	Kf_calc_fertA;
Modbus.Teplica_fert_actB			:=	Kf_calc_fertB;
Modbus.Teplica_fert_pwm_levelA	:=	REAL_TO_INT(100*fert_pwm_levelA/32765);
Modbus.Teplica_fert_pwm_levelB	:=	REAL_TO_INT(100*fert_pwm_levelB/32765);
Modbus.Teplica_pwm_avg_A		:=	REAL_TO_INT(100*pwm_avg_A/32765);
Modbus.Teplica_pwm_avg_B		:=	REAL_TO_INT(100*pwm_avg_B/32765);









(*LIGHT TEPLICA *)

IF (Modbus.Teplica_light = FALSE) THEN

(*	IF ((Modbus.Teplica_avg_lux > Modbus.Teplica_light_set_low+gisterezis_lux OR Modbus.Teplica_temp_air>25) OR Modbus.Teplica_light_allow = FALSE  ) THEN
		Modbus.Teplica_light :=FALSE;
		HW_teplica_light		:=	FALSE;
	END_IF
*)
	IF ((Modbus.Teplica_avg_lux <  Modbus.Teplica_light_set_low-gisterezis_lux  AND Modbus.Teplica_temp_air<27) AND Modbus.Teplica_light_allow ) THEN
		Modbus.Teplica_light:=TRUE;
		HW_teplica_light		:=	TRUE;
	END_IF

END_IF

IF (Modbus.Teplica_light = TRUE) THEN

	IF ((Modbus.Teplica_avg_lux  >  Modbus.Teplica_light_set_low+gisterezis_lux  OR Modbus.Teplica_temp_air>28) OR Modbus.Teplica_light_allow = FALSE  ) THEN
		Modbus.Teplica_light :=FALSE;
		HW_teplica_light		:=	FALSE;
	END_IF

(*	IF ((Modbus.Teplica_avg_lux <  Modbus.Teplica_light_set_low-gisterezis_lux ) AND Modbus.Teplica_light_allow ) THEN
		Modbus.Teplica_light:=TRUE;
		HW_teplica_light		:=	TRUE;
	END_IF
*)

END_IF



(*HEAT TEPLICA *)

	IF ((Modbus.Teplica_temp_air > Modbus.Teplica_temp_set_low+1) ) THEN
		Modbus.Teplica_heat :=FALSE;
		HW_teplica_heat		:= FALSE;
	END_IF

	IF ((Modbus.Teplica_temp_air <  Modbus.Teplica_temp_set_low-1 ) ) THEN
		Modbus.Teplica_heat:=TRUE;
		HW_teplica_heat		:=	TRUE;
	END_IF


(*HEAT TANK TEPLICA *)

	IF ((Modbus.Teplica_temp_water_tank > Modbus.Teplica_set_temp_tank+1)  OR HW_teplica_heat = TRUE   OR Modbus.Teplica_tank_level < 400 ) THEN
		Modbus.Teplica_tank_heat :=FALSE;
		HW_teplica_tank_heat		:= FALSE;
	END_IF

	IF ((Modbus.Teplica_temp_water_tank <  Modbus.Teplica_set_temp_tank-1 ) AND HW_teplica_heat = FALSE   AND Modbus.Teplica_tank_level > 400) THEN
		Modbus.Teplica_tank_heat:=TRUE;
		HW_teplica_tank_heat		:=	TRUE;
	END_IF




(*VENT  TEPLICA *)

	IF ((Modbus.Teplica_temp_air < Modbus.Teplica_temp_set_high-1)   ) THEN
		Modbus.Teplica_vent			 :=FALSE;
		HW_teplica_vent				:=FALSE;
	END_IF

	IF ((Modbus.Teplica_temp_air >  Modbus.Teplica_temp_set_high+1 ) ) THEN
		Modbus.Teplica_vent	:=TRUE;
		HW_teplica_vent		:=TRUE;
	END_IF


	IF (Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_window_open-1 ) THEN
		HW_teplica_window_opener		:=FALSE;
		Modbus.Teplica_window_opener	:=FALSE;
	END_IF
	IF (Modbus.Teplica_temp_air >  Modbus.Teplica_set_temp_window_open+1 AND   Modbus.Street_temp > 0 ) THEN
		HW_teplica_window_opener		:=TRUE;
		Modbus.Teplica_window_opener	:=TRUE;
	END_IF


	IF (Modbus.Teplica_temp_air < Modbus.Teplica_set_temp_pomp_cold-1   ) THEN
		HW_teplica_pomp_cold		:=FALSE;
		Modbus.Teplica_pomp_cold	:=FALSE;
	END_IF
	IF (Modbus.Teplica_temp_air >  Modbus.Teplica_set_temp_pomp_cold+1 AND   Modbus.Street_temp >10 ) THEN
		HW_teplica_pomp_cold		:=TRUE;
		Modbus.Teplica_pomp_cold	:=TRUE;
	END_IF






END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM Thermocontrol
VAR
(*	period_sec		: INT:=120;  *)  (* Частота работы термостата, секунды*)
	gisterezis		: REAL:=0.2; (*Гистерезис термостата, градусы цельсия *)
	Timer1			: TON;
	Timer1Q			: BOOL;
	state			: INT:=0;
	 tTimerValue		: TIME:=t#120s;  (* Частота работы термостата, секунды*)
	pi_1f, pi_2f, pi_sauna 			: FB_CTRL_PI;
	pwm_1f, pwm_2f, pwm_sauna1	: FB_CTRL_PWM_OUT;

	pi_balkon 			: FB_CTRL_PI;
	pwm_balkon			: FB_CTRL_PWM_OUT;

	pi_septik				: FB_CTRL_PI;
	pwm_septik			: FB_CTRL_PWM_OUT;
	Power_septik			: UINT:=75;


END_VAR
(* @END_DECLARATION := '0' *)
(* tTimerValue := DINT_TO_TIME(period_sec*1000); *)

pwm_par_1f.bInstantPWMUpdate:=0;
pwm_par_1f.tPWMPeriod:=T#5135ms;
pwm_par_1f.tTaskCycleTime:=T#10ms;

pwm_par_2f.bInstantPWMUpdate:=0;
pwm_par_2f.tPWMPeriod:=T#5735ms;
pwm_par_2f.tTaskCycleTime:=T#10ms;


pwm_par_balkon.bInstantPWMUpdate:=0;
pwm_par_balkon.tPWMPeriod:=T#5800ms;
pwm_par_balkon.tTaskCycleTime:=T#10ms;
pi_par_balkon.bARWOnIPartOnly:=0;
pi_par_balkon.fKp:=40;
pi_par_balkon.fOutMaxLimit:=100;
pi_par_balkon.fOutMinLimit:=0;
pi_par_balkon.tCtrlCycleTime:=T#10ms;
pi_par_balkon.tTaskCycleTime:=T#10ms;
pi_par_balkon.tTn:=T#30m;

IF Modbus.Heat_pipe_septik_winter = TRUE THEN
	pwm_par_septik.bInstantPWMUpdate:=0;
	pwm_par_septik.tPWMPeriod:=T#15000ms;
	pwm_par_septik.tTaskCycleTime:=T#10ms;
	pwm_septik(fPwmInput:=Power_septik, eMode:=2, stParams:=pwm_par_septik, bPwmOutBitPos=>HW_septik_heat );

END_IF

(*
pi_par_septik.bARWOnIPartOnly:=0;
pi_par_septik.fKp:=40;
pi_par_septik.fOutMaxLimit:=100;
pi_par_septik.fOutMinLimit:=0;
pi_par_septik.tCtrlCycleTime:=T#5ms;
pi_par_septik.tTaskCycleTime:=T#5ms;
pi_par_septik.tTn:=T#30m;
*)





pi_balkon(fSetpointValue:=Modbus.Balkon_set_temp, fActualValue :=Modbus.Balkon_temp, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_balkon, fOut => );
pwm_balkon(fPwmInput:=pi_balkon.fOut, eMode:=2, stParams:=pwm_par_balkon, bPwmOutBitPos=>HW_balkon_heat );




pwm_par_sauna.bInstantPWMUpdate:=0;
pwm_par_sauna.tPWMPeriod:=T#300s;
pwm_par_sauna.tTaskCycleTime:=T#5ms;


pi_par_1f.bARWOnIPartOnly:=0;
pi_par_1f.fKp:=40;
pi_par_1f.fOutMaxLimit:=100;
pi_par_1f.fOutMinLimit:=0;
pi_par_1f.tCtrlCycleTime:=T#5ms;
pi_par_1f.tTaskCycleTime:=T#5ms;
pi_par_1f.tTn:=T#30m;

pi_par_sauna.bARWOnIPartOnly:=0;
pi_par_sauna.fKp:=40;
pi_par_sauna.fOutMaxLimit:=100;
pi_par_sauna.fOutMinLimit:=0;
pi_par_sauna.tCtrlCycleTime:=T#5ms;
pi_par_sauna.tTaskCycleTime:=T#5ms;
pi_par_sauna.tTn:=T#30m;

(**)
	pi_1f(fSetpointValue:=Modbus.First_floor_temp_target, fActualValue :=INT_TO_REAL(HW_temp_first_floor)/10, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_1f, fOut => );
(*	pi_1f(fSetpointValue:=Modbus.First_floor_temp_target, fActualValue :=Internal.First_floor_temp_SHT30, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_1f, fOut => );*)

	pwm_1f(fPwmInput:=pi_1f.fOut, eMode:=2, stParams:=pwm_par_1f, bPwmOutBitPos=>HW_heat_first_floor );

	pi_2f(fSetpointValue:=Modbus.Second_floor_temp_target, fActualValue :=INT_TO_REAL(HW_temp_second_floor)/10, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_1f, fOut => );
	pwm_2f(fPwmInput:=pi_2f.fOut, eMode:=2, stParams:=pwm_par_2f, bPwmOutBitPos=>HW_heat_second_floor );

(* SAUNA PID*)
(*
	pi_sauna(fSetpointValue:=Modbus.Sauna_temp_target, fActualValue :=INT_TO_REAL(HW_temp_sauna)/10, fManSyncValue :=0, bSync:=0, eMode:=2,bHold:=0, stParams:=pi_par_sauna, fOut => );
	pwm_sauna1(fPwmInput:=pi_sauna.fOut, eMode:=2, stParams:=pwm_par_sauna, bPwmOutBitPos=>HW_heat_Sauna );
*)

CASE state OF
0:
(*	IF (Modbus.First_floor_temp > Modbus.First_floor_temp_target+gisterezis ) THEN
		HW_heat_first_floor:=FALSE;
	END_IF

	IF ((Modbus.First_floor_temp <  Modbus.First_floor_temp_target-gisterezis) AND (Modbus.First_floor_temp <>0)  ) THEN
		HW_heat_first_floor:=TRUE;
	END_IF
*)

	state:=1;

1:
(*	IF (Modbus.Second_floor_temp > Modbus.Second_floor_temp_target+gisterezis ) THEN
		HW_heat_Second_floor:=FALSE;
	END_IF

	IF ((Modbus.Second_floor_temp <  Modbus.Second_floor_temp_target-gisterezis ) AND (Modbus.Second_floor_temp <>0)) THEN
		HW_heat_Second_floor:=TRUE;
	END_IF
*)
	state:=2;
2:
(* SAUNA GISTEREZIS *)

	IF (Modbus.Sauna_temp > Modbus.Sauna_temp_target+gisterezis ) THEN
		HW_heat_Sauna:=FALSE;
	END_IF

	IF ((Modbus.Sauna_temp <  Modbus.Sauna_temp_target-gisterezis ) AND (Modbus.Sauna_temp <>0)) THEN
		HW_heat_Sauna:=TRUE;
	END_IF
	state:=3;
3:


IF (Modbus.Sport_temp > Modbus.Sport_temp_target+gisterezis OR HW_heat_Sauna=TRUE ) THEN
		HW_heat_sport:=FALSE;
	END_IF

	IF ((Modbus.Sport_temp <  Modbus.Sport_temp_target-gisterezis ) AND (Modbus.Sport_temp <>0)  AND HW_heat_Sauna=FALSE) THEN
		HW_heat_sport:=TRUE;
	END_IF



	state:=4;

4:
	IF (Modbus.Underfloor_temp > Modbus.Underfloor_temp_target+gisterezis AND Modbus.Underfloor_hum < Modbus.Underfloor_humidity_target-1 ) THEN
		HW_heat_underfloor:=FALSE;
	END_IF

	IF ((Modbus.Underfloor_temp <  Modbus.Underfloor_temp_target-gisterezis OR Modbus.Underfloor_hum > Modbus.Underfloor_humidity_target+1) AND (Modbus.Underfloor_temp <>0)) THEN
		HW_heat_Underfloor:=TRUE;
	END_IF

	state:=100;



100:


	Timer1(IN:=NOT Timer1Q , PT:=tTimerValue , Q=>Timer1Q , ET=> );
		IF timer1.q THEN

		state:=0;
		END_IF



END_CASE

END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM VentControl
VAR
	Temperature_max_to_heat	: REAL:=17;		(* Максимальная температура наружнего воздуха при которой разрешено включать воздухонагреватель*)
	gisterezis				: REAL:=0.2;	(* Гистерезис  разрешения включения воздухонагревателя, градусы цельсия *)
	vent_valve_opened	 	: BOOL:=FALSE;	(*После перезагрузки ПЛК считаем что приточный клапан закрыт *)
	Period_start_delay		: INT:=60; 	(* Время задержки включения вентилятора после сигнала на открытие приточного клапана, сек *)
	Period_stop_delay		: INT:=60;		(* Время задержки отключения вентилятора после сигнала на останов вентиляции - для остужения разогретых ТЭНов воздухонагревателя, сек *)
	Timer1					: TON;		(* Таймер задержки включения вентилятора после сигнала на открытие приточного клапана *)
	Timer2					: TON;		(* Таймер задержки отключения вентилятора после сигнала на останов вентиляции - для остужения разогретых ТЭНов воздухонагревателя *)
	Timer1Q					: BOOL;
	Timer2Q					: BOOL;
	tTimerValue1				: TIME;
	tTimerValue2				: TIME;
END_VAR
(* @END_DECLARATION := '0' *)
tTimerValue1 := DINT_TO_TIME(Period_start_delay*1000);
tTimerValue2 := DINT_TO_TIME(Period_stop_delay*1000);

IF (Modbus.Vent=FALSE) THEN
	HW_vent_in_heat := FALSE;
	vent_valve_opened := FALSE;
	HW_vent_valve_input:=FALSE;
	Timer2(IN:=NOT Timer2Q , PT:=tTimerValue2 , Q=>Timer2Q , ET=> );
	IF timer2q THEN
		HW_trans_power:=FALSE;
	END_IF


ELSE
	HW_vent_valve_input:=TRUE;
(*	HW_vent_valve_output:=TRUE; *)

	IF (vent_valve_opened = FALSE) THEN
		Timer1(IN:=NOT Timer1Q , PT:=tTimerValue1 , Q=>Timer1Q , ET=> );
		IF timer1.q THEN
			vent_valve_opened := TRUE;
		END_IF
	END_IF

	IF (vent_valve_opened=TRUE) THEN
		HW_trans_power:=TRUE;
		IF (HW_vent_relay_pressure=TRUE) THEN
			IF (Modbus.Vent_heat=2) THEN
				IF (Modbus.Street_temp < Temperature_max_to_heat-gisterezis) THEN
					HW_vent_in_heat:=TRUE;
				END_IF
				IF (Modbus.Street_temp > Temperature_max_to_heat+gisterezis) THEN
					HW_vent_in_heat:=FALSE;
				END_IF
			ELSE
				IF (Modbus.Vent_heat=1) THEN
					HW_vent_in_heat:=TRUE;
				END_IF
				IF (Modbus.Vent_heat=0) THEN
					HW_vent_in_heat:=FALSE;
				END_IF
			END_IF
		END_IF   (*vent_relay_pressure*)
	END_IF (*vent_valve_opened*)
END_IF (*Vent*)





END_PROGRAM


(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
PROGRAM VentPower
VAR
	Vent_power			: REAL:=30;  (* После перезагрузки ПЛК задаём начальную мощность условных 30%  *)
	CO2_old				: REAL:=410; (* После перезагрузки ПЛК задаём принудительно последнее значение CO2 = 410 (абсолютно свежий воздух) *)
	Period_vent_switch	: INT:=180; (* Частота переключения режимов работы вентилятора по показаниям датчиков CO2, секунды*)
	Timer1				: TON;
	Timer1Q				: BOOL;
	count				: INT:=0;
	CO2_max			: REAL;
	tTimerValue			: TIME;

END_VAR
(* @END_DECLARATION := '0' *)
tTimerValue := DINT_TO_TIME(Period_vent_switch*1000);

IF (Modbus.Vent =TRUE  ) THEN

	Timer1(IN:=NOT Timer1Q , PT:=tTimerValue , Q=>Timer1Q , ET=> );

	IF timer1.q THEN
	CO2_max:=MAX (Modbus.First_floor_CO2, Modbus.Second_floor_CO2);

	IF (  (CO2_max >=  CO2_old-10 )  AND ( CO2_max >  INT_TO_REAL(Modbus.Target_CO2)*1.05 ) ) THEN
			Vent_power:=Vent_power+5;
		END_IF
		count:=count+1;

		IF (count = 2)	THEN
			IF (  CO2_max <=  INT_TO_REAL(Modbus.Target_CO2)*0.99) THEN
				Vent_power:=Vent_power-1;
			END_IF
		count:=1;
		END_IF

		IF (Vent_power>80) THEN
			Vent_power:=80;
		END_IF
		IF(Vent_power<20) THEN
			Vent_power:=20;
		END_IF

		IF (Vent_Power > 75 AND Modbus.Street_temp > -10  ) THEN

					Modbus.Vent_input_level:=200;	(*200 м. куб в час при подаче напряжения на вентилятор  220V *)
					HW_vent_in_trans_160_220:=FALSE;
					HW_vent_in_trans_LO_HI:=FALSE;

			ELSIF (Vent_Power>50 AND Modbus.Street_temp > -14) THEN
					Modbus.Vent_input_level:=180; (*200 м. куб в час при подаче напряжения на вентилятор 220V *)
					HW_vent_in_trans_160_220:=FALSE;
					HW_vent_in_trans_LO_HI:=FALSE;

			ELSIF (Vent_Power>35  AND Modbus.Street_temp > -20) THEN

					Modbus.Vent_input_level:=150; (* 150 м. куб в час при подаче напряжения на вентилятор160V *)
					HW_vent_in_trans_160_220:=TRUE;
					HW_vent_in_trans_LO_HI:=FALSE;


			ELSIF (Vent_Power>25 ) THEN

					Modbus.Vent_input_level:=110; (* 110 м. куб в час при подаче напряжения на вентилятор 130V *)
					HW_vent_in_trans_105_130:=FALSE;
					HW_vent_in_trans_LO_HI:=TRUE;


			ELSE
				Modbus.Vent_input_level:=80; (* 80 м. куб в час при подаче напряжения на вентилятор 105V *)
				HW_vent_in_trans_105_130:=TRUE;
				HW_vent_in_trans_LO_HI:=TRUE;


			END_IF

			CO2_old:=CO2_max;

		END_IF	(* Timer1 *)

	ELSE	 (* Vent=TRUE*)


		Modbus.Vent_input_level:=0;

END_IF   (* Vent=TRUE*)
END_PROGRAM

(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
TYPE DataToFromNovram :
STRUCT

	Target_CO2_mem					:		INT:=600;
	First_floor_temp_target_mem		:		INT:=5;
	Second_floor_temp_target_mem		:		INT:=5;
	Sport_temp_target_mem			:		INT:=5;
	Sauna_temp_target_mem			:		INT:=5;
	Underfloor_temp_target_mem		:		INT:=5;
	Underfloor_humidity_target_mem	:		INT:=90;

	Pomp_house_mem				:		BOOL:=FALSE;
	Pomp_garden_mem				:		BOOL:=FALSE;

	Light_garden_mem				:		BOOL:=FALSE;

	Vent_mem						:		BOOL:=FALSE;
	Vent_heat_mem					:		INT;
	Vent_heat_level_mem				:		BOOL;

	Poliv_zapad_minutes				:		INT:=90;
	Poliv_terrasa_minutes				:		INT:=90;
	Poliv_south_minutes				:		INT:=90;
	Poliv_north_minutes				:		INT:=90;

	Teplica_temp_set_high			:	INT:=21;
	Teplica_temp_set_low				:	INT:=18;
	Teplica_light_set_low				:	INT:=4000;
	Teplica_light_allow				:	BOOL;
	Teplica_poliv_kf					:	INT:=1025;
	Teplica_fertA_kf					:	INT:=11450;
	Teplica_fertB_kf					:	INT:=11450;

	Teplica_set_poliv					:	REAL;
	Teplica_set_fertA					:	REAL;
	Teplica_set_fertB					:	REAL;
	Teplica_set_max_poliv_time		:	UDINT;
	Teplica_set_max_fertA_time		:	UDINT;
	Teplica_set_max_fertB_time		:	UDINT;
	Teplica_set_clear_time			:	UDINT:=5;

	Teplica_set_temp_pomp_cold		:	INT:=24;
	Teplica_set_temp_window_open	:	INT:=21;
	Teplica_set_poliv_before_fert		:	INT:=50;

	Teplica_set_temp_tank			:	INT:=-60;
